# same image as the Dockerfile, with librdkafka.config (generated by start.sh) baked in and a producer as entrypoint,
# for the pods of pod.yml and pod_initContainers.yml
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ClientDotnet.csproj .
RUN dotnet restore
COPY Program.cs .
RUN dotnet publish -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /app .
COPY librdkafka.config /tmp/librdkafka.config
ENTRYPOINT ["dotnet", "ClientDotnet.dll", "produce", "test1", "/tmp/librdkafka.config"]
