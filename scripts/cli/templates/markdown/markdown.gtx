# === Environment Variables

if public_environment_variables.any?
  > ## Environment Variables
  >
  public_environment_variables.each do |environment_variable|
    attributes = environment_variable.required || environment_variable.default

    > #### `{{ environment_variable.name.upcase }}`
    >
    > {{ environment_variable.help.for_kdp_markdown }}
    >

    if attributes
      > | Attributes      | &nbsp;
      > |-----------------|-------------
      if environment_variable.required
        > | Required:       | ✓ Yes
      end
      if environment_variable.default
        > | Default Value:  | {{ KdpMarkdown.values(environment_variable.default) }}
      end
      >
    end
  end
end

# === Commands

if commands.any?
  grouped_commands.each do |group, commands|
    # private commands have no page (see render.rb): don't link to them
    # bashly also lists the subcommands of an exposed command (expose: true) in its group, one level deep only:
    # keep the direct subcommands and list every public descendant of each, nested by depth
    depth = full_name.split.size
    commands = commands.reject(&:private).select { |c| c.full_name.split.size == depth + 1 }
    tree = ->(c) { [c] + c.commands.reject(&:private).flat_map { |s| tree.(s) } }
    commands = commands.flat_map { |c| tree.(c) }
    next if commands.empty?
    > ## {{ group.gsub(/:$/, '').gsub(/\A=+\s*|\s*=+\z/, '') }}
    >
    commands.each do |subcommand|
      indent = "  " * (subcommand.full_name.split.size - depth - 1)
      > {{ indent }}- [{{ subcommand.name }}]({{ subcommand.full_name.gsub(' ', '%20') }}) - {{ subcommand.summary.for_kdp_inline }}
    end
    >
  end
end

