# === Commands

if commands.any?
  # groups in the order a reader needs them (essentials first, then by how often they are used), unknown groups at the
  # end in alphabetical order. The group of a command is its "group:" in src/commands/<command>.yml
  group_label = ->(g) { g.gsub(/:$/, '').gsub(/\A=+\s*|\s*=+\z/, '') }
  group_order = ['Essentials', 'Run', 'Connector', 'Connector-Plugin', 'Topic', 'Kafka', 'Schema', 'Container', 'Debug',
                 'Analyze', 'Repro', 'Database', 'ksqlDB', 'Flink', 'Kafka Streams', 'Accounts', 'Secrets',
                 'Cloud Resources', 'Cleanup', 'TCP Proxy', 'RBAC', 'CFK', 'Ansible', 'Codespace', 'EC2', 'Tools',
                 'Configuration']
  # the commands without a group (help, status, doctor, find-command, find-example) are listed first, as "Essentials"
  group_key = ->(g) { group_label.(g) == 'Commands' ? 'Essentials' : group_label.(g).sub(/\s+commands\z/i, '') }
  sorted_groups = grouped_commands.sort_by do |g, _|
    index = group_order.index(group_key.(g))
    [index || group_order.size, group_key.(g).downcase]
  end
  sorted_groups.each do |group, commands|
    # private commands have no page (see render.rb): don't link to them
    # bashly also lists the subcommands of an exposed command (expose: true) in its group: keep the direct ones only
    # each command on one line, its public subcommands (at any depth) folded in a <details> block: the page stays
    # short, and the browser search still finds them (it opens the block)
    depth = full_name.split.size
    commands = commands.reject(&:private).select { |c| c.full_name.split.size == depth + 1 }.sort_by { |c| c.name.downcase }
    next if commands.empty?
    tree = ->(c) { c.commands.reject(&:private).sort_by { |s| s.name.downcase }.flat_map { |s| [s] + tree.(s) } }
    > ### {{ group_key.(group) }}
    >
    commands.each do |command|
      > - [{{ command.name }}]({{ command.full_name.gsub(' ', '%20') }}) - {{ command.summary.for_kdp_inline }}
      descendants = tree.(command)
      if descendants.any?
        items = descendants.map do |s|
          indent = (s.full_name.split.size - depth - 2) * 1.2
          style = indent > 0 ? " style=\"margin-left:#{indent}em\"" : ""
          "<li#{style}><a href=\"#/#{s.full_name.gsub(' ', '%20')}\">#{s.full_name.split[depth + 1..-1].join(' ')}</a> - #{KdpMarkdown.inline_html(s.summary)}</li>"
        end
        >   <details class="cli-subcommands" open><summary>{{ descendants.size }} subcommand{{ descendants.size > 1 ? 's' : '' }}</summary><ul>{{ items.join }}</ul></details>
      end
    end
    >
  end
end

