# :command.usage
playground_container_logs_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground container logs\n\n"
    printf "  🕵️  Tail and follow container logs\n  \n  Three ways to use it:\n  \n    --grep \"ERROR\"                    keep only the lines that matter\n    --open                            read the whole log in your editor\n    --wait-for-log \"Started\" -m 120   block until the line shows up\n  \n  The last one is what example scripts use to synchronise on a component\n  being ready, instead of sleeping and hoping.\n  \n  🍪 Deep dive: https://kafka-docker-playground.io/#/deep-dive-container-logs\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%95%%B5%%EF%%B8%%8F-a-connector-failed-read-the-logs-live-or-from-a-customer-bundle\n\n"
  else
    printf "playground container logs - 🕵️  Tail and follow container logs\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground container logs [OPTIONS]\n"
  printf "  playground container logs --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--container, -c, --pod, -p CONTAINER (repeatable)")"
    printf "    🐳 container name (or pod name when cfk environment is used)\n    \n    🎓 Tip: you can pass multiple containers by specifying --container multiple\n    times\n"
    printf "    %s\n" "Default: connect"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--open, -o")"
    printf "    🔖 Save output to a file and open with text editor set with playground config\n    editor <editor> (default is code)\n"
    printf "    %s\n" "Conflicts: --wait-for-log, --grep, --errors"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--wait-for-log, -w LOG")"
    printf "    😴 Wait until log appears\n"
    printf "    %s\n" "Conflicts: --open, --grep, --errors"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-wait, -m MAX_WAIT")"
    printf "    ⏳ Max time in seconds to wait when using --wait-for-log (default 600s)\n"
    printf "    %s\n" "Default: 600"
    printf "    %s\n" "Conflicts: --open, --grep"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--grep GREP")"
    printf "    🎯 Grep pattern to filter logs\n"
    printf "    %s\n" "Default: "
    printf "    %s\n" "Conflicts: --open, --wait-for-log, --errors"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--previous")"
    printf "    🕰️ Show logs from the previous pod instance (only relevant when\n    --environment=cfk is used)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--since SINCE")"
    printf "    🕐 Only show logs newer than a relative duration (10m, 1h) or a timestamp\n    (2026-09-24T16:00:00)\n"
    printf "    %s\n" "Conflicts: --open, --wait-for-log"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--tail LINES")"
    printf "    🔢 Number of lines to show from the end of the logs, or \"all\"\n    \n    Default is 200, or all when --since, --errors, or --grep with --no-follow is\n    used\n"
    printf "    %s\n" "Conflicts: --open, --wait-for-log"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-follow")"
    printf "    🛑 Print the logs and exit instead of following them\n    \n    🎓 Tip: use it in scripts and from AI agents, which otherwise never get the\n    command back\n"
    printf "    %s\n" "Conflicts: --open, --wait-for-log"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--errors")"
    printf "    🔥 Only show a digest of ERROR/FATAL records, then exit\n    \n    Repeated records are de-duplicated with an occurrence count, stack\n    traces are collapsed to the exception chain (\"Caused by:\") plus a few\n    frames of the deepest cause. Only records with an explicit level are\n    reported (\" ERROR \", \"[ERROR]\", level=error, \"level\":\"error\"), plus\n    uncaught java exceptions: records logged at INFO/DEBUG/TRACE, and\n    level-less lines that merely contain \"error\" or \"failed\", never are.\n    \n    Scans the whole log unless --since or --tail narrow it.\n"
    printf "    %s\n" "Conflicts: --open, --wait-for-log, --grep"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--include-warnings")"
    printf "    🟠 With --errors, also report WARN records\n"
    printf "    %s\n" "Needs: --errors"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-findings MAX_FINDINGS")"
    printf "    ✂️ With --errors, maximum number of distinct records to show (default 40)\n"
    printf "    %s\n" "Default: 40"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--html")"
    printf "    🌐 With --errors, also write a self-contained HTML report of the digest in\n    /tmp/playground-log-reports (known causes, timeline, root causes, every\n    distinct record), opened in the browser in an interactive terminal\n"
    printf "    %s\n" "Needs: --errors"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground container logs --container connect\n"
    printf "  playground container logs -c connect --errors\n"
    printf "  playground container logs -c connect -c broker --errors --html\n"
    printf "  playground container logs -c connect --errors --since 10m --include-warnings\n"
    printf "  playground container logs -c connect --grep \"Caused by\" --no-follow\n"
    printf "  playground container logs -c connect --no-follow --tail 500\n"
    printf "  playground container logs -c connect --open\n"
    printf "  playground container logs -c connect --wait-for-log \"StackOverflowError\"\n"
    printf "  playground container logs -c connect -c broker\n"
    printf "  playground container logs --container schema-registry --container\n  ksqldb-server --open\n"
    printf "  playground container logs -c broker -c connect -c schema-registry\n"
    printf "  playground container logs -c connect -c broker --wait-for-log \"ERROR\"\n  --max-wait 120\n"
    printf "  playground container logs --container connect --grep \"ERROR\"\n"
    printf "  playground pod logs --previous\n"
    echo

    # :command.footer
    printf "Example output:\n  $ playground container logs -c connect --errors\n  17:22:10 ℹ️ 🔥 ERROR/FATAL digest for connect logs\n  ✅ no ERROR/FATAL record found in 12523 lines\n"
    echo

  fi
}

