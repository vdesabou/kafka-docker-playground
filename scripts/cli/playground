    fi
  fi
}

function bootstrap_ccloud_environment () {

  local expected_cloud="$1"
  local expected_region="$2"
  local connect_migration_utility="$3"
  local ccloud_cluster_list=""

  DIR_UTILS="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
  get_kafka_docker_playground_dir
  DELTA_CONFIGS_ENV=$KAFKA_DOCKER_PLAYGROUND_DIR/.ccloud/env.delta

  if [ -z "$GITHUB_RUN_NUMBER" ] && [ -z "$CLOUDFORMATION" ]
  then
    # not running with CI
    verify_installed "confluent"
    # list clusters in the background while the version is checked: the output is used both to verify the
    # CLI is logged in and to detect that CLUSTER_NAME is already the current cluster
    ccloud_cluster_list=$(mktemp)
    confluent kafka cluster list --output json > "$ccloud_cluster_list" 2>&1 &
    local ccloud_cluster_list_pid=$!
    check_confluent_version 4.32.0 || exit 1
    wait $ccloud_cluster_list_pid || true
    if grep -q -e "You must login to run that command" -e "Your session has expired" "$ccloud_cluster_list"
    then
      logerror "This script requires confluent CLI to be logged in. Please execute 'confluent login' and run again."
      exit 1
    fi
  else
    if [ ! -f /usr/local/bin/confluent ]
    then
      log "🚚 installing confluent CLI"
      # the installer runs "curl -n" and recent curl (8.18 on ubuntu 26.04) fails with "(26) .netrc error: no such file" when ~/.netrc is missing
      sudo sh -c 'touch "$HOME/.netrc"'
      for i in 1 2 3 4 5
      do
        curl -fsSL --http1.1 https://cnfl.io/cli | sudo sh -s -- -b /usr/local/bin && break
        logwarn "confluent CLI install failed (attempt $i/5), retrying in 10s..."
        sleep 10
      done
      if [ ! -f /usr/local/bin/confluent ]
      then
        logerror "❌ failed to install confluent CLI after 5 attempts"
        exit 1
      fi
    fi
    export PATH=$PATH:/usr/local/bin
    log "⛺ log in to Confluent Cloud"
    confluent login --save
  fi

  # --no-open: the end of playground run prints the link of the HTML report
  playground ccloud-costs-history --no-open > /tmp/ccloud-costs-history.txt &

  suggest_use_previous_example_ccloud=1
  test_file=$(playground state get run.test_file)

  if [ -f "$test_file" ]
  then
    if [[ $test_file == *"fm-databricks-delta-lake-sink"* ]] || ( [[ -n "$connect_migration_utility" ]] && [[ $test_file == *"connect-databricks"* ]] )
    then
      if [ ! -z "$AWS_DATABRICKS_CLUSTER_NAME" ]
      then
        log "AWS_DATABRICKS_CLUSTER_NAME environment variable is set, forcing the cluster $AWS_DATABRICKS_CLUSTER_NAME to be used !"
        suggest_use_previous_example_ccloud=0
        export CLUSTER_NAME=$AWS_DATABRICKS_CLUSTER_NAME
        export CLUSTER_REGION=$AWS_DATABRICKS_CLUSTER_REGION
        export CLUSTER_CLOUD=$AWS_DATABRICKS_CLUSTER_CLOUD
        export CLUSTER_CREDS=$AWS_DATABRICKS_CLUSTER_CREDS
      fi
    fi

    if [[ $test_file == *"fm-aws"* ]] || ( [[ -n "$connect_migration_utility" ]] && [[ $test_file == *"connect-aws"* ]] )
    then
      if [ ! -z "$AWS_CLUSTER_NAME" ]
      then
        log "🤖 AWS Fully managed example and AWS_CLUSTER_NAME environment variable is set, forcing the cluster $AWS_CLUSTER_NAME to be used !"
        suggest_use_previous_example_ccloud=0
        export CLUSTER_NAME=$AWS_CLUSTER_NAME
        export CLUSTER_REGION=$AWS_CLUSTER_REGION
        export CLUSTER_CLOUD=$AWS_CLUSTER_CLOUD
        export CLUSTER_CREDS=$AWS_CLUSTER_CREDS
      fi
    fi

    if [[ $test_file == *"fm-gcp"* ]] || [[ $test_file == *"fm-debezium-gcp"* ]] || ( [[ -n "$connect_migration_utility" ]] && [[ $test_file == *"connect-gcp"* ]] )
    then
      if [ ! -z "$GCP_CLUSTER_NAME" ]
      then
        log "🤖 GCP Fully managed example and GCP_CLUSTER_NAME environment variable is set, forcing the cluster $GCP_CLUSTER_NAME to be used !"
        suggest_use_previous_example_ccloud=0
        export CLUSTER_NAME=$GCP_CLUSTER_NAME
        export CLUSTER_REGION=$GCP_CLUSTER_REGION
        export CLUSTER_CLOUD=$GCP_CLUSTER_CLOUD
        export CLUSTER_CREDS=$GCP_CLUSTER_CREDS
      fi
    fi

    if [[ $test_file == *"fm-azure"* ]] || ( [[ -n "$connect_migration_utility" ]] && [[ $test_file == *"connect-azure"* ]] ) || ( [[ $test_file == *"fm-custom-smt"* ]] && ( [[ "$USER" == "vsaboulin" ]] || [[ "$USER" == "runner" ]] ) )
    then
      if [ ! -z "$AZURE_CLUSTER_NAME" ]
      then
        log "🤖 Azure Fully managed example and AZURE_CLUSTER_NAME environment variable is set, forcing the cluster $AZURE_CLUSTER_NAME to be used !"
        suggest_use_previous_example_ccloud=0
        export CLUSTER_NAME=$AZURE_CLUSTER_NAME
        export CLUSTER_REGION=$AZURE_CLUSTER_REGION
        export CLUSTER_CLOUD=$AZURE_CLUSTER_CLOUD
        export CLUSTER_CREDS=$AZURE_CLUSTER_CREDS
      fi
    fi
  fi

  for item in {ENVIRONMENT,CLUSTER_NAME,CLUSTER_CLOUD,CLUSTER_REGION,CLUSTER_CREDS}
  do
      i=$(playground state get "ccloud.${item}")
      if [ "$i" == "" ]
      then
        # at least one mandatory field is missing
        suggest_use_previous_example_ccloud=0
        break
      fi
  done

  if [ ! -z "$CLUSTER_NAME" ]
  then
    if [ "$(playground state get "ccloud.CLUSTER_NAME")" == "$CLUSTER_NAME" ]
    then
      suggest_use_previous_example_ccloud=0
    fi
  fi

  if [ "$(playground state get "ccloud.suggest_use_previous_example_ccloud")" == "0" ]
  then
    suggest_use_previous_example_ccloud=0
  fi

  if [ $suggest_use_previous_example_ccloud -eq 1 ] && [ -z "$GITHUB_RUN_NUMBER" ]
  then
    log "🙋 Use previously used ccloud cluster:"
    log "  🌐 ENVIRONMENT=$(playground state get ccloud.ENVIRONMENT)"
    log "  🎰 CLUSTER_NAME=$(playground state get ccloud.CLUSTER_NAME)"
    log "  🌤  CLUSTER_CLOUD=$(playground state get ccloud.CLUSTER_CLOUD)"
    log "  🗺  CLUSTER_REGION=$(playground state get ccloud.CLUSTER_REGION)"

    read -p "Continue (y/n)?" choice
    case "$choice" in
    y|Y )

      ENVIRONMENT=$(playground state get ccloud.ENVIRONMENT)
      CLUSTER_NAME=$(playground state get ccloud.CLUSTER_NAME)
      CLUSTER_CLOUD=$(playground state get ccloud.CLUSTER_CLOUD)
      CLUSTER_REGION=$(playground state get ccloud.CLUSTER_REGION)
      CLUSTER_CREDS=$(playground state get ccloud.CLUSTER_CREDS)
      SCHEMA_REGISTRY_CREDS=$(playground state get ccloud.SCHEMA_REGISTRY_CREDS)
      ;;
    n|N )

      playground state del ccloud.ENVIRONMENT
      playground state del ccloud.CLUSTER_NAME
      playground state del ccloud.CLUSTER_CLOUD
      playground state del ccloud.CLUSTER_REGION
      playground state del ccloud.CLUSTER_CREDS
      playground state del ccloud.SCHEMA_REGISTRY_CREDS
      ;;
    * )

      logerror "invalid response!";
      exit 1
      ;;
    esac
  fi

  if [ -z "$CLUSTER_NAME" ]
  then
    #
    # CLUSTER_NAME is not set
    #
    if [ -n "$ccloud_cluster_list" ]
    then
      rm -f "$ccloud_cluster_list"
    fi
    log "🛠👷‍♀️ CLUSTER_NAME is not set, a new Confluent Cloud cluster will be created..."
    log "🎓 If you wanted to use an existing cluster, set CLUSTER_NAME, ENVIRONMENT, CLUSTER_CLOUD, CLUSTER_REGION and CLUSTER_CREDS (also optionnaly SCHEMA_REGISTRY_CREDS)"

    if [ -z "$CLUSTER_CLOUD" ] || [ -z "$CLUSTER_REGION" ]
    then
      logwarn "CLUSTER_CLOUD and/or CLUSTER_REGION are not set, the cluster will be created 🌤 AWS provider and 🗺 eu-west-2 region"
      export CLUSTER_CLOUD=aws
      export CLUSTER_REGION=eu-west-2
      if [ -z "$CLUSTER_TYPE" ]
      then
        export CLUSTER_TYPE=basic
      fi
    fi

    if [ ! -z "$CLUSTER_CREDS" ]
    then
      # make sure it is unset
      unset CLUSTER_CREDS
    fi

    if [ ! -z $ENVIRONMENT ]
    then
      log "🌐 ENVIRONMENT is set with $ENVIRONMENT and will be used"
    else
      if [ ! -z "$SCHEMA_REGISTRY_CREDS" ]
      then
        # make sure it is unset
        unset SCHEMA_REGISTRY_CREDS
      fi
    fi
    log "🔋 CLUSTER_TYPE is set with $CLUSTER_TYPE"
    log "🌤  CLUSTER_CLOUD is set with $CLUSTER_CLOUD"
    log "🗺  CLUSTER_REGION is set with $CLUSTER_REGION"

    export EXAMPLE=$(basename $PWD)
    export QUIET=true

    log "💡 if you notice that the playground is using unexpected ccloud details, use <playground cleanup-cloud-details> to remove all caching and re-launch the example"
    check_if_continue
  else
    #
    # CLUSTER_NAME is set
    #
    log "🌱 CLUSTER_NAME is set, your existing Confluent Cloud cluster will be used..."
    if [ -z $ENVIRONMENT ] || [ -z $CLUSTER_CLOUD ] || [ -z $CLUSTER_CLOUD ] || [ -z $CLUSTER_REGION ] || [ -z $CLUSTER_CREDS ]
    then
      logerror "One mandatory environment variable to use your cluster is missing:"
      logerror "ENVIRONMENT=$ENVIRONMENT"
      logerror "CLUSTER_NAME=$CLUSTER_NAME"
      logerror "CLUSTER_CLOUD=$CLUSTER_CLOUD"
      logerror "CLUSTER_REGION=$CLUSTER_REGION"
      if [ -n "$CLUSTER_CREDS" ]
      then
        logerror "CLUSTER_CREDS is set (not shown)"
      else
        logerror "CLUSTER_CREDS="
      fi
      exit 1
    fi

    log "🌐 ENVIRONMENT is set with $ENVIRONMENT"
    log "🎰 CLUSTER_NAME is set with $CLUSTER_NAME"
    log "🌤  CLUSTER_CLOUD is set with $CLUSTER_CLOUD"
    log "🗺  CLUSTER_REGION is set with $CLUSTER_REGION"

    check_expected_ccloud_details "$expected_cloud" "$expected_region"

    log "💡 if you notice that the playground is using unexpected ccloud details, use <playground cleanup-cloud-details> to remove all caching and re-launch the example"

    if [ -z "$ccloud_cluster_list" ]
    then
      ccloud_cluster_list=$(mktemp)
      confluent kafka cluster list --output json > "$ccloud_cluster_list"
    fi
    is_current=$(jq -r --arg name "$CLUSTER_NAME" 'any(.[]; .is_current == true and .name == $name)' "$ccloud_cluster_list" 2>/dev/null || echo false)
    rm -f "$ccloud_cluster_list"

    if [ "$is_current" == "true" ]
    then
      if [ -f $DELTA_CONFIGS_ENV ]
      then
        source $DELTA_CONFIGS_ENV
        log "🌱 cluster $CLUSTER_NAME is ready to be used!"

        if [[ ! -n "$connect_migration_utility" ]]
        then
          # trick
          playground state set run.environment "ccloud"
        fi
        return
      else
        logwarn "$DELTA_CONFIGS_ENV has not been generated, doing it now..."
      fi
    fi
  fi

  check_expected_ccloud_details "$expected_cloud" "$expected_region"

  ccloud::create_ccloud_stack false

  CCLOUD_CONFIG_FILE=/tmp/tmp.config
  export CCLOUD_CONFIG_FILE=$CCLOUD_CONFIG_FILE
  ccloud::validate_ccloud_config $CCLOUD_CONFIG_FILE || exit 1

  ccloud::generate_configs $CCLOUD_CONFIG_FILE

  if [ -f $DELTA_CONFIGS_ENV ]
  then
    source $DELTA_CONFIGS_ENV
  else
    logerror "❌ $DELTA_CONFIGS_ENV has not been generated"
    exit 1
  fi

  playground state set ccloud.ENVIRONMENT "$ENVIRONMENT"
  playground state set ccloud.CLUSTER_NAME "$CLUSTER_NAME"
  playground state set ccloud.CLUSTER_CLOUD "$CLUSTER_CLOUD"
  playground state set ccloud.CLUSTER_REGION "$CLUSTER_REGION"
  playground state set ccloud.CLUSTER_CREDS "$CLUSTER_CREDS"
  playground state set ccloud.SCHEMA_REGISTRY_CREDS "$SCHEMA_REGISTRY_CREDS"

  if [[ ! -n "$connect_migration_utility" ]]
  then
	# trick
	playground state set run.environment "ccloud"
  fi
}

function create_ccloud_connector() {
  file=$1

  log "🛠️ Creating connector from $file"
  confluent connect cluster create --config-file $file
  if [[ $? != 0 ]]
  then
    logerror "Exit status was not 0 while creating connector from $file.  Please troubleshoot and try again"
  fi

  return 0
}

function validate_ccloud_connector_up() {
  connector="$1"
  if [ -f "/tmp/config-$connector" ]
  then
    set +e
    PG_SKIP_ERROR_RECOMMENDATIONS=1 playground connector create-or-update --connector "$connector" --no-clipboard --no-wait < "/tmp/config-$connector" > /tmp/output.log 2>&1
    if [ $? -ne 0 ]
    then
      echo "💀"
    else
      echo "🔁"
      cat /tmp/output.log | grep "$connector" | grep -v "\"name\"" | grep -v "ℹ️" | grep -v "playground connector create-or-update"
    fi
  else
    echo "❌"
  fi
  set -e

  connector_status=$(confluent connect cluster list -o json 2>/dev/null | jq -r 'map(select(.name == "'"$connector"'")) | .[0].status // empty' 2>/dev/null)
  if [ "$connector_status" == "RUNNING" ]
  then
    return 0
  fi

  if [ "$connector_status" == "FAILED" ]
  then
    # re-applying an identical config does not restart a failed connector or task, so a transient
    # failure at startup (e.g. 401 API_KEY_NOT_FOUND from Schema Registry right after provisioning)
    # would stay FAILED until the end of the wait: restart it explicitly
    set +e
    echo "🔄 connector $connector is FAILED, restarting it"
    playground connector restart --connector "$connector" > /dev/null 2>&1
    connector_id=$(get_ccloud_connector_lcc "$connector")
    for task_id in $(confluent connect cluster describe "$connector_id" -o json 2>/dev/null | jq -r '.tasks[]? | select(.state == "FAILED") | .task_id' 2>/dev/null)
    do
      echo "🔄 task $task_id of connector $connector is FAILED, restarting it"
      playground connector restart --connector "$connector" --task-id "$task_id" > /dev/null 2>&1
    done
    set -e
  fi

  return 1
}

function get_ccloud_connector_lcc() {
  confluent connect cluster list -o json | jq -r -e 'map(select(.name == "'"$1"'")) | .[].id'
}

function ccloud::retry() {
    local -r -i max_wait="$1"; shift
    local -r cmd="$@"

    local -i sleep_interval=5
    local -i curr_wait=0

    until $cmd
    do
        if (( curr_wait >= max_wait ))
        then
            echo "ERROR: Failed after $curr_wait seconds. Please troubleshoot and run again."
            return 1
        else
            curr_wait=$((curr_wait+sleep_interval))
            sleep $sleep_interval
        fi
    done
}

function wait_for_ccloud_connector_up() {
  connectorName=$1
  maxWait=$2

  connectorId=$(get_ccloud_connector_lcc $connectorName)
  log "⏳ waiting up to $maxWait seconds for connector $connectorName ($connectorId) to be RUNNING"
  if ! ccloud::retry $maxWait validate_ccloud_connector_up $connectorName
  then
    logerror "❌ connector $connectorName ($connectorId) is not RUNNING after $maxWait seconds"
    set +e
    playground connector status --connector $connectorName
    set -e
    exit 1
  fi
  log "🟢 connector $connectorName ($connectorId) is RUNNING"

  if [ -z "$GITHUB_RUN_NUMBER" ]
  then
    automatically=$(playground config get open-ccloud-connector-in-browser.automatically)
    if [ "$automatically" == "" ]
    then
        playground config set open-ccloud-connector-in-browser.automatically true
    fi

    browser=$(playground config get open-ccloud-connector-in-browser.browser)
    if [ "$browser" == "" ]
    then
        playground config set open-ccloud-connector-in-browser.browser ""
    fi

    if [ "$automatically" == "true" ] || [ "$automatically" == "" ]
    then
      if [ "$browser" != "" ]
      then
        log "🤖 automatically (disable with 'playground config open-ccloud-connector-in-browser automatically false') open fully managed connector $connectorName in browser $browser (you can change browser with 'playground config open-ccloud-connector-in-browser browser <browser>')"
        playground connector open-ccloud-connector-in-browser --connector $connectorName --browser $browser
      else
        log "🤖 automatically (disable with 'playground config open-ccloud-connector-in-browser automatically false') open fully managed connector $connectorName in default browser (you can set browser with 'playground config open-ccloud-connector-in-browser browser <browser>')"
        playground connector open-ccloud-connector-in-browser --connector $connectorName
      fi
    fi
  fi

  return 0
}

function delete_ccloud_connector() {
  connectorName=$1
  connectorId=$(get_ccloud_connector_lcc $connectorName)

  log "Deleting connector $connectorName ($connectorId)"
  confluent connect cluster delete $connectorId --force
  return 0
}

# arguments of a benchmark-load.bash script, called by 'playground connector benchmark':
# --records <n> --mode preload|stream --shape bulk|small-txn|update --record-size <bytes> [--check]
# sets BENCHMARK_LOAD_RECORDS, BENCHMARK_LOAD_MODE, BENCHMARK_LOAD_SHAPE, BENCHMARK_LOAD_RECORD_SIZE, and
# BENCHMARK_LOAD_CHECK with --check: the load helpers then only validate the combination, before the connector is paused
function benchmark_load_args () {
  BENCHMARK_LOAD_RECORDS=100000
  BENCHMARK_LOAD_MODE="preload"
  BENCHMARK_LOAD_SHAPE="bulk"
  BENCHMARK_LOAD_RECORD_SIZE=0
  BENCHMARK_LOAD_CHECK=""
  while [ $# -gt 0 ]
  do
    case "$1" in
      --check) BENCHMARK_LOAD_CHECK=1; shift ;;
      --records) BENCHMARK_LOAD_RECORDS="$2"; shift 2 ;;
      --mode) BENCHMARK_LOAD_MODE="$2"; shift 2 ;;
      --shape) BENCHMARK_LOAD_SHAPE="$2"; shift 2 ;;
      --record-size) BENCHMARK_LOAD_RECORD_SIZE="$2"; shift 2 ;;
      *) logerror "❌ unknown benchmark-load argument $1"; return 1 ;;
    esac
  done
}

# sqlplus connection of an oracle example script (the user, cdb or pdb of the variant that was run), for benchmark_sql_load:
# the first 'sqlplus <user>/<password>@...' that is not sys or the xstream admin, unescaped like the double quotes of the script do
function benchmark_oracle_client_from_example () {
  local test_file="$1" client=""
  if [ -f "$test_file" ]
  then
    client=$(grep -o -E 'sqlplus [^ "]+/[^ "]+@[^ "]+' "$test_file" | grep -v -i -E 'sqlplus (sys|system|[^ ]*cfltadmin)/' | head -1 | sed 's/\\\\/\\/g')
  fi
  echo "${client:-sqlplus C\#\#MYUSER/mypassword@//localhost:1521/ORCLCDB}"
}

# load for 'playground connector benchmark' on the CUSTOMERS table used by sql-datagen
# (first_name, last_name, email, gender, club_status, comments), created if it does not exist; with sqlserver, the
# dbo.customers table of the examples (first_name, last_name, email), which has cdc enabled for debezium:
#   benchmark_sql_load <postgres|mysql|mariadb|oracle|sqlserver|custom> <container> "<sql client reading stdin>" <records> <bulk|small-txn|update> [preload|stream]
# custom: the statements of a table of the example, set by the load script for <records> rows: BENCHMARK_SQL_TABLE (for
# the logs), BENCHMARK_SQL_CREATE (optional), BENCHMARK_SQL_BULK, BENCHMARK_SQL_SMALL_TXN, BENCHMARK_SQL_UPDATE,
# BENCHMARK_SQL_DELETE (a shape without statement is refused), BENCHMARK_SQL_COUNT and BENCHMARK_SQL_COUNT_FLAGS
# (row count, for update and delete), BENCHMARK_SQL_LATENCY_FIELD (optional: the column holding the time of the change)
# - bulk: one transaction inserting <records> rows
# - small-txn: <records> transactions of one row
# - update: updates <records> existing rows (run a bulk load first)
# - delete: deletes <records> existing rows, the ones with the lowest ids (drain only; plus one tombstone per row for
#   debezium / xstream with tombstones.on.delete, oracle cdc with emit.tombstone.on.delete)
# - stream mode: repeats batches of <records> rows of the shape until killed
# prints BENCHMARK_LATENCY_FIELD=<column>, the column holding the time of the change (create_ts, update_ts with --shape
# update), for the end-to-end latency of the benchmark in steady mode (not for sqlserver, whose dbo.customers has none)
# prints BENCHMARK_RECORDS=<n>, the number of records the connector should write, so that the benchmark waits for them:
# changes x BENCHMARK_RECORDS_PER_CHANGE (default 1) + transactions x BENCHMARK_RECORDS_PER_TRANSACTION (default 0),
# e.g. 2 and 1 for oracle cdc with a redo log topic, which gets the row change and the commit.
# In stream mode, repeats batches until the file $BENCHMARK_STOP_FILE exists, and prints BENCHMARK_BATCH=<records>
# <epoch seconds> after each batch, so that the benchmark knows the rate of the load.
function benchmark_sql_load () {
  local dialect="$1" container="$2" client="$3" records="$4" shape="$5" mode="${6:-preload}"
  local create_table insert_bulk insert_small_txn update count_flags count_sql="SELECT COUNT(*) FROM CUSTOMERS;" client_for_count="$client"
  local table="CUSTOMERS" latency_field="create_ts"
  [ "$shape" == "update" ] && latency_field="update_ts"
  case "$dialect" in
    custom)
      table="${BENCHMARK_SQL_TABLE:-the table}"
      create_table="$BENCHMARK_SQL_CREATE"
      insert_bulk="$BENCHMARK_SQL_BULK"
      insert_small_txn="$BENCHMARK_SQL_SMALL_TXN"
      update="$BENCHMARK_SQL_UPDATE"
      delete="$BENCHMARK_SQL_DELETE"
      count_sql="$BENCHMARK_SQL_COUNT"
      count_flags="$BENCHMARK_SQL_COUNT_FLAGS"
      latency_field="$BENCHMARK_SQL_LATENCY_FIELD"
      local shape_sql
      case "$shape" in
        bulk) shape_sql="$insert_bulk" ;;
        small-txn) shape_sql="$insert_small_txn" ;;
        update) shape_sql="$update" ;;
        delete) shape_sql="$delete" ;;
      esac
      if [ -z "$shape_sql" ]
      then
        logerror "❌ --shape $shape is not supported by the load of this example ($table)"
        return 1
      fi
    ;;
    postgres)
      create_table="CREATE TABLE IF NOT EXISTS CUSTOMERS (id SERIAL PRIMARY KEY, first_name VARCHAR(50), last_name VARCHAR(50), email VARCHAR(50), gender VARCHAR(50), club_status VARCHAR(20), comments VARCHAR(90), create_ts timestamp DEFAULT CURRENT_TIMESTAMP, update_ts timestamp DEFAULT CURRENT_TIMESTAMP);"
      insert_bulk="INSERT INTO CUSTOMERS (first_name, last_name, email, gender, club_status, comments) SELECT 'first' || i, 'last' || i, 'user' || i || '@example.com', CASE WHEN i % 2 = 0 THEN 'Female' ELSE 'Male' END, (ARRAY['bronze','silver','gold','platinum'])[1 + i % 4], 'benchmark row ' || i FROM generate_series(1, $records) AS i;"
      insert_small_txn="DO \$\$ BEGIN FOR i IN 1..$records LOOP INSERT INTO CUSTOMERS (first_name, last_name, email, gender, club_status, comments) VALUES ('first' || i, 'last' || i, 'user' || i || '@example.com', CASE WHEN i % 2 = 0 THEN 'Female' ELSE 'Male' END, (ARRAY['bronze','silver','gold','platinum'])[1 + i % 4], 'benchmark row ' || i); COMMIT; END LOOP; END \$\$;"
      update="UPDATE CUSTOMERS SET comments = 'benchmark update ' || id || ' ' || floor(random() * 1000000), update_ts = CURRENT_TIMESTAMP WHERE id IN (SELECT id FROM CUSTOMERS ORDER BY id LIMIT $records);"
      delete="DELETE FROM CUSTOMERS WHERE id IN (SELECT id FROM CUSTOMERS ORDER BY id LIMIT $records);"
      count_flags="-t -A"
    ;;
    mysql|mariadb)
      # the recursive cte of the bulk load is limited to 1000 levels by default, a setting named differently in mariadb
      local recursion_limit="SET SESSION cte_max_recursion_depth = $((records + 1));"
      [ "$dialect" == "mariadb" ] && recursion_limit="SET SESSION max_recursive_iterations = $((records + 1));"
      create_table="CREATE TABLE IF NOT EXISTS CUSTOMERS (id INT NOT NULL AUTO_INCREMENT PRIMARY KEY, first_name VARCHAR(50), last_name VARCHAR(50), email VARCHAR(50), gender VARCHAR(50), club_status VARCHAR(20), comments VARCHAR(90), create_ts TIMESTAMP(3) DEFAULT CURRENT_TIMESTAMP(3), update_ts TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3));"
      insert_bulk="$recursion_limit INSERT INTO CUSTOMERS (first_name, last_name, email, gender, club_status, comments) WITH RECURSIVE seq (i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM seq WHERE i < $records) SELECT CONCAT('first', i), CONCAT('last', i), CONCAT('user', i, '@example.com'), IF(i % 2 = 0, 'Female', 'Male'), ELT(1 + i % 4, 'bronze', 'silver', 'gold', 'platinum'), CONCAT('benchmark row ', i) FROM seq;"
      # a procedure name of its own: parallel sessions (--sessions, --enable-sql-datagen) would drop each other's
      local procedure="benchmark_small_txn_$$_$RANDOM"
      insert_small_txn="DROP PROCEDURE IF EXISTS $procedure;
DELIMITER //
CREATE PROCEDURE $procedure(IN n INT) BEGIN DECLARE i INT DEFAULT 1; WHILE i <= n DO INSERT INTO CUSTOMERS (first_name, last_name, email, gender, club_status, comments) VALUES (CONCAT('first', i), CONCAT('last', i), CONCAT('user', i, '@example.com'), IF(i % 2 = 0, 'Female', 'Male'), ELT(1 + i % 4, 'bronze', 'silver', 'gold', 'platinum'), CONCAT('benchmark row ', i)); COMMIT; SET i = i + 1; END WHILE; END //
DELIMITER ;
CALL $procedure($records);
DROP PROCEDURE $procedure;"
      update="UPDATE CUSTOMERS SET comments = CONCAT('benchmark update ', id, ' ', FLOOR(RAND() * 1000000)) ORDER BY id LIMIT $records;"
      delete="DELETE FROM CUSTOMERS ORDER BY id LIMIT $records;"
      count_flags="-N -s"
    ;;
    oracle)
      # no CREATE TABLE IF NOT EXISTS before 23c: ignore ORA-00955 (name already used)
      create_table="BEGIN
  EXECUTE IMMEDIATE 'CREATE TABLE CUSTOMERS (id NUMBER(10) GENERATED BY DEFAULT ON NULL AS IDENTITY NOT NULL PRIMARY KEY, first_name VARCHAR(50), last_name VARCHAR(50), email VARCHAR(50), gender VARCHAR(50), club_status VARCHAR(20), comments VARCHAR(90), create_ts timestamp DEFAULT CURRENT_TIMESTAMP, update_ts timestamp)';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -955 THEN RAISE; END IF;
END;
/"
      insert_bulk="INSERT INTO CUSTOMERS (first_name, last_name, email, gender, club_status, comments) SELECT 'first' || LEVEL, 'last' || LEVEL, 'user' || LEVEL || '@example.com', DECODE(MOD(LEVEL, 2), 0, 'Female', 'Male'), DECODE(MOD(LEVEL, 4), 0, 'bronze', 1, 'silver', 2, 'gold', 'platinum'), 'benchmark row ' || LEVEL FROM dual CONNECT BY LEVEL <= $records;
COMMIT;"
      insert_small_txn="BEGIN
  FOR i IN 1..$records LOOP
    INSERT INTO CUSTOMERS (first_name, last_name, email, gender, club_status, comments) VALUES ('first' || i, 'last' || i, 'user' || i || '@example.com', DECODE(MOD(i, 2), 0, 'Female', 'Male'), DECODE(MOD(i, 4), 0, 'bronze', 1, 'silver', 2, 'gold', 'platinum'), 'benchmark row ' || i);
    COMMIT;
  END LOOP;
END;
/"
      update="UPDATE CUSTOMERS SET comments = 'benchmark update ' || id || ' ' || TRUNC(DBMS_RANDOM.VALUE(0, 1000000)), update_ts = CURRENT_TIMESTAMP WHERE id IN (SELECT id FROM (SELECT id FROM CUSTOMERS ORDER BY id) WHERE ROWNUM <= $records);
COMMIT;"
      delete="DELETE FROM CUSTOMERS WHERE id IN (SELECT id FROM (SELECT id FROM CUSTOMERS ORDER BY id) WHERE ROWNUM <= $records);
COMMIT;"
      # sqlplus takes no output flag after the connect string: silent mode (no prompt on the result line) and the output format in the sql
      count_flags=""
      client_for_count="${client/sqlplus /sqlplus -s }"
      count_sql="SET HEADING OFF FEEDBACK OFF PAGESIZE 0
SELECT COUNT(*) FROM CUSTOMERS;"
    ;;
    sqlserver)
      # the examples create dbo.customers with cdc enabled (debezium needs it): only create it when it is missing
      create_table="IF OBJECT_ID('dbo.customers', 'U') IS NULL CREATE TABLE dbo.customers (id INT IDENTITY(1,1) NOT NULL PRIMARY KEY, first_name VARCHAR(255) NOT NULL, last_name VARCHAR(255) NOT NULL, email VARCHAR(255) NOT NULL);
GO"
      insert_bulk="SET NOCOUNT ON;
WITH seq AS (SELECT TOP ($records) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS i FROM sys.all_objects a CROSS JOIN sys.all_objects b CROSS JOIN sys.all_objects c)
INSERT INTO dbo.customers (first_name, last_name, email) SELECT CONCAT('first', i), CONCAT('last', i), CONCAT('user', i, '@example.com') FROM seq;
GO"
      insert_small_txn="SET NOCOUNT ON;
DECLARE @i INT = 1;
WHILE @i <= $records
BEGIN
  INSERT INTO dbo.customers (first_name, last_name, email) VALUES (CONCAT('first', @i), CONCAT('last', @i), CONCAT('user', @i, '@example.com'));
  SET @i = @i + 1;
END
GO"
      update="SET NOCOUNT ON;
UPDATE c SET email = CONCAT('update', c.id, '-', ABS(CHECKSUM(NEWID())) % 1000000, '@example.com') FROM (SELECT TOP ($records) * FROM dbo.customers ORDER BY id) c;
GO"
      delete="SET NOCOUNT ON;
WITH c AS (SELECT TOP ($records) * FROM dbo.customers ORDER BY id) DELETE FROM c;
GO"
      count_flags="-h -1"
      latency_field=""
      count_sql="SET NOCOUNT ON;
SELECT COUNT(*) FROM dbo.customers;
GO"
    ;;
    *)
      logerror "❌ benchmark_sql_load: unsupported dialect $dialect (postgres, mysql, mariadb, oracle, sqlserver, custom)"
      return 1
    ;;
  esac

  # a jdbc source in incrementing mode only captures new rows: updates would never arrive
  if [ "$shape" == "update" ] && [ -f "$BENCHMARK_CONNECTOR_CONFIG" ] && [ "$(jq -r '.mode // empty' "$BENCHMARK_CONNECTOR_CONFIG")" == "incrementing" ]
  then
    logerror "❌ the connector uses \"mode\": \"incrementing\", which does not capture updates: use --shape bulk or small-txn"
    return 1
  fi
  local connector_class=""
  [ -f "$BENCHMARK_CONNECTOR_CONFIG" ] && connector_class=$(jq -r '."connector.class" // empty' "$BENCHMARK_CONNECTOR_CONFIG")
  if [ "$shape" == "delete" ]
  then
    # a jdbc source runs queries: a deleted row is simply not returned anymore (fully managed: short class names)
    if [[ "$connector_class" == *.JdbcSourceConnector ]] || [[ "$connector_class" =~ ^(MySqlSource|PostgresSource|OracleDatabaseSource|MicrosoftSqlServerSource|IbmDb2Source)$ ]]
    then
      logerror "❌ the JDBC source connector does not capture deletes: use --shape bulk, small-txn or update"
      return 1
    fi
    # a stream of deletes would empty the table, and then delete nothing
    if [ "$mode" == "stream" ]
    then
      logerror "❌ --shape delete is for a drain (it deletes rows that a previous run inserted): not with --mode steady"
      return 1
    fi
  fi
  if [ -n "$BENCHMARK_LOAD_CHECK" ]
  then
    return 0
  fi

  local sql
  case "$shape" in
    bulk) sql="$insert_bulk" ;;
    small-txn) sql="$insert_small_txn" ;;
    update) sql="$update" ;;
    delete) sql="$delete" ;;
    *) logerror "❌ benchmark_sql_load: unknown shape $shape (bulk, small-txn, update, delete)"; return 1 ;;
  esac

  if [ -n "$create_table" ]
  then
    echo "$create_table" | playground container exec --container "$container" --command "$client" > /dev/null
  fi
  local changes="$records"
  if [ "$shape" == "update" ] || [ "$shape" == "delete" ]
  then
    local rows
    rows=$(echo "$count_sql" | playground container exec --container "$container" --command "$client_for_count $count_flags" 2> /dev/null | grep -E '^\s*[0-9]+\s*$' | tail -1 | tr -d ' ')
    rows=${rows:-0}
    if [ "$rows" -lt "$records" ]
    then
      logwarn "⚠️ only $rows rows in $table, ${shape/%e/}ing $rows rows instead of $records (run a bulk load first)"
      changes="$rows"
    fi
  fi

  local transactions=1
  if [ "$shape" == "small-txn" ]
  then
    transactions="$changes"
  fi
  # a deleted row can also give a tombstone (null value, same key): debezium and xstream by default
  # (tombstones.on.delete), oracle cdc when emit.tombstone.on.delete is true
  local tombstones=0
  if [ "$shape" == "delete" ] && [ -f "$BENCHMARK_CONNECTOR_CONFIG" ]
  then
    case "$connector_class" in
      io.debezium.*|*.OracleXStreamSourceConnector|OracleXStreamSource|*CdcSourceV2|MariaDbCdcSource|MongoDbCdcSource)
        [ "$(jq -r '."tombstones.on.delete" // "true"' "$BENCHMARK_CONNECTOR_CONFIG")" == "true" ] && tombstones=1 ;;
      *.OracleCdcSourceConnector|OracleCdcSource)
        [ "$(jq -r '."emit.tombstone.on.delete" // "false"' "$BENCHMARK_CONNECTOR_CONFIG")" == "true" ] && tombstones=1 ;;
    esac
  fi
  local expected_records=$((changes * (${BENCHMARK_RECORDS_PER_CHANGE:-1} + tombstones) + transactions * ${BENCHMARK_RECORDS_PER_TRANSACTION:-0}))
  if [ -n "$latency_field" ] && [ "$shape" != "delete" ]
  then
    echo "BENCHMARK_LATENCY_FIELD=$latency_field"
  fi

  if [ "$mode" == "stream" ]
  then
    log "🌊 $shape load on $dialect $table, batches of $changes rows, until stopped"
    while [ ! -f "${BENCHMARK_STOP_FILE:-/nonexistent}" ]
    do
      echo "$sql" | playground container exec --container "$container" --command "$client" > /dev/null
      echo "BENCHMARK_BATCH=$expected_records $(date +%s)"
    done
    return 0
  fi

  log "📥 $shape load on $dialect $table: $changes rows"
  echo "$sql" | playground container exec --container "$container" --command "$client" > /dev/null
  echo "BENCHMARK_RECORDS=$expected_records"
}

# <n> text messages "benchmark message <i>", padded with spaces to <record size> bytes when it is set, one per line
function benchmark_messages () {
  local records="$1" record_size="${2:-0}" first="${3:-1}"
  awk -v n="$records" -v size="$record_size" -v first="$first" 'BEGIN {
    for (i = first; i < first + n; i++) {
      line = "benchmark message " i
      if (size > length(line)) line = sprintf("%-" size "s", line)
      print line
    }
  }'
}

# repeats "<command producing a batch of <records> records>" until the file $BENCHMARK_STOP_FILE exists, printing
# BENCHMARK_BATCH=<records> <epoch seconds> after each batch (stream mode of a benchmark-load.bash)
function benchmark_stream_batches () {
  local records="$1"
  shift
  log "🌊 batches of $records records, until stopped"
  while [ ! -f "${BENCHMARK_STOP_FILE:-/nonexistent}" ]
  do
    "$@"
    echo "BENCHMARK_BATCH=$records $(date +%s)"
  done
}

# load script of playground connector benchmark and --enable-sql-datagen for <test file>: BENCHMARK_LOAD_SCRIPT when it
# is set (a file name in the folder of the example, or an absolute path: several loads in one folder, e.g. one per
# reproduction model, named after its ticket), the benchmark-load.bash of the folder otherwise. Prints nothing when there
# is none, fails when BENCHMARK_LOAD_SCRIPT names a file that does not exist
function benchmark_load_script () {
  local test_file="$1" dir file
  dir=$(dirname "$test_file")
  if [ -n "$BENCHMARK_LOAD_SCRIPT" ]
  then
    file="$BENCHMARK_LOAD_SCRIPT"
    [[ "$file" != /* ]] && file="$dir/$file"
    if [ ! -f "$file" ]
    then
      logerror "❌ BENCHMARK_LOAD_SCRIPT=$BENCHMARK_LOAD_SCRIPT: $file does not exist" >&2
      return 1
    fi
    echo "$file"
  elif [ -f "$dir/benchmark-load.bash" ]
  then
    echo "$dir/benchmark-load.bash"
  fi
}

# playground run --enable-sql-datagen: runs the load of <test file> (benchmark_load_script) in stream mode, one row per
# transaction, in <sessions> parallel sessions, for <minutes> minutes, then stops them at the end of their batch. Same
# loads as playground connector benchmark (CUSTOMERS table of the example, or the load of a reproduction model).
#   sql_datagen_inject <test file> <minutes> <sessions>
function sql_datagen_inject () {
  local test_file="$1" minutes="$2" sessions="$3"
  local load_script work session pids="" end rows elapsed
  load_script=$(benchmark_load_script "$test_file") || return 1
  if [ -z "$load_script" ]
  then
    logerror "❌ --enable-sql-datagen: no benchmark-load.bash next to $test_file (or BENCHMARK_LOAD_SCRIPT)"
    logerror "   for a reproduction model, link the one of its example: ln -s ../../connect/<example>/benchmark-load.bash $(dirname "$test_file")/"
    return 1
  fi
  work=$(mktemp -d -t playground-sql-datagen.XXXXXX)
  export BENCHMARK_TEST_FILE="$test_file"
  export BENCHMARK_STOP_FILE="$work/stop"
  # rows per batch of each session: small enough to stop quickly at the end, large enough to keep the database busy
  local batch=100
  if ! bash "$load_script" --check --records "$batch" --mode stream --shape small-txn > "$work/check.log" 2>&1
  then
    tail -5 "$work/check.log"
    logerror "❌ --enable-sql-datagen: $load_script refused --shape small-txn --mode stream"
    return 1
  fi
  log "🌪️ injecting rows with $(basename "$load_script") for $minutes minute(s): $sessions session(s), one row per transaction"
  for ((session = 1; session <= sessions; session++))
  do
    bash "$load_script" --records "$batch" --mode stream --shape small-txn > "$work/session-$session.log" 2>&1 &
    pids="$pids $!"
  done
  end=$(( $(date +%s) + minutes * 60 ))
  local start
  start=$(date +%s)
  while [ "$(date +%s)" -lt "$end" ]
  do
    sleep 30
    rows=$(cat "$work"/session-*.log 2> /dev/null | awk -F'[= ]' '/^BENCHMARK_BATCH=/ { n += $2 } END { print n + 0 }')
    elapsed=$(( $(date +%s) - start ))
    log "🌪️ $rows rows inserted in ${elapsed}s ($(( rows / (elapsed > 0 ? elapsed : 1) )) rows/s)"
  done
  touch "$BENCHMARK_STOP_FILE"
  local pid
  for pid in $pids
  do
    wait "$pid" 2> /dev/null || true
  done
  rows=$(cat "$work"/session-*.log 2> /dev/null | awk -F'[= ]' '/^BENCHMARK_BATCH=/ { n += $2 } END { print n + 0 }')
  elapsed=$(( $(date +%s) - start ))
  log "🌪️ done: $rows rows inserted in ${elapsed}s by $sessions session(s)"
  if grep -l -E "ERROR|ORA-|error" "$work"/session-*.log > /dev/null 2>&1
  then
    logwarn "⚠️ some sessions reported errors, see $work"
  else
    rm -rf "$work"
  fi
}

# mongosh connection of a mongodb example script (tls options of the ssl variant), for benchmark_mongo_load:
# the first 'mongosh ...' command fed by a heredoc
function benchmark_mongo_client_from_example () {
  local test_file="$1" client=""
  if [ -f "$test_file" ]
  then
    client=$(grep -E 'container exec --container mongodb --command "mongosh[^"]*" *<<' "$test_file" | head -1 | sed -E 's/.*--command "(mongosh[^"]*)".*/\1/')
    if [ -z "$client" ]
    then
      # docker exec form of the fully managed examples
      client=$(grep -E 'docker exec -i mongodb mongosh[^<]*<<' "$test_file" | head -1 | sed -E 's/.*docker exec -i mongodb (mongosh[^<]*[^< ]) *<<.*/\1/')
    fi
  fi
  echo "${client:-mongosh}"
}

# load for 'playground connector benchmark' on a mongodb collection, with mongosh in the mongodb container:
#   benchmark_mongo_load <container> "<mongosh command reading stdin>" <database> <collection> <records> <bulk|small-txn|update> [preload|stream]
# - bulk: insertMany of <records> documents (in batches of 10000)
# - small-txn: <records> insertOne
# - update: updates <records> existing documents (run a bulk load first)
# the documents have the shape of an existing document of the collection (string fields numbered, integer _id
# continued, other fields copied), so that a connector inferring the schema of the documents
# (output.schema.infer.value) gets a compatible schema. Every change is one record of the connector (change stream).
# Prints BENCHMARK_RECORDS=<n>, or BENCHMARK_BATCH lines in stream mode (until $BENCHMARK_STOP_FILE exists)
function benchmark_mongo_load () {
  local container="$1" client="$2" database="$3" collection="$4" records="$5" shape="$6" mode="${7:-preload}"
  # document factory, from an existing document when there is one
  local factory="const coll = db.getCollection('$collection');
const sample = coll.findOne();
const intId = sample !== null && typeof sample._id === 'number';
let nextId = intId ? coll.find({}, { _id: 1 }).sort({ _id: -1 }).limit(1).toArray()[0]._id + 1 : 0;
function make(i) {
  if (sample === null) return { first_name: 'first' + i, last_name: 'last' + i, email: 'user' + i + '@example.com' };
  const doc = {};
  for (const [k, v] of Object.entries(sample)) {
    if (k === '_id') { if (intId) doc._id = nextId++; continue; }
    doc[k] = typeof v === 'string' ? k + ' ' + i : v;
  }
  return doc;
}
const textField = sample === null ? 'email' : (Object.keys(sample).find(k => k !== '_id' && typeof sample[k] === 'string') || 'benchmark');"
  local js
  case "$shape" in
    bulk)
      js="$factory
for (let b = 0; b < $records; b += 10000) { const docs = []; for (let i = b; i < Math.min(b + 10000, $records); i++) docs.push(make(i)); coll.insertMany(docs, { ordered: false }) }"
    ;;
    small-txn)
      js="$factory
for (let i = 0; i < $records; i++) coll.insertOne(make(i))"
    ;;
    update)
      js="$factory
const ids = coll.find({}, { _id: 1 }).limit($records).toArray().map(d => d._id);
for (let b = 0; b < ids.length; b += 10000) coll.updateMany({ _id: { \$in: ids.slice(b, b + 10000) } }, { \$set: { [textField]: textField + ' update ' + Math.random() } });
print('BENCHMARK_UPDATED=' + ids.length)"
    ;;
    *) logerror "❌ benchmark_mongo_load: unknown shape $shape (bulk, small-txn, update)"; return 1 ;;
  esac
  if [ -n "$BENCHMARK_LOAD_CHECK" ]
  then
    return 0
  fi
  run_js () {
    printf 'use %s\n%s\n' "$database" "$js" | playground container exec --container "$container" --command "$client --quiet" 2>/dev/null
  }
  if [ "$mode" == "stream" ]
  then
    benchmark_stream_batches "$records" run_js
    return 0
  fi
  log "📥 $shape load on mongodb $database.$collection: $records documents"
  local out changes="$records"
  out=$(run_js)
  if [ "$shape" == "update" ]
  then
    changes=$(echo "$out" | sed -n 's/.*BENCHMARK_UPDATED=\([0-9]*\).*/\1/p' | tail -1)
    changes=${changes:-0}
    if [ "$changes" -lt "$records" ]
    then
      logwarn "⚠️ only $changes documents in $database.$collection, updated $changes instead of $records (run a bulk load first)"
    fi
  fi
  echo "BENCHMARK_RECORDS=$changes"
}

# load for 'playground connector benchmark' on an mqtt topic, with mosquitto_pub -l (one message per line):
#   benchmark_mqtt_load <container> "<mosquitto_pub options: host, port, credentials, tls>" <mqtt topic> <qos> <records> <record size> [preload|stream]
# stream mode only: a paused mqtt source stays connected, so the messages published while it is paused go to its
# in-memory buffer (records.buffer.queue.size) or are dropped by the broker, and a drain would not measure mqtt
function benchmark_mqtt_load () {
  if [ "${BENCHMARK_LOAD_SHAPE:-bulk}" != "bulk" ]
  then
    logerror "❌ --shape ${BENCHMARK_LOAD_SHAPE} does not apply to mqtt messages: use the default --shape bulk"
    return 1
  fi
  local container="$1" options="$2" topic="$3" qos="$4" records="$5" record_size="${6:-0}" mode="${7:-preload}"
  if [ "$mode" != "stream" ]
  then
    logerror "❌ mqtt is publish/subscribe: a paused mqtt source stays subscribed, the messages published while it is paused go to its in-memory buffer (records.buffer.queue.size) or are dropped by the broker, so a drain would not measure mqtt. Use --mode steady"
    return 1
  fi
  if [ -n "$BENCHMARK_LOAD_CHECK" ]
  then
    return 0
  fi
  publish () {
    benchmark_messages "$records" "$record_size" | playground container exec --container "$container" --command "mosquitto_pub $options -t \"$topic\" -q $qos -l" --shell sh > /dev/null 2>&1
  }
  benchmark_stream_batches "$records" publish
}

# load for 'playground connector benchmark' on an ibm mq queue, with amqsput (one message per line):
#   benchmark_ibmmq_load <container> <queue manager> <queue> <records> <record size> [preload|stream]
# the max depth of the queue is raised first: DEV.QUEUE.1 holds 5000 messages by default
function benchmark_ibmmq_load () {
  if [ "${BENCHMARK_LOAD_SHAPE:-bulk}" != "bulk" ]
  then
    logerror "❌ --shape ${BENCHMARK_LOAD_SHAPE} does not apply to ibm mq messages: use the default --shape bulk"
    return 1
  fi
  local container="$1" queue_manager="$2" queue="$3" records="$4" record_size="${5:-0}" mode="${6:-preload}"
  if [ -n "$BENCHMARK_LOAD_CHECK" ]
  then
    return 0
  fi
  echo "ALTER QLOCAL($queue) MAXDEPTH(999999999)" | playground container exec --container "$container" --command "/opt/mqm/bin/runmqsc $queue_manager" > /dev/null
  put () {
    benchmark_messages "$records" "$record_size" | playground container exec --container "$container" --command "/opt/mqm/samp/bin/amqsput $queue $queue_manager" > /dev/null
  }
  if [ "$mode" == "stream" ]
  then
    benchmark_stream_batches "$records" put
    return 0
  fi
  log "📥 $records messages to ibm mq queue $queue"
  put
  echo "BENCHMARK_RECORDS=$records"
}

# value of <key> in the connector config, for a benchmark-load.bash: the connect rest api masks the passwords
# ("••••", "[hidden]", "****" for the ccloud connect api), so a masked value is taken from the connector config of the example script that was run
# ($BENCHMARK_TEST_FILE), when it is a literal there
function benchmark_connector_config_value () {
  local key="$1" value
  value=$(jq -r --arg k "$key" '.[$k] // empty' "$BENCHMARK_CONNECTOR_CONFIG" 2> /dev/null)
  if [[ "$value" == *"•"* ]] || [ "$value" == "[hidden]" ] || [[ "$value" =~ ^\*+$ ]]
  then
    value=""
    if [ -f "$BENCHMARK_TEST_FILE" ]
    then
      value=$(grep -o -E "\"${key//./\\.}\"[[:space:]]*:[[:space:]]*\"[^\"\$]*\"" "$BENCHMARK_TEST_FILE" | head -1 | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/')
    fi
    if [ -z "$value" ]
    then
      logwarn "⚠️ $key is masked by the connect rest api and is not a literal in $(basename "$BENCHMARK_TEST_FILE")"
    fi
  fi
  echo "$value"
}

# common checks of the message loads: <shapes> is the list of supported shapes; a topic (publish/subscribe) can only be
# measured in stream mode, since a paused subscriber does not keep the backlog in the broker
function benchmark_check_messages_load () {
  local shapes="$1" destination_type="$2" mode="$3"
  local shape="${BENCHMARK_LOAD_SHAPE:-bulk}"
  if [[ " $shapes " != *" $shape "* ]]
  then
    logerror "❌ --shape $shape does not apply to this load: use one of $shapes"
    return 1
  fi
  if [[ "$destination_type" =~ ^[Tt][Oo][Pp][Ii][Cc]$ ]] && [ "$mode" != "stream" ]
  then
    logerror "❌ the destination is a topic (publish/subscribe): a paused subscriber does not keep the backlog in the broker, so a drain would not measure the connector. Use --mode steady"
    return 1
  fi
}

# load for 'playground connector benchmark' on an activemq destination, with BenchmarkJmsProducer run in the activemq
# container with the activemq-all jar of the broker (the 'activemq producer' tool never commits the messages sent after
# its last transaction batch, so its count is not exact):
#   benchmark_activemq_load <container> <user> <password> <queue|topic> <destination> <records> <record size> [preload|stream]
# --shape bulk: jms transactions of 1000 messages, --shape small-txn: one persistent send per message
function benchmark_activemq_load () {
  local container="$1" user="$2" password="$3" destination_type="$4" destination="$5" records="$6" record_size="${7:-0}" mode="${8:-preload}"
  benchmark_jms_load "$container" "/opt/activemq/*" org.apache.activemq.jndi.ActiveMQInitialContextFactory tcp://localhost:61616 "$user" "$password" ConnectionFactory "$destination_type" "$destination" "$records" "$record_size" "$mode"
}

# load for 'playground connector benchmark' on a rabbitmq queue, with the producer.py of the example (one connection):
#   benchmark_rabbitmq_load <producer container> <queue> <records> [preload|stream]
function benchmark_rabbitmq_load () {
  local container="$1" queue="$2" records="$3" mode="${4:-preload}"
  benchmark_check_messages_load "bulk" "queue" "$mode" || return 1
  [ -n "$BENCHMARK_LOAD_CHECK" ] && return 0
  send () {
    playground container exec --container "$container" --command "bash -c \"python /producer.py $queue $records\"" > /dev/null 2>&1
  }
  if [ "$mode" == "stream" ]
  then
    benchmark_stream_batches "$records" send
    return 0
  fi
  log "📥 $records messages to rabbitmq queue $queue"
  send
  echo "BENCHMARK_RECORDS=$records"
}

# load for 'playground connector benchmark' on a solace queue or topic, with the rest messaging port of the broker
# (curl, keep-alive and 16 parallel transfers). Each message gets a Solace-Message-ID: without it the jms message id is
# null, which the solace source connector rejects (required field "messageID"):
#   benchmark_solace_load <rest url, e.g. http://localhost:9000> <queue|topic> <destination> <records> <record size> [preload|stream]
function benchmark_solace_load () {
  local url="$1" destination_type="$2" destination="$3" records="$4" record_size="${5:-0}" mode="${6:-preload}"
  benchmark_check_messages_load "bulk" "$destination_type" "$mode" || return 1
  [ -n "$BENCHMARK_LOAD_CHECK" ] && return 0
  local path="Queue"
  [[ "$destination_type" =~ ^[Tt][Oo][Pp][Ii][Cc]$ ]] && path="TOPIC"
  send () {
    benchmark_messages "$records" "$record_size" | awk -v url="$url/$path/$destination" -v id="benchmark-$(date +%s)" '{ if (NR > 1) print "next"; printf "url = \"%s\"\ndata = \"%s\"\nheader = \"Content-Type: text/plain\"\nheader = \"Solace-Message-ID: %s-%d\"\noutput = /dev/null\n", url, $0, id, NR }' \
      | curl -s --fail-early --parallel --parallel-max 16 -K -
  }
  if [ "$mode" == "stream" ]
  then
    benchmark_stream_batches "$records" send
    return 0
  fi
  log "📥 $records messages to solace $(echo "$path" | tr "[:upper:]" "[:lower:]") $destination"
  send
  echo "BENCHMARK_RECORDS=$records"
}

# load for 'playground connector benchmark' on the http event collector of the splunk source connector (curl, 1000
# events per request), stream mode only: the connector receives the events itself, a paused connector keeps them in
# memory, so a drain would not measure it
#   benchmark_splunk_load <collector url, e.g. https://localhost:8889/services/collector/event> <records> <record size> [preload|stream]
function benchmark_splunk_load () {
  local url="$1" records="$2" record_size="${3:-0}" mode="${4:-preload}"
  benchmark_check_messages_load "bulk" "queue" "$mode" || return 1
  if [ "$mode" != "stream" ]
  then
    logerror "❌ the splunk source connector receives the events itself (http event collector): events sent while it is paused are kept in its memory, so a drain would not measure it. Use --mode steady"
    return 1
  fi
  [ -n "$BENCHMARK_LOAD_CHECK" ] && return 0
  send () {
    local first
    for ((first = 1; first <= records; first += 1000))
    do
      benchmark_messages "$(( records - first + 1 < 1000 ? records - first + 1 : 1000 ))" "$record_size" "$first" | awk '{ printf "{\"event\":\"%s\"}", $0 }' \
        | curl -s -k -o /dev/null -X POST "$url" --data-binary @-
    done
  }
  benchmark_stream_batches "$records" send
}

# load for 'playground connector benchmark' made of files, uploaded by the function of the example:
#   benchmark_files_load <upload function> <records> <record size> <preload|stream> <format> <extension>
# <upload function> <folder name in $PLAYGROUND_HOST_TMP_DIR, the /tmp of the cli containers> uploads the files of the
# folder, in the order of their names (several at once is fine: the connector is paused during a drain)
# <format>, one record per line:
#   json-f1                         {"f1":"benchmark message <i>"}
#   users-json                      the users of the sftp examples: {"id":<i>,"first_name":...,"favorite_color":...}
#   users-csv:<separator>:<header>  the same users, <separator> as an ascii code (44 for a comma, 9 for a tab), with a
#                                   header line in each file when <header> is true
#   custom                          the rows of the load script: BENCHMARK_FILES_ROW, where {id} and {message} are replaced,
#                                   after the optional header line BENCHMARK_FILES_HEADER
# - bulk: files of BENCHMARK_FILE_RECORDS (10000) records; small-txn: one record per file (the cost of listing and
#   opening each file), drain only
# - stream mode: one file of <records> records per batch, uploaded on its own
# the names start with zz-benchmark-<epoch>-<batch>, so that they sort after the files of the example and of the
# previous runs (connectors that read the files in the order of their names)
function benchmark_files_load () {
  local upload="$1" records="$2" record_size="${3:-0}" mode="${4:-preload}" format="${5:-json-f1}" extension="${6:-json}"
  local shape="${BENCHMARK_LOAD_SHAPE:-bulk}" per_file="${BENCHMARK_FILE_RECORDS:-10000}"
  if [[ " bulk small-txn " != *" $shape "* ]]
  then
    logerror "❌ --shape $shape does not apply to files: a rewritten file is not read again (use bulk or small-txn)"
    return 1
  fi
  if [ "$shape" == "small-txn" ] && [ "$mode" == "stream" ]
  then
    logerror "❌ --shape small-txn uploads one file per record, too slow for a stream (one upload at a time, in order): use --mode drain, or --shape bulk"
    return 1
  fi
  [ "$shape" == "small-txn" ] && per_file=1
  [ -n "$BENCHMARK_LOAD_CHECK" ] && return 0

  local work name batch=0
  work=$(mktemp -d "$PLAYGROUND_HOST_TMP_DIR/benchmark-files.XXXXXX")
  name=$(basename "$work")
  # <records> records in files of <per file> records, named after the time, the batch and the process (sessions)
  write_files () {
    local count="$1" size="$2" prefix
    rm -f "$work"/*
    batch=$((batch + 1))
    prefix="zz-benchmark-$(date +%s)-$(printf '%06d' "$batch")-$$"
    benchmark_messages "$count" "$record_size" | BENCHMARK_FILES_ROW="${BENCHMARK_FILES_ROW:-}" BENCHMARK_FILES_HEADER="${BENCHMARK_FILES_HEADER:-}" \
      awk -v per="$size" -v dir="$work" -v prefix="$prefix" -v ext="$extension" -v format="$format" '
    BEGIN {
      n = split(format, f, ":")
      separator = (n > 1) ? sprintf("%c", f[2]) : ","
      header = (n > 2 && f[3] == "true")
    }
    {
      file = sprintf("%s/%s-%06d.%s", dir, prefix, int((NR - 1) / per), ext)
      id = $3
      if (f[1] == "custom") {
        if (ENVIRON["BENCHMARK_FILES_HEADER"] != "" && (NR - 1) % per == 0) print ENVIRON["BENCHMARK_FILES_HEADER"] > file
        row = ENVIRON["BENCHMARK_FILES_ROW"]
        gsub(/\{id\}/, id, row)
        # the messages have no & (which gsub would replace by the match)
        gsub(/\{message\}/, $0, row)
        print row > file
      } else if (f[1] == "json-f1") {
        printf "{\"f1\":\"%s\"}\n", $0 > file
      } else if (f[1] == "users-json") {
        printf "{\"id\":%d,\"first_name\":\"benchmark\",\"last_name\":\"%s\",\"email\":\"benchmark%d@example.com\",\"gender\":\"Female\",\"ip_address\":\"10.0.0.1\",\"last_login\":\"2018-02-12T06:26:23Z\",\"account_balance\":1450.68,\"country\":\"FR\",\"favorite_color\":\"#4eaefa\"}\n", id, $0, id > file
      } else {
        if (header && (NR - 1) % per == 0) {
          print "id" separator "first_name" separator "last_name" separator "email" separator "gender" separator "ip_address" separator "last_login" separator "account_balance" separator "country" separator "favorite_color" > file
        }
        print id separator "benchmark" separator $0 separator "benchmark" id "@example.com" separator "Female" separator "10.0.0.1" separator "2018-02-12T06:26:23Z" separator "1450.68" separator "FR" separator "#4eaefa" > file
      }
      if (NR % per == 0) close(file)
    }'
  }
  if [ "$mode" == "stream" ]
  then
    upload_batch () {
      write_files "$records" "$records"
      "$upload" "$name"
    }
    benchmark_stream_batches "$records" upload_batch
    rm -rf "$work"
    return 0
  fi
  write_files "$records" "$per_file"
  log "📥 $shape load: $records records in $(ls "$work" | wc -l | tr -d ' ') file(s) of $per_file record(s)"
  "$upload" "$name"
  rm -rf "$work"
  echo "BENCHMARK_RECORDS=$records"
}

# load for 'playground connector benchmark' on the generalized mode (mode=GENERIC, json format) of the s3, gcs and azure
# blob storage source connectors: json-f1 files (benchmark_files_load) uploaded to the topics.dir of the connector:
#   benchmark_cloud_storage_load <upload function> <records> <record size> [preload|stream]
# the connector lists the objects after the last one it read (startAfter), hence the names that sort after the previous
# ones, and the uploads one by one in a stream (no --sessions in steady mode: an object uploaded after a higher name was
# read is skipped)
function benchmark_cloud_storage_load () {
  local upload="$1" records="$2" record_size="${3:-0}" mode="${4:-preload}"
  local mode_config format
  mode_config=$(jq -r '.mode // "RESTORE_BACKUP"' "$BENCHMARK_CONNECTOR_CONFIG")
  format=$(jq -r '."format.class" // ""' "$BENCHMARK_CONNECTOR_CONFIG")
  # fully managed: input.data.format
  if [ "$(jq -r '."input.data.format" // ""' "$BENCHMARK_CONNECTOR_CONFIG")" == "JSON" ]
  then
    mode_config="GENERIC"
    format="JsonFormat"
  fi
  if [ "$mode_config" != "GENERIC" ] || [[ "$format" != *JsonFormat ]]
  then
    logerror "❌ this load writes json files for the generalized mode (mode=GENERIC, a JsonFormat): the connector has mode=$mode_config and format.class=$format, run the *-generalized.sh example"
    return 1
  fi
  benchmark_files_load "$upload" "$records" "$record_size" "$mode" json-f1 json
}

# format and extension of the files of users for a source of the spool dir family (spool dir, sftp, ftps), from the
# connector class and config in $BENCHMARK_CONNECTOR_CONFIG: prints "<format> <extension>" for benchmark_files_load, with
# <input file pattern key> the config key of the pattern of the input files (input.file.pattern, ftps.input.file.pattern)
#   read -r format extension <<< "$(benchmark_users_files_format input.file.pattern)" || exit 1
function benchmark_users_files_format () {
  local pattern_key="${1:-input.file.pattern}" connector_class format pattern extension="" candidate
  connector_class=$(jq -r '."connector.class" // empty' "$BENCHMARK_CONNECTOR_CONFIG")
  case "$connector_class" in
    *CsvSourceConnector)
      format="users-csv:$(jq -r '."csv.separator.char" // "44"' "$BENCHMARK_CONNECTOR_CONFIG"):$(jq -r '."csv.first.row.as.header" // "false"' "$BENCHMARK_CONNECTOR_CONFIG")"
      ;;
    *JsonSourceConnector|*LineDelimitedSourceConnector|*FtpsSourceConnector)
      format="users-json"
      ;;
    # fully managed sftp: the format is in input.file.parser.format
    SftpSource)
      case "$(jq -r '."input.file.parser.format" // ""' "$BENCHMARK_CONNECTOR_CONFIG")" in
        CSV) format="users-csv:$(jq -r '."csv.separator.char" // "44"' "$BENCHMARK_CONNECTOR_CONFIG"):$(jq -r '."csv.first.row.as.header" // "false"' "$BENCHMARK_CONNECTOR_CONFIG")" ;;
        JSON) format="users-json" ;;
        *) logerror "❌ this load writes json or csv files of users: input.file.parser.format must be CSV or JSON" >&2; return 1 ;;
      esac
      ;;
    *)
      logerror "❌ this load writes json or csv files of users: $connector_class is not supported" >&2
      return 1
      ;;
  esac
  # an extension that the pattern accepts (a java regex matching the whole name, the same as grep -E -x here)
  pattern=$(jq -r --arg k "$pattern_key" '.[$k] // ".*"' "$BENCHMARK_CONNECTOR_CONFIG")
  for candidate in json csv tsv txt
  do
    if echo "zz-benchmark-1-000001-1-000000.$candidate" | grep -q -E -x -- "$pattern"
    then
      extension="$candidate"
      break
    fi
  done
  if [ -z "$extension" ]
  then
    logerror "❌ $pattern_key $pattern accepts no file name of this load (zz-benchmark-<...>.json|csv|tsv|txt): use a pattern like .*\\.csv" >&2
    return 1
  fi
  echo "$format $extension"
}

# upload of the files of a benchmark_files_load folder (<folder name> in $PLAYGROUND_HOST_TMP_DIR) to the folder <input
# path> of <container>: copied next to it first, then moved into it (as root, owned like the input folder), so that the
# connector never sees a file being written
#   benchmark_container_files_upload <container> <input path> <folder name>
function benchmark_container_files_upload () {
  local container="$1" input_path="$2" name="$3"
  local staging
  staging="$(dirname "$input_path")/.benchmark-$name"
  playground --output-level ERROR container cp --source "$PLAYGROUND_HOST_TMP_DIR/$name" --destination "$container:$staging" > /dev/null
  playground --output-level ERROR container exec --container "$container" --root --command "chown -R --reference=$input_path $staging && mv $staging/* $input_path/ && rmdir $staging" > /dev/null
}

# load for 'playground connector benchmark' on an hdfs source (hdfs 2 and hdfs 3): avro files of
# {"f1":"benchmark message <i>"} records (the schema of the examples) written in the layout of the hdfs sink,
# <topics.dir>/<topic>/<partition>/<topic>+0+<start>+<end>.avro, with the hdfs command of the namenode container:
#   benchmark_hdfs_load "<hdfs command, e.g. /opt/hadoop-3.1.3/bin/hdfs>" <records> <record size> [preload|stream]
# the topic is the first folder of <topics.dir> (BENCHMARK_HDFS_TOPIC to choose another one). The source reads the file
# listed after the last one it read: the files go to a partition folder that sorts after the ones of the sink
# (f1=zz-benchmark with the FieldPartitioner of the examples, partition=0 with the DefaultPartitioner), with offsets
# growing from one run (and one batch) to the next. hdfs dfs -put writes <file>._COPYING_ and renames it: the source
# never reads a file being written
function benchmark_hdfs_load () {
  local hdfs="$1" records="$2" record_size="${3:-0}" mode="${4:-preload}"
  local format topics_dir
  format=$(jq -r '."format.class" // empty' "$BENCHMARK_CONNECTOR_CONFIG")
  if [[ "$format" != *avro.AvroFormat ]]
  then
    logerror "❌ this load writes avro files: the connector has format.class=$format"
    return 1
  fi
  topics_dir=$(jq -r '."topics.dir" // "topics"' "$BENCHMARK_CONNECTOR_CONFIG")
  benchmark_hdfs_topic=""
  benchmark_hdfs_partition=""
  if [ -z "$BENCHMARK_LOAD_CHECK" ]
  then
    # the paths of hdfs dfs -ls are in its last column (no -C option in hadoop 2.7)
    benchmark_hdfs_topic="${BENCHMARK_HDFS_TOPIC:-$(playground --output-level ERROR container exec --container namenode --command "$hdfs dfs -ls /$topics_dir" 2> /dev/null | awk '$NF ~ /^\// { print $NF }' | grep -v -E '/(\+tmp|_)' | head -1 | xargs -n1 basename 2> /dev/null)}"
    if [ -z "$benchmark_hdfs_topic" ]
    then
      logerror "❌ no topic folder in /$topics_dir in hdfs: run the example first"
      return 1
    fi
    benchmark_hdfs_partition=$(playground --output-level ERROR container exec --container namenode --command "$hdfs dfs -ls /$topics_dir/$benchmark_hdfs_topic" 2> /dev/null | awk '$NF ~ /^\// { print $NF }' | grep "=" | head -1 | xargs -n1 basename 2> /dev/null | cut -d= -f1)
    case "$benchmark_hdfs_partition" in
      partition|"") benchmark_hdfs_partition="partition=0" ;;
      *) benchmark_hdfs_partition="$benchmark_hdfs_partition=zz-benchmark" ;;
    esac
  fi
  benchmark_hdfs_next_offset=$(( $(date +%s) * 1000000000 ))
  benchmark_hdfs_upload () {
    local work="$PLAYGROUND_HOST_TMP_DIR/$1" file count list=""
    mkdir -p "$work/avro"
    echo '{"type":"record","name":"myrecord","fields":[{"name":"f1","type":"string"}]}' > "$work/avro/schema.avsc"
    for file in $(cd "$work" && ls *.json)
    do
      count=$(grep -c . "$work/$file")
      list="$list$file $(printf '%s+0+%019d+%019d.avro' "$benchmark_hdfs_topic" "$benchmark_hdfs_next_offset" $((benchmark_hdfs_next_offset + count - 1)))"$'\n'
      benchmark_hdfs_next_offset=$((benchmark_hdfs_next_offset + count))
    done
    echo -n "$list" > "$work/avro/list"
    # one container for all the files, as root (the hadoop login of avro-tools needs a known user), then given back
    # to the user: they are removed below
    docker run --quiet --rm -v "$work:/w" --entrypoint sh vdesabou/avro-tools -c \
      'while read -r json avro; do java -jar /opt/avro-tools.jar fromjson --schema-file /w/avro/schema.avsc "/w/$json" > "/w/avro/$avro" || exit 1; done < /w/avro/list; chown -R '"$(id -u):$(id -g)"' /w/avro'
    rm -f "$work/avro/schema.avsc" "$work/avro/list"
    playground --output-level ERROR container cp --source "$work/avro" --destination "namenode:/tmp/$1" > /dev/null
    playground --output-level ERROR container exec --container namenode --command "$hdfs dfs -mkdir -p /$topics_dir/$benchmark_hdfs_topic/$benchmark_hdfs_partition && $hdfs dfs -put /tmp/$1/*.avro /$topics_dir/$benchmark_hdfs_topic/$benchmark_hdfs_partition/ && rm -rf /tmp/$1" > /dev/null
    rm -rf "$work/avro"
  }
  benchmark_files_load benchmark_hdfs_upload "$records" "$record_size" "$mode" json-f1 json
}

# load for 'playground connector benchmark' on a file tailed by a source (FileStream): <records> lines of users appended
# to <file> in <container>, in one write (the connector buffers a partial last line until its newline arrives):
#   benchmark_append_file_load <container> <file> <records> <record size> [preload|stream]
function benchmark_append_file_load () {
  local container="$1" file="$2" records="$3" record_size="${4:-0}" mode="${5:-preload}"
  if [ "${BENCHMARK_LOAD_SHAPE:-bulk}" != "bulk" ]
  then
    logerror "❌ --shape ${BENCHMARK_LOAD_SHAPE} does not apply to lines appended to a file: use the default --shape bulk"
    return 1
  fi
  [ -n "$BENCHMARK_LOAD_CHECK" ] && return 0
  append () {
    benchmark_messages "$records" "$record_size" | awk '{ printf "{\"id\":%d,\"first_name\":\"benchmark\",\"last_name\":\"%s\",\"email\":\"benchmark%d@example.com\"}\n", $3, $0, $3 }' \
      | playground --output-level ERROR container exec --container "$container" --command "cat >> $file" > /dev/null
  }
  if [ "$mode" == "stream" ]
  then
    benchmark_stream_batches "$records" append
    return 0
  fi
  log "📥 $records lines appended to $file"
  append
  echo "BENCHMARK_RECORDS=$records"
}

# docker image with python, boto3 and google-cloud-pubsub for tools/benchmark-python/benchmark_producer.py, built once
function benchmark_python_image () {
  local image="playground-benchmark-python:1"
  if ! docker image inspect "$image" > /dev/null 2>&1
  then
    log "🐍 building the $image image (python, boto3, google-cloud-pubsub), once" >&2
    if ! printf 'FROM python:3.12-slim\nRUN pip install --no-cache-dir boto3 google-cloud-pubsub\n' | docker build -q -t "$image" - > /dev/null
    then
      logerror "❌ could not build $image" >&2
      return 1
    fi
  fi
  echo "$image"
}

# load for 'playground connector benchmark' on sqs, kinesis, pub/sub or cloudwatch logs, with
# tools/benchmark-python/benchmark_producer.py:
#   benchmark_python_load "<docker run options: credentials>" <records> <record size> <preload|stream> <sqs|kinesis|pubsub|cloudwatch-logs> <producer options>...
# --shape bulk: batches (10 messages for sqs, 500 records for kinesis, 1000 messages for pub/sub, 10000 events in one
# stream for cloudwatch logs) sent by 16 threads (one for cloudwatch logs, which takes the events of a stream in order),
# --shape small-txn: one request per message. The messages are "benchmark message <i>", padded to <record size>
function benchmark_python_load () {
  local docker_options="$1" records="$2" record_size="${3:-0}" mode="${4:-preload}" target="$5"
  shift 5
  benchmark_check_messages_load "bulk small-txn" "queue" "$mode" || return 1
  [ -n "$BENCHMARK_LOAD_CHECK" ] && return 0
  local image tools first=1
  image=$(benchmark_python_image) || return 1
  tools="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)/tools/benchmark-python"
  [ -n "$root_folder" ] && tools="$root_folder/tools/benchmark-python"
  send () {
    # shellcheck disable=SC2086
    docker run --quiet --rm -v "$tools:/w:ro" $docker_options "$image" python -I /w/benchmark_producer.py "$target" \
      --records "$records" --first "$first" --record-size "$record_size" --shape "${BENCHMARK_LOAD_SHAPE:-bulk}" "$@" > /dev/null || return 1
    first=$((first + records))
  }
  if [ "$mode" == "stream" ]
  then
    benchmark_stream_batches "$records" send "$@"
    return 0
  fi
  log "📥 ${BENCHMARK_LOAD_SHAPE:-bulk} load on $target: $records messages"
  send "$@" || return 1
  echo "BENCHMARK_RECORDS=$records"
}

# docker run options giving the aws credentials of the playground to a container: the AWS_* variables when they are set
# (short-lived credentials too), ~/.aws otherwise (same order as the aws function)
function benchmark_aws_docker_options () {
  if [ -n "$AWS_ACCESS_KEY_ID" ] && [ -n "$AWS_SECRET_ACCESS_KEY" ]
  then
    echo "-e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN"
  else
    echo "-v $HOME/.aws:/root/.aws:ro"
  fi
}

# compiled tools/benchmark-jms/BenchmarkJmsProducer.java (javax.jms 1.1 api), cached in ~/.playground-benchmark-jms:
# prints the folder of BenchmarkJmsProducer.class
function benchmark_jms_producer_classes () {
  local cache="$HOME/.playground-benchmark-jms"
  local source_file="$root_folder/tools/benchmark-jms/BenchmarkJmsProducer.java"
  [ -z "$root_folder" ] && source_file="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)/tools/benchmark-jms/BenchmarkJmsProducer.java"
  if [ ! -f "$cache/classes/BenchmarkJmsProducer.class" ] || [ "$source_file" -nt "$cache/classes/BenchmarkJmsProducer.class" ]
  then
    mkdir -p "$cache/classes"
    [ -f "$cache/javax.jms-api-2.0.1.jar" ] || curl -sSL -o "$cache/javax.jms-api-2.0.1.jar" https://repo1.maven.org/maven2/javax/jms/javax.jms-api/2.0.1/javax.jms-api-2.0.1.jar
    cp "$source_file" "$cache/"
    # compiled in a jdk container: the connect image has no compiler
    docker run --rm -v "$cache:/w" eclipse-temurin:17-jdk javac --release 8 -cp /w/javax.jms-api-2.0.1.jar -d /w/classes /w/BenchmarkJmsProducer.java > /dev/null 2>&1 || { logerror "❌ could not compile BenchmarkJmsProducer"; return 1; }
  fi
  echo "$cache/classes"
}

# load for 'playground connector benchmark' on any jms destination, with BenchmarkJmsProducer run in <container> with
# the jms client jars of the provider (<classpath>), and the jndi settings of the connector:
#   benchmark_jms_load <container> "<classpath>" <jndi factory> <provider url> <principal> <credentials> <connection factory> <queue|topic> <destination> <records> <record size> [preload|stream]
# --shape bulk: jms transactions of 1000 messages, --shape small-txn: one persistent send per message
# BENCHMARK_JMS_JSON=<template> sends the template with {message} replaced by "benchmark message <i>" instead, for a
# connector that parses json (true: {"f1":"{message}"}; no single quote in the template)
function benchmark_jms_load () {
  local container="$1" classpath="$2" factory="$3" url="$4" principal="$5" credentials="$6" cf="$7" destination_type="$8" destination="$9" records="${10}" record_size="${11:-0}" mode="${12:-preload}"
  benchmark_check_messages_load "bulk small-txn" "$destination_type" "$mode" || return 1
  [ -n "$BENCHMARK_LOAD_CHECK" ] && return 0
  local classes batch=1000
  [ "${BENCHMARK_LOAD_SHAPE:-bulk}" == "small-txn" ] && batch=0
  classes=$(benchmark_jms_producer_classes) || return 1
  playground container cp --source "$classes/BenchmarkJmsProducer.class" --destination "$container:/tmp/BenchmarkJmsProducer.class" > /dev/null 2>&1
  send () {
    playground container exec --container "$container" --command "java '-Dbenchmark.json=${BENCHMARK_JMS_JSON:-false}' -cp '/tmp:$classpath' BenchmarkJmsProducer '$factory' '$url' '$principal' '$credentials' '$cf' '$destination_type' '$destination' $records $record_size $batch" > /dev/null
  }
  if [ "$mode" == "stream" ]
  then
    benchmark_stream_batches "$records" send
    return 0
  fi
  log "📥 $records messages to jms $destination_type $destination"
  send
  echo "BENCHMARK_RECORDS=$records"
}

function wait_for_log () {
  message="$1"
  container=${2:-connect}
  max_wait=${3:-600}
  cur_wait=0
  log "⌛ Waiting up to $max_wait seconds for message $message to be present in $container container logs..."
  docker container logs ${container} > /tmp/out.txt 2>&1
  while ! grep "$message" /tmp/out.txt > /dev/null;
  do
  sleep 10
  docker container logs ${container} > /tmp/out.txt 2>&1
  cur_wait=$(( cur_wait+10 ))
  if [[ "$cur_wait" -gt "$max_wait" ]]; then
    logerror "The logs in $container container do not show '$message' after $max_wait seconds. Please troubleshoot with 'docker container ps' and 'playground container logs --open --container <container>'."
    return 1
  fi
  done
  grep "$message" /tmp/out.txt
  log "The log is there !"
}

