    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-open")"
    printf "    🚫 Do not open the generated configurations in the editor, and do not offer\n    to open the fully managed connector in the browser\n    \n    The configurations are used as generated by <discovery> (with the\n    --sensitive-property values applied), so the command runs unattended\n    (scripts, agents)\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground connector connect-migration-utility migrate --migration-mode\n  stop_create_latest_offset --sensitive-property\n  'aws.access.key.id=\$AWS_ACCESS_KEY_ID' --sensitive-property\n  'aws.secret.access.key=\$AWS_SECRET_ACCESS_KEY'\n"
    printf "  playground connector connect-migration-utility migrate --migration-mode\n  create_latest_offset --no-open\n"
