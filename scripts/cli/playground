    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--staged")"
    printf "    🪝 Check the staged content of the files about to be committed (what the\n    pre-commit hook uses)\n"
    printf "    %s\n" "Conflicts: --file, --all"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--all")"
    printf "    📚 Check every file of reproduction-models, committed or not (one-time audit)\n"
    printf "    %s\n" "Conflicts: --file, --staged"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--skip-secrets-store")"
    printf "    ⚡ Do not read the 'playground secrets' store, which can prompt (1Password):\n    only the exported variables, playground.ini and ~/.aws/credentials values,\n    and the token formats\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--json")"
    printf "    🤖 Print the findings as JSON (exit code 1 still means a secret was found)\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground repro check\n"
    printf "  playground repro check --staged\n"
    printf "  playground repro check -f\n  ~/kafka-docker-playground/reproduction-models/connect-connect-http-sink/http-repro-123456-dlq.sh\n"
    printf "  playground repro check --all --json\n"
    echo

  fi
