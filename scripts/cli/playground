# :command.function
playground_rbac_acl_list_command() {

  # src/commands/rbac/acl/list.sh
  principal="${args[--principal]}"
  verbose="${args[--verbose]}"

  get_environment_used
  if [[ "$environment" == "ccloud" ]]
  then
    # Confluent Cloud ACLs of the cluster of the ccloud run
    get_ccloud_rbac_acl_principal || exit 1
    rows=$(get_ccloud_acls "$principal") || exit 1
    rows=$(awk -F'\t' -v OFS='\t' 'NF { print $0, "*", "confluent-cloud" }' <<< "$rows")
    if [[ -z "$rows" ]]
    then
      logwarn "no ACL found"
      exit 0
    fi
    {
      printf "PRINCIPAL\tPERMISSION\tOPERATION\tRESOURCE\tPATTERN\tHOST\tSTORE\n"
      echo "$rows"
    } | column -t -s $'\t'
    exit 0
  fi

  if [[ -n "${args[--connector]}" ]]
  then
    logerror "❌ --connector is only supported with Confluent Cloud (fully managed connectors)"
    exit 1
  fi

  entry_filter='{"operation": "ANY", "permissionType": "ANY"}'
  kafka_acls_principal=""
  if [[ -n "$principal" ]]
  then
    principal=$(normalize_rbac_principal "$principal")
    entry_filter=$(jq -nc --arg principal "$principal" '{principal: $principal, operation: "ANY", permissionType: "ANY"}')
    kafka_acls_principal="--principal $principal"
  fi

  get_mds_scope kafka || exit 1
  mds_request POST "/security/1.0/acls:search" "$(jq -nc --argjson scope "$mds_scope" --argjson entry "$entry_filter" '{scope: $scope, aclBindingFilter: {patternFilter: {resourceType: "ANY", patternType: "ANY"}, entryFilter: $entry}}')" || exit 1
  rows=$(jq -r '.[] | [.entry.principal, .entry.permissionType, .entry.operation, "\(.pattern.resourceType):\(.pattern.name)", .pattern.patternType, .entry.host, "centralized"] | @tsv' <<< "$mds_output")

  # regular Kafka ACLs, kafka-acls --list prints:
  # Current ACLs for resource `ResourcePattern(resourceType=TOPIC, name=foo, patternType=LITERAL)`:
  #  	(principal=User:charlie, host=*, operation=READ, permissionType=ALLOW)
  kafka_acls_output=$(playground container exec -c broker --command "kafka-acls --bootstrap-server broker:9092 --command-config /etc/kafka/secrets/client_without_interceptors.config --list $kafka_acls_principal" 2>/dev/null)
  kafka_rows=$(awk '
    /ResourcePattern\(/ {
      match($0, /resourceType=[^,]*/); type = substr($0, RSTART + 13, RLENGTH - 13)
      match($0, /name=[^,]*/); name = substr($0, RSTART + 5, RLENGTH - 5)
      match($0, /patternType=[^)]*/); pattern = substr($0, RSTART + 12, RLENGTH - 12)
    }
    /\(principal=/ {
      match($0, /principal=[^,]*/); p = substr($0, RSTART + 10, RLENGTH - 10)
      match($0, /host=[^,]*/); host = substr($0, RSTART + 5, RLENGTH - 5)
      match($0, /operation=[^,]*/); op = substr($0, RSTART + 10, RLENGTH - 10)
      match($0, /permissionType=[^)]*/); perm = substr($0, RSTART + 15, RLENGTH - 15)
      printf "%s\t%s\t%s\t%s:%s\t%s\t%s\tkafka-acls\n", p, perm, op, type, name, pattern, host
    }' <<< "$kafka_acls_output")

  rows=$(printf "%s\n%s\n" "$rows" "$kafka_rows" | grep -v '^$' || true)
  # same resource type names as the --resource flag (TOPIC:orders -> Topic:orders)
  rows=$(awk -F'\t' -v OFS='\t' '{ sub(/^TOPIC:/, "Topic:", $4); sub(/^GROUP:/, "Group:", $4); sub(/^CLUSTER:/, "Cluster:", $4); sub(/^TRANSACTIONAL_ID:/, "TransactionalId:", $4); sub(/^DELEGATION_TOKEN:/, "DelegationToken:", $4); print }' <<< "$rows")
  if [[ -z "$rows" ]]
  then
    logwarn "no ACL found"
    exit 0
  fi

  {
    printf "PRINCIPAL\tPERMISSION\tOPERATION\tRESOURCE\tPATTERN\tHOST\tSTORE\n"
    echo "$rows"
  } | column -t -s $'\t'

}

# :command.function
playground_connector_plugin_search_jar_command() {

  # src/commands/connector-plugin/search-jar.sh
  connector_plugin="${args[--connector-plugin]}"
  connector_tag="${args[--connector-tag]}"
  class="${args[--class]}"

  if [[ $connector_plugin == *"@"* ]]
  then
    connector_plugin=$(echo "$connector_plugin" | cut -d "@" -f 2)
  fi

  if [[ -n "$connector_tag" ]]
  then
      if [ "$connector_tag" == " " ]
      then
          ret=$(choose_connector_tag "$connector_plugin")
          connector_tag=$(echo "$ret" | cut -d ' ' -f 2 | sed 's/^v//')
      fi
  else
      connector_tag="latest"
  fi

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  get_connect_image
  log "🔌 Downloading connector plugin $connector_plugin:$connector_tag"
  docker run -u0 -i --rm -v $tmp_dir:/usr/share/confluent-hub-components ${CP_CONNECT_IMAGE}:${CP_CONNECT_TAG} bash -c "confluent-hub install --no-prompt $connector_plugin:$connector_tag && chown -R $(id -u $USER):$(id -g $USER) /usr/share/confluent-hub-components" | grep "Downloading"

  log "🤎 Listing jar files"
  cd $tmp_dir/*/lib
  ls -1 | sort

  if [[ -n "$class" ]]
  then
    log "Searching for java class $class in all jars"
    find . -name '*.jar' -print | while read i;

    do

      set +e
      jar -tvf "$i" | grep -Hsi ${class} | awk '{print $10}' | sed 's/\.class$//' | tr '/' '.' | while read j
      do
        if [ $? -eq 0 ]
        then
          if [ "$j" != "" ]
          then
            log "👉 method signatures from $i jar for class $j"
            javap -classpath $i $j
          fi
        fi
      done
    done
  fi
}

# :command.function
playground_connector_plugin_versions_command() {

  # src/commands/connector-plugin/versions.sh
  connector_plugin="${args[--connector-plugin]}"
  last="${args[--last]}"
  force_refresh="${args[--force-refresh]}"
  with_changelog="${args[--with-changelog]}"

  if [[ $connector_plugin == *"@"* ]]
  then
    connector_plugin=$(echo "$connector_plugin" | cut -d "@" -f 2)
  fi

  owner=$(echo "$connector_plugin" | cut -d "/" -f 1)
  name=$(echo "$connector_plugin" | cut -d "/" -f 2)

  filename="/tmp/version_${owner}_${name}"
  if [[ -n "$force_refresh" ]]
  then
      if [ -f $filename ]
      then
          rm -f $filename
      fi
  fi

  if [[ -n "$last" ]]
  then
      if [ "$last" != "1" ]
      then
          log "💯 Listing last $last versions for connector plugin $connector_plugin"
      fi
  else
      log "💯 Listing all versions for connector plugin $connector_plugin"
  fi

  if [ ! -f $filename ]
  then
      curl_output=$(curl -s https://api.hub.confluent.io/api/plugins/$owner/$name/versions)
      ret=$?
      set -e
      if [ $ret -eq 0 ]
      then
          if ! echo "$curl_output" | jq -e .  > /dev/null 2>&1
          then
              set +e
              json_file=/tmp/json
              echo "$curl_output" > $json_file
              jq_output=$(jq . "$json_file" 2>&1)
              error_line=$(echo "$jq_output" | grep -oE 'parse error.*at line [0-9]+' | grep -oE '[0-9]+')

              if [[ -n "$error_line" ]]; then
                  logerror "❌ Invalid JSON at line $error_line"
              fi
              set -e

              if [ -z "$GITHUB_RUN_NUMBER" ]
              then
                  if [[ $(type -f bat 2>&1) =~ "not found" ]]
                  then
                      cat -n $json_file
                  else
                      bat $json_file --highlight-line $error_line
                  fi
              fi
              exit 1
          fi

          if [ "$curl_output" == "[]" ]
          then
              logwarn "❌ could not get versions for connector plugin $connector_plugin"
              exit 0
          fi

          if [[ "$(uname)" == "Darwin" ]]; then
              # macOS
              current_date=$(date -j -f "%Y-%m-%d" "$(date "+%Y-%m-%d")" "+%s")
          else
              # Linux
              current_date=$(date +%s)
          fi
          while IFS= read -r row; do
              IFS=$'\n'
              arr=($(echo "$row" | jq -r '.version, .manifest_url, .release_date'))
              version="${arr[0]}"
              manifest_url="${arr[1]}"
              release_date="${arr[2]}"
              if [ "$release_date" != "null" ]
              then
                  if [[ "$(uname)" == "Darwin" ]]; then
                      # macOS
                      release_date_sec=$(date -j -f "%Y-%m-%d" "$release_date" "+%s")
                  else
                      # Linux
                      release_date_sec=$(date -d "$release_date" "+%s")
                  fi

                  # Calculate the difference in days
                  diff=$(( (current_date - release_date_sec) / 60 / 60 / 24 ))
                  echo "🔢 v$version - 📅 release date: $release_date ($diff days ago)" >> $filename
              else
                  echo "🔢 v$version - 📅 release date: <unknown>" >> $filename
              fi
          done <<< "$(echo "$curl_output" | jq -c '.[]')"

          # documentation_url
          set +e
          curl_output=$(curl -s $manifest_url)
          ret=$?
          if [ $ret -eq 0 ]
          then
              documentation_url=$(echo "$curl_output" | jq -r '.documentation_url')
          fi
          set -e
          if [[ -n "$documentation_url" && "$documentation_url" != "null" ]]
          then
              echo "🌐 documentation: $documentation_url" >> $filename
          else
              echo "🌐 documentation: <not available>" >> $filename
          fi
      else
          logerror "❌ curl request failed with error code $ret!"
          exit 1
      fi

      if [ ! -f $filename ]
      then
          logerror "❌ could not get versions for connector plugin $connector_plugin"
          exit 1
      fi
  fi

  if [[ -n "$last" ]]
  then
      last=$((last + 1))
      versions_output=$(tail -${last} $filename)
  else
      versions_output=$(cat $filename)
  fi

  if [[ -z "$with_changelog" ]]
  then
      echo "$versions_output"
      exit 0
  fi

  # release notes under each version, from the docs.confluent.io changelog feeds (see connector-plugin changelog)
  first_version=$(echo "$versions_output" | grep "🔢 v" | head -1 | sed -E 's/^🔢 v([^ ]+) .*/\1/')
  changelog_json=$(mktemp -t pg-XXXXXXXXXX)
  trap 'rm -f $changelog_json' EXIT
  changelog_args=(--connector-plugin "$owner/$name" --from "$first_version" --include-from)
  [[ -n "$force_refresh" ]] && changelog_args+=(--force-refresh)
  if ! command -v python3 > /dev/null 2>&1 || ! python3 -I "$root_folder/tools/connector-changelog/changelog.py" "${changelog_args[@]}" > $changelog_json 2> /dev/null || [ "$(jq '.feeds | length' $changelog_json)" == "0" ]
  then
      logwarn "📜 no changelog feed for connector plugin $owner/$name, release notes are not shown"
      echo "$versions_output"
      exit 0
  fi
  while IFS= read -r line
  do
      echo "$line"
      if [[ "$line" == "🔢 v"* ]]
      then
          version=$(echo "$line" | sed -E 's/^🔢 v([^ ]+) .*/\1/')
          jq -r --arg v "$version" '.versions[] | select(.version == $v) | .changes[] | "   • \(.)"' $changelog_json
      fi
  done <<< "$versions_output"
  jq -r '.feeds[] | "📜 changelog: \(sub("\\.xml$"; ".html"))"' $changelog_json
}

# :command.function
playground_connector_plugin_changelog_command() {

  # src/commands/connector-plugin/changelog.sh
  connector_plugin="${args[--connector-plugin]}"
  from="${args[--from]}"
  to="${args[--to]}"
  grep="${args[--grep]}"
  json="${args[--json]}"
  force_refresh="${args[--force-refresh]}"

  if [[ $connector_plugin == *"@"* ]]
  then
    connector_plugin=$(echo "$connector_plugin" | cut -d "@" -f 2)
  fi

  if ! command -v python3 > /dev/null 2>&1
  then
      logerror "❌ python3 is required"
      exit 1
  fi

  changelog_args=(--connector-plugin "$connector_plugin")
  [[ -n "$from" ]] && changelog_args+=(--from "$from")
  [[ -n "$to" ]] && changelog_args+=(--to "$to")
  [[ -n "$grep" ]] && changelog_args+=(--grep "$grep")
  [[ -n "$force_refresh" ]] && changelog_args+=(--force-refresh)

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  trap 'rm -rf $tmp_dir' EXIT

  if ! python3 -I "$root_folder/tools/connector-changelog/changelog.py" "${changelog_args[@]}" > $tmp_dir/changelog.json 2> $tmp_dir/stderr
  then
      logerror "$(cat $tmp_dir/stderr)"
      exit 1
  fi
  while IFS= read -r line
  do
      [[ -n "$line" ]] && logwarn "$line"
  done < $tmp_dir/stderr

  if [[ -n "$json" ]]
  then
      cat $tmp_dir/changelog.json
      exit 0
  fi

  to=$(jq -r '.to' $tmp_dir/changelog.json)
  nb_feeds=$(jq '.feeds | length' $tmp_dir/changelog.json)
  nb_versions=$(jq '.versions | length' $tmp_dir/changelog.json)

  if [ "$(jq -r '.up_to_date' $tmp_dir/changelog.json)" == "true" ]
  then
      log "✅ $from is the latest version of $connector_plugin on Confluent Hub ($to), nothing newer"
      exit 0
  fi

  if [ "$nb_feeds" == "0" ]
  then
      log "📜 no release notes found for $connector_plugin, check the documentation: $(jq -r '.documentation_url' $tmp_dir/changelog.json)"
      exit 0
  fi

  if [[ -n "$from" ]]
  then
      range="after $from up to $to"
  else
      range="of the $(echo "$to" | cut -d "." -f 1-2) line up to $to"
  fi
  if [[ -n "$grep" ]]
  then
      log "📜 Release notes of $connector_plugin $range matching \"$grep\": $nb_versions version(s)"
  else
      log "📜 Release notes of $connector_plugin $range: $nb_versions version(s)"
  fi

  if [ "$nb_versions" == "0" ]
  then
      log "🤷 no matching change"
  else
      jq -r '.versions[] |
        "🔢 v\(.version) - 📅 release date: \(.release_date // "<unknown>")",
        (.changes[] | "   • \(.)")' $tmp_dir/changelog.json
  fi
  jq -r '.feeds[] | "🌐 changelog: \(sub("\\.xml$"; ".html"))"' $tmp_dir/changelog.json

}

