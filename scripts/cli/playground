    # :flag.usage
    printf "  %s\n" "$(magenta "--output-dir, -o OUTPUT_DIR")"
    printf "    📂 Folder for the trace and its HTML report, used by --action stop (default:\n    current folder)\n"
    printf "    %s\n" "Default: ."
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-analyze")"
    printf "    🙈 With --action stop, only copy the trace, do not analyze it\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground debug jscissors --class io.confluent.connect.jdbc.sink.JdbcDbWriter\n  --method write --action start\n"
    printf "  playground debug jscissors --action stop\n"
    printf "  playground debug jscissors --action status\n"
    printf "  playground debug jscissors --class 'io.confluent.connect.jdbc.sink.*'\n  --duration 60s\n"
