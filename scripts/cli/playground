# :command.function
playground_cp_changelog_command() {

  # src/commands/cp-changelog.sh
  from="${args[--from]}"
  to="${args[--to]}"
  grep="${args[--grep]}"
  security="${args[--security]}"
  json="${args[--json]}"
  force_refresh="${args[--force-refresh]}"
  eval "components=(${args[--component]})"

  if ! command -v python3 > /dev/null 2>&1
  then
      logerror "❌ python3 is required"
      exit 1
  fi

  # the fzf completion of --from/--to returns "<query>@8.3.0 - already installed 💻"
  from=${from#*@}
  from=${from%% *}
  to=${to#*@}
  to=${to%% *}

  changelog_args=()
  [[ -n "$from" ]] && changelog_args+=(--from "$from")
  [[ -n "$to" ]] && changelog_args+=(--to "$to")
  [[ -n "$grep" ]] && changelog_args+=(--grep "$grep")
  [[ -n "$security" ]] && changelog_args+=(--security)
  [[ -n "$force_refresh" ]] && changelog_args+=(--force-refresh)
  for component in "${components[@]}"
  do
      changelog_args+=(--component "$component")
  done

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  trap 'rm -rf $tmp_dir' EXIT

  if ! python3 -I "$root_folder/tools/cp-changelog/cp_changelog.py" "${changelog_args[@]}" > $tmp_dir/changelog.json 2> $tmp_dir/stderr
  then
      logerror "$(cat $tmp_dir/stderr)"
      exit 1
  fi
  while IFS= read -r line
  do
      [[ -n "$line" ]] && logwarn "$line"
  done < $tmp_dir/stderr

  if [[ -n "$json" ]]
  then
      cat $tmp_dir/changelog.json
      exit 0
  fi

  to=$(jq -r '.to // empty' $tmp_dir/changelog.json)
  nb_feeds=$(jq '.feeds | length' $tmp_dir/changelog.json)
  nb_versions=$(jq '.versions | length' $tmp_dir/changelog.json)
  nb_changes=$(jq '[.versions[].changes | length] | add // 0' $tmp_dir/changelog.json)

  if [ "$(jq -r '.up_to_date' $tmp_dir/changelog.json)" == "true" ]
  then
      log "✅ $from is the latest Confluent Platform version with a changelog ($(jq -r '.latest' $tmp_dir/changelog.json)), nothing newer"
      exit 0
  fi

  if [ "$nb_feeds" == "0" ]
  then
      log "📜 no changelog feed found (they exist from Confluent Platform 7.4 onwards), check https://docs.confluent.io/platform/current/release-notes/changelog.html"
      exit 0
  fi

  if [[ -n "$from" ]]
  then
      range="after $from up to $to"
  else
      range="of the $(echo "$to" | cut -d "." -f 1-2) line up to $to"
  fi
  filters=""
  if [ ${#components[@]} -gt 0 ]
  then
      filters=" in ${components[*]}"
  fi
  if [[ -n "$security" ]]
  then
      filters="$filters, security related"
  elif [[ -n "$grep" ]]
  then
      filters="$filters matching \"$grep\""
  fi
  log "📜 Changes of Confluent Platform $range$filters: $nb_changes change(s) in $nb_versions version(s)"

  if [ "$nb_versions" == "0" ]
  then
      log "🤷 no matching change"
  else
      jq -r '.versions[] |
        "🔢 \(.version) - 📅 released: \(.released // "<unknown>") - \(.changes | length) change(s)",
        (.changes | group_by(.component) | .[] |
          "  🧩 \(.[0].component) (\(length))",
          (.[] | "     • \(if .security then "🔐 " else "" end)\(.title)\(if .commit != "" and .commit != null then " (\(.commit))" else "" end)"))' $tmp_dir/changelog.json
  fi
  jq -r '.feeds[] | "🌐 changelog: \(sub("\\.xml$"; ".html"))"' $tmp_dir/changelog.json
  log "⚠️ only the community components are covered (Common, Kafka, ksqlDB, REST Proxy, Schema Registry), not Confluent Server or Control Center"

}

# :command.function
playground_cleanup_cloud_resources_command() {

  # src/commands/cleanup-cloud-resources.sh
  user="${args[--user]}"
  force="${args[--force]}"
  # Convert the space delimited string to an array
  eval "resources=(${args[--resource]})"
  recorded_topics_only="${args[--recorded-topics-only]}"

  if [[ -n "$recorded_topics_only" ]]
  then
      cleanup_ccloud_recorded_topics
      exit 0
  fi

  set +e
  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  if [[ ! -n "$user" ]]
  then
      user="${USER}"
  fi

  function cleanup_aws () {
      if [ ! -f $HOME/.aws/credentials ] && ( [ -z "$AWS_ACCESS_KEY_ID" ] || [ -z "$AWS_SECRET_ACCESS_KEY" ] )
      then
          logerror "❌ either the file $HOME/.aws/credentials is not present or environment variables AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are not set!"
          exit 1
      else
          if [ ! -z "$AWS_ACCESS_KEY_ID" ] && [ ! -z "$AWS_SECRET_ACCESS_KEY" ]
          then
              log "💭 Using environment variables AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY"
              export AWS_ACCESS_KEY_ID
              export AWS_SECRET_ACCESS_KEY
          else
              if [ -f $HOME/.aws/credentials ]
              then
                  logwarn "💭 AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set based on $HOME/.aws/credentials"
                  export AWS_ACCESS_KEY_ID=$( grep "^aws_access_key_id" $HOME/.aws/credentials | head -1 | awk -F'=' '{print $2;}' )
                  export AWS_SECRET_ACCESS_KEY=$( grep "^aws_secret_access_key" $HOME/.aws/credentials | head -1 | awk -F'=' '{print $2;}' )

              fi
          fi
          if [ -z "$AWS_REGION" ]
          then
              AWS_REGION=$(aws configure get region | tr '\r' '\n')
              if [ "$AWS_REGION" == "" ]
              then
                  logerror "❌ either the file $HOME/.aws/config is not present or environment variables AWS_REGION is not set!"
                  exit 1
              fi
          fi
      fi

      log "Cleanup AWS Kinesis streams"
      for stream in $(aws kinesis list-streams --region $AWS_REGION | jq '.StreamNames[]' -r)
      do
          if [[ $stream = *pg*${user}* ]]
          then
              log "Removing AWS Kinesis stream $stream"
              check_if_skip "aws kinesis delete-stream --stream-name $stream --region $AWS_REGION"
          fi
      done

      log "Cleanup AWS SQS queues"
      for queue in $(aws sqs list-queues --region $AWS_REGION | jq '.QueueUrls[]' -r)
      do
          if [[ $queue = *pg*${user}* ]]
          then
              log "Removing AWS SQS queue $queue"
              check_if_skip "aws sqs delete-queue --queue-url ${queue}"
          fi
      done

      log "Cleanup AWS Lambda functions"
      for function in $(aws lambda list-functions --region $AWS_REGION | jq '.Functions[].FunctionName' -r)
      do
          if [[ $function = *pglambdafunction* ]] || [[ $function = *pg*${user}* ]]
          then
              log "Removing AWS Lambda function $function"
              check_if_skip "aws lambda delete-function --function-name ${function}"
          fi
      done

      log "Cleanup AWS Lambda IAM roles"
      for role in $(aws iam list-roles --region $AWS_REGION | jq '.Roles[].RoleName' -r)
      do
          if [[ $role = *pglambdarole* ]] || [[ $role = *pg*${user}* ]]
          then
              log "Removing AWS Lambda role $role"
              check_if_skip "aws iam delete-role --role-name ${role}"
          fi
      done

      log "Cleanup AWS CloudWatch log group"
      for log_group in $(aws logs describe-log-groups --region $AWS_REGION | jq '.logGroups[].logGroupName' -r)
      do
          if [[ $log_group = *myloggroup* ]] || [[ $log_group = *pg*${user}* ]]
          then
              # for log_stream in $(aws logs describe-log-streams --log-group-name $log_group --region $AWS_REGION | jq '.logStreams[].logStreamName' -r)
              # do
              #     log "Removing AWS CloudWatch log stream $log_stream for log group $log_group"
              #     check_if_skip "aws logs delete-log-stream --log-group-name ${log_group} --log-stream-name \"${log_stream}\""
              # done

              log "Removing AWS CloudWatch log group $log_group"
              check_if_skip "aws logs delete-log-group --log-group-name ${log_group}"
          fi
      done

      log "Cleanup AWS Redshift clusters"
      for cluster in $(aws redshift describe-clusters --region $AWS_REGION | jq '.Clusters[].ClusterIdentifier' -r)
      do
          if [[ $cluster = pg*${user}redshift* ]] || [[ $cluster = pg*${user}jdbcredshift* ]]
          then
              log "Delete AWS Redshift $cluster"
              check_if_skip "aws redshift delete-cluster --cluster-identifier $cluster --skip-final-cluster-snapshot --region $AWS_REGION"
              sleep 60
              log "Delete AWS security group sg$cluster"
              check_if_skip "aws ec2 delete-security-group --group-name sg$cluster --region $AWS_REGION"
          fi
      done

      log "Cleanup AWS DynamoDB tables"
      for dynamo_table in $(aws dynamodb list-tables --region $AWS_REGION | jq '.TableNames[]' -r)
      do
          if [[ $dynamo_table = *pg*${user}* ]]
          then
              log "Removing AWS dynamodb table $dynamo_table"
              check_if_skip "aws dynamodb delete-table --table-name ${dynamo_table}"
          fi
      done
  }

  function cleanup_azure () {
      login_and_maybe_set_azure_subscription

      log "Cleanup Azure Resource groups"
      for group in $(az group list --query '[].name' --output tsv)
      do
      if [[ $group = pg*${user}* ]]
      then
          if [ ! -z "$GITHUB_RUN_NUMBER" ]
          then
          job=$(echo $GITHUB_RUN_NUMBER | cut -d "." -f 1)
          if [[ $group = pg$user$job* ]]
          then
              log "Skipping current github actions $job"
              continue
          fi
          fi
          log "Deleting Azure resource group $group"
          check_if_skip "az group delete --name $group --yes --no-wait"
      fi
      done
  }

  function cleanup_gcp () {
      GCP_KEYFILE="$tmp_dir/keyfile.json"
      echo -e "$GCP_KEYFILE_CONTENT" | sed 's/\\"/"/g' > ${GCP_KEYFILE}
      docker rm -f gcloud-config-cleanup-resources > /dev/null 2>&1
      docker run -i -v ${GCP_KEYFILE}:/tmp/keyfile.json --name gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud auth activate-service-account --project ${GCP_PROJECT} --key-file /tmp/keyfile.json > /dev/null 2>&1

      log "Cleanup GCP GCS buckets"
      for bucket in $(docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gsutil ls)
      do
          if [[ $bucket = *kafkadockerplaygroundbucket${user}* ]]
          then
              log "Removing GCS bucket $bucket"
              check_if_skip "docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gsutil -m rm -r $bucket"
          fi
      done

      log "Cleanup GCP BQ datasets"
      for dataset in $(docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest bq --project_id "$GCP_PROJECT" ls)
      do
          if [[ $dataset = *pg*${user}* ]]
          then
              log "Remove GCP BQ dataset $dataset"
              check_if_skip "docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest bq --project_id \"$GCP_PROJECT\" rm -r -f -d \"$dataset\""
          fi
      done

      log "Cleanup Spanner instances"
      for spanner_instance in $(docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud spanner instances list --project $GCP_PROJECT --format="value(NAME)")
      do
          if [[ $spanner_instance = *pg*${user}* ]]
          then

  #             for spanner_db in $(docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud spanner databases list --project $GCP_PROJECT --instance $spanner_instance --format="value(NAME)")
  #             do
  #                 log "Remove Spanner database $spanner_db"
  #                 docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud spanner databases delete $spanner_db --instance $spanner_instance --project $GCP_PROJECT << EOF
# Y
# EOF
#             done

            for spanner_backup in $(docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud spanner backups list --project $GCP_PROJECT --instance $spanner_instance --format="value(NAME)")
            do
                log "Remove Spanner backup $spanner_backup"
                docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud spanner backups delete $spanner_backup --instance $spanner_instance --project $GCP_PROJECT << EOF
Y
EOF
              done

              log "Remove Spanner instance $spanner_instance"
              docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud spanner instances delete $spanner_instance --project $GCP_PROJECT << EOF
Y
EOF
          fi
      done

      log "Cleanup BigTable instances"
      for bigtable_instance in $(docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud bigtable instances list --project $GCP_PROJECT --format="value(NAME)")
      do
          if [[ $bigtable_instance = *pg*${user}* ]]
          then
              log "Remove BigTable instance $bigtable_instance"
              docker run -i --volumes-from gcloud-config-cleanup-resources google/cloud-sdk:latest gcloud bigtable instances delete $bigtable_instance --project $GCP_PROJECT << EOF
Y
EOF
          fi
      done
  }

  function cleanup_ccloud () {
      cleanup_confluent_cloud_resources

      if [ ! -z "$AWS_DATABRICKS_CLUSTER_NAME" ]
      then
          log "AWS_DATABRICKS_CLUSTER_NAME environment variable is set, forcing the cluster $AWS_DATABRICKS_CLUSTER_NAME to be used !"
          export CLUSTER_NAME=$AWS_DATABRICKS_CLUSTER_NAME
          export CLUSTER_REGION=$AWS_DATABRICKS_CLUSTER_REGION
          export CLUSTER_CLOUD=$AWS_DATABRICKS_CLUSTER_CLOUD
          export CLUSTER_CREDS=$AWS_DATABRICKS_CLUSTER_CREDS

          cleanup_confluent_cloud_resources
      fi

      if [ ! -z "$AWS_CLUSTER_NAME" ]
      then
          log "AWS_CLUSTER_NAME environment variable is set, forcing the cluster $AWS_CLUSTER_NAME to be used !"
          export CLUSTER_NAME=$AWS_CLUSTER_NAME
          export CLUSTER_REGION=$AWS_CLUSTER_REGION
          export CLUSTER_CLOUD=$AWS_CLUSTER_CLOUD
          export CLUSTER_CREDS=$AWS_CLUSTER_CREDS

          cleanup_confluent_cloud_resources
      fi

      if [ ! -z "$GCP_CLUSTER_NAME" ]
      then
          log "GCP_CLUSTER_NAME environment variable is set, forcing the cluster $GCP_CLUSTER_NAME to be used !"
          export CLUSTER_NAME=$GCP_CLUSTER_NAME
          export CLUSTER_REGION=$GCP_CLUSTER_REGION
          export CLUSTER_CLOUD=$GCP_CLUSTER_CLOUD
          export CLUSTER_CREDS=$GCP_CLUSTER_CREDS

          cleanup_confluent_cloud_resources
      fi

      if [ ! -z "$AZURE_CLUSTER_NAME" ]
      then
          log "AZURE_CLUSTER_NAME environment variable is set, forcing the cluster $AZURE_CLUSTER_NAME to be used !"
          export CLUSTER_NAME=$AZURE_CLUSTER_NAME
          export CLUSTER_REGION=$AZURE_CLUSTER_REGION
          export CLUSTER_CLOUD=$AZURE_CLUSTER_CLOUD
          export CLUSTER_CREDS=$AZURE_CLUSTER_CREDS

          cleanup_confluent_cloud_resources
      fi
  }

  # Run sfdx commands against one org in a one-shot sfdx-cli container, logged in with the
  # OAuth JWT bearer flow - the same External Client App, certificate and user the Salesforce
  # connectors use. The connector keystore is mounted read-only and converted to the PEM key
  # sfdx needs with the image's own openssl, so the key never lands on the host.
  #
  # Replaces `sfdx sfpowerkit:auth:login` (username + password + security token), whose SOAP
  # login() Salesforce blocks by default on orgs created Summer '26 or later and retires with
  # Summer '27. stdin is passed through, for `sfdx apex run` fed from a heredoc.
  function salesforce_sfdx_run_as () {
      local username="$1" consumer_key="$2" instance="$3" commands="$4"

      docker run -i --rm -v "$SALESFORCE_JWT_KEYSTORE:/tmp/salesforce-confluent.keystore.jks:ro" vdesabou/sfdx-cli:latest sh -c "openssl pkcs12 -in /tmp/salesforce-confluent.keystore.jks -nocerts -nodes -passin pass:confluent -out /tmp/salesforce-confluent.key && sfdx auth:jwt:grant --username \"$username\" --client-id \"$consumer_key\" --jwt-key-file /tmp/salesforce-confluent.key --instance-url \"$instance\" && $commands"
  }

  function cleanup_salesforce_org () {
      local username="$1" consumer_key="$2" instance="$3"

      if [ -z "$consumer_key" ]
      then
          logwarn "⚠️ no JWT consumer key set for $username, skipping Salesforce cleanup for this account"
          return
      fi

      log "Cleanup Salesforce Leads on account with $username"
      salesforce_sfdx_run_as "$username" "$consumer_key" "$instance" "sfdx data:query --target-org \"$username\" -q \"SELECT Id FROM Lead\" --result-format csv > /tmp/out.csv && sfdx force:data:bulk:delete --target-org \"$username\" -s Lead -f /tmp/out.csv"

      log "Cleanup Salesforce Contacts on account with $username"
      salesforce_sfdx_run_as "$username" "$consumer_key" "$instance" "sfdx data:query --target-org \"$username\" -q \"SELECT Id FROM Contact\" --result-format csv > /tmp/out.csv && sfdx force:data:bulk:delete --target-org \"$username\" -s Contact -f /tmp/out.csv"

      log "Cleanup PushTopics on account with $username"
      salesforce_sfdx_run_as "$username" "$consumer_key" "$instance" "sfdx apex run --target-org \"$username\"" << EOF
List<PushTopic> pts = [SELECT Id FROM PushTopic];
Database.delete(pts);
EOF
  }

  function cleanup_salesforce () {
      local keystore_dir=""

      if [ -z "$SALESFORCE_USERNAME" ] && [ -z "$SALESFORCE_USERNAME_ACCOUNT2" ]
      then
          return
      fi

      # Same keystore every Salesforce example mounts into connect for the JWT_BEARER grant.
      keystore_dir=$(mktemp -d)
      (cd "$keystore_dir" && get_3rdparty_file "salesforce-confluent.keystore.jks")
      SALESFORCE_JWT_KEYSTORE="$keystore_dir/salesforce-confluent.keystore.jks"
      if [ ! -f "$SALESFORCE_JWT_KEYSTORE" ]
      then
          logerror "❌ could not fetch salesforce-confluent.keystore.jks, skipping Salesforce cleanup"
          return
      fi

      if [ ! -z "$SALESFORCE_USERNAME" ]
      then
          cleanup_salesforce_org "$SALESFORCE_USERNAME" "$SALESFORCE_CONSUMER_KEY_WITH_JWT" "${SALESFORCE_INSTANCE:-https://login.salesforce.com}"
      fi

      if [ ! -z "$SALESFORCE_USERNAME_ACCOUNT2" ]
      then
          cleanup_salesforce_org "$SALESFORCE_USERNAME_ACCOUNT2" "$SALESFORCE_CONSUMER_KEY_WITH_JWT_ACCOUNT2" "${SALESFORCE_INSTANCE_ACCOUNT2:-https://login.salesforce.com}"
      fi

      rm -rf "$keystore_dir"
  }

  for resource in "${resources[@]}"
  do
      case "${resource}" in

          "aws")
              cleanup_aws
          ;;
          "gcp")
              cleanup_gcp
          ;;
          "azure")
              cleanup_azure
          ;;
          "ccloud")
              cleanup_ccloud
          ;;
          "salesforce")
              cleanup_salesforce
          ;;
          *)
              logerror "default (none of above)"
          ;;
      esac
  done

  # always exit with success
  exit 0

}

# :command.function
playground_repro_export_command() {

  # src/commands/repro/export.sh
  eval "files=(${args[--file]:-})"
  all_uncommitted="${args[--all-uncommitted]}${args[--all]}"
  output="${args[--output]}"
  dry_run="${args[--dry-run]}"
  force="${args[--force]}"
  include_artifacts="${args[--include-artifacts]}"
  no_clipboard="${args[--no-clipboard]}"

  if [ ! -z "$OUTPUT_FOLDER" ]
  then
    output_folder="$OUTPUT_FOLDER"
  else
    output_folder="reproduction-models"
  fi

  if [ "$output_folder" != "reproduction-models" ]
  then
      logerror "❌ OUTPUT_FOLDER $output_folder is not set with reproduction-models, this is the only supported value !"
      exit 1
  fi

  if [ ! -d "$root_folder/$output_folder" ]
  then
      logerror "❌ folder $root_folder/$output_folder does not exist"
      exit 1
  fi
  repro_root=$(cd -P "$root_folder/$output_folder" && pwd)

  # 1. the models to export
  declare -a scripts=()
  declare -a extra_files=()
  if [[ -n "$all_uncommitted" ]]
  then
      if [ ! -e "$repro_root/.git" ]
      then
          logerror "❌ --all-uncommitted needs $repro_root to be a git repository"
          exit 1
      fi
      # untracked and modified files, untracked folders expanded, deleted files left out
      while IFS= read -r line
      do
          status="${line:0:2}"
          path="${line:3}"
          path="${path##* -> }"
          if [[ "$status" == *D* ]] || [ ! -e "$repro_root/$path" ] || [ -d "$repro_root/$path" ] || [[ "$path" != */* ]]
          then
              continue
          fi
          if git -C "$repro_root" check-ignore -q "$path" 2>/dev/null || repro_bundle_denied "${path#*/}"
          then
              continue
          fi
          case "$path" in
              */stop.sh) extra_files+=("$path") ;;
              */*/*) extra_files+=("$path") ;;
              *.sh) scripts+=("$repro_root/$path") ;;
              *) extra_files+=("$path") ;;
          esac
      done < <(git -C "$repro_root" status --porcelain --untracked-files=all 2>/dev/null)

      if [ ${#scripts[@]} -eq 0 ] && [ ${#extra_files[@]} -eq 0 ]
      then
          logerror "❌ No uncommitted reproduction model found in $repro_root"
          exit 1
      fi
  elif [ ${#files[@]} -eq 0 ]
  then
      test_file=$(playground state get run.test_file)
      if [ -z "$test_file" ] || [ ! -f "$test_file" ]
      then
          logerror "❌ No current reproduction model (run.test_file is <$test_file>), use --file to say which one to export"
          exit 1
      fi
      scripts=("$test_file")
  else
      for file in "${files[@]}"
      do
          if [[ $file == *"@"* ]]
          then
              file=$(echo "$file" | cut -d "@" -f 2)
          fi
          scripts+=("$file")
      done
  fi

  # every model must be a script directly in a folder of reproduction-models
  declare -a model_scripts=()
  for script in "${scripts[@]}"
  do
      script_dir=$(cd -P "$(dirname "$script")" 2>/dev/null && pwd)
      if [ "$(dirname "$script_dir")" != "$repro_root" ]
      then
          logerror "❌ $script is not a reproduction model of $repro_root, only those can be exported"
          exit 1
      fi
      model_scripts+=("$script_dir/$(basename "$script")")
  done

  # 2. the files of the bundle
  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  for script in "${model_scripts[@]}"
  do
      repro_bundle_files "$script" "$repro_root"
  done > "$tmp_dir/files"
  for file in "${extra_files[@]}"
  do
      echo "$file"
  done >> "$tmp_dir/files"
  sort -u "$tmp_dir/files" -o "$tmp_dir/files"

  if [ ! -s "$tmp_dir/files" ]
  then
      logerror "❌ No file to export"
      exit 1
  fi

  # 3. the manifest
  history_file="$root_folder/playground-run-history"
  : > "$tmp_dir/models.json"
  : > "$tmp_dir/artifacts"
  for script in "${model_scripts[@]}"
  do
      dir_name=$(basename "$(dirname "$script")")
      script_name=$(basename "$script")

      run_line=""
      run_flags=""
      if [ -f "$history_file" ]
      then
          run_line=$(grep -E "^playground run -f [^ ]*/$dir_name/$script_name( |$)" "$history_file" | tail -1)
          run_flags=$(echo "${run_line#playground run -f }" | cut -s -d " " -f 2- | sed -e 's/[[:space:]]*$//')
      fi
      if [ -z "$run_line" ]
      then
          logwarn "🤷 $dir_name/$script_name: no 'playground run' found in playground-run-history, the bundle will not say which flags to use"
      fi

      # the importer runs with their own Confluent Cloud cluster
      stripped_flags=$(sed -E -e 's/--cluster-(schema-registry-)?creds[ =][^ ]+ ?//g' -e 's/[[:space:]]*$//' <<< "$run_flags")
      if [ "$stripped_flags" != "$run_flags" ]
      then
          log "🔐 $dir_name/$script_name: --cluster-creds / --cluster-schema-registry-creds removed from the run line"
          run_flags="$stripped_flags"
      fi

      # files outside the repository: --connector-zip / --connector-jar, and absolute paths in
      # the script or in the compose files it uses
      external_files=$(grep -oE -- "--connector-(zip|jar)=[^ ]+" <<< "$run_flags" | cut -d "=" -f 2- || true)
      {
          for external_file in $external_files
          do
              if [ -f "$external_file" ]
              then
                  printf '%s\t%s\n' "$external_file" "$(cd -P "$(dirname "$external_file")" && pwd)/$(basename "$external_file")"
              fi
          done
          text_files=("$script")
          for file in $(grep -E "^$dir_name/[^/]*\.(yml|yaml)$" "$tmp_dir/files")
          do
              text_files+=("$repro_root/$file")
          done
          repro_external_paths "${text_files[@]}"
      } | sort -u > "$tmp_dir/external"
      while IFS=$'\t' read -r original source
      do
          if [[ -z "$include_artifacts" ]]
          then
              logwarn "📎 $dir_name/$script_name uses $original, which is outside the repository and not in the bundle: use --include-artifacts to add it"
              continue
          fi
          # same file already packed for this model (written differently)?
          artifact=$(awk -F'\t' -v s="$source" -v d="$dir_name/artifacts/" '$2 == s && index($1, d) == 1 { print $1; exit }' "$tmp_dir/artifacts")
          if [ -z "$artifact" ]
          then
              artifact="$dir_name/artifacts/$(basename "$source")"
              n=1
              while grep -q "^$artifact	" "$tmp_dir/artifacts"
              do
                  n=$((n+1))
                  artifact="$dir_name/artifacts/$n-$(basename "$source")"
              done
              if [ $(wc -c < "$source") -gt 52428800 ]
              then
                  logwarn "🐘 $source is larger than 50 MB, the bundle will be big"
              fi
              echo "$artifact" >> "$tmp_dir/files"
          fi
          printf '%s\t%s\t%s\n' "$artifact" "$source" "$original" >> "$tmp_dir/artifacts"
      done < "$tmp_dir/external"

      description=$(repro_header_value "$script" "description")
      case_number=""
      if [[ "$description" =~ ^[0-9]{6} ]]
      then
          case_number="${BASH_REMATCH[0]}"
      fi
      author=$(repro_header_value "$script" "author")

      # the base example is where the symlinks created by bootstrap point to
      base_example=""
      for file in $(grep "^$dir_name/[^/]*$" "$tmp_dir/files")
      do
          if [ -L "$repro_root/$file" ]
          then
              target=$(repro_link_target "$output_folder/$file")
              if [ -n "$target" ] && [[ "$target" != "$output_folder"/* ]]
              then
                  base_example=$(dirname "$target")
                  break
              fi
          fi
      done

      credentials=$(repro_required_credentials "$script")

      jq -n \
          --arg script "$dir_name/$script_name" \
          --arg description "$description" \
          --arg case "$case_number" \
          --arg author "$author" \
          --arg base_example "$base_example" \
          --arg run_flags "$run_flags" \
          --arg credentials "$credentials" \
          --arg external_files "$external_files" \
          '{
              script: $script,
              description: $description,
              case: $case,
              author: $author,
              base_example: $base_example,
              run_flags: $run_flags,
              run_command: ("playground run -f {repro_dir}/" + ($script | split("/") | last) + (if $run_flags == "" then "" else " " + $run_flags end)),
              credentials: ($credentials | split("\n") | map(select(. != ""))),
              external_files: ($external_files | split("\n") | map(select(. != "")))
          }' >> "$tmp_dir/models.json"
  done

  sort -u "$tmp_dir/files" -o "$tmp_dir/files"

  : > "$tmp_dir/files.json"
  while IFS= read -r file
  do
      link_to=""
      if [ -L "$repro_root/$file" ]
      then
          target=$(repro_link_target "$output_folder/$file")
          # only links to the public examples can be restored on import
          if [ -n "$target" ] && [[ "$target" != "$output_folder"/* ]]
          then
              link_to="$target"
          fi
      fi
      jq -n \
          --arg path "$file" \
          --arg sha256 "$(repro_sha256 "$(repro_bundle_source "$repro_root" "$tmp_dir/artifacts" "$file")")" \
          --arg link_to "$link_to" \
          '{ path: $path, sha256: $sha256 } + (if $link_to == "" then {} else { link_to: $link_to } end)' >> "$tmp_dir/files.json"
  done < "$tmp_dir/files"

  playground_commit=$(git -C "$root_folder" rev-parse --short HEAD 2>/dev/null)
  # paths of this checkout, that import rewrites to the importer's (e.g. --custom-smt jar path)
  jq -n \
      --arg exported_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg exported_by "$(whoami)" \
      --arg playground_commit "$playground_commit" \
      --arg repro_roots "$(printf '%s\n%s' "$root_folder/$output_folder" "$repro_root")" \
      --arg root_folders "$(printf '%s\n%s' "$root_folder" "$(cd -P "$root_folder" && pwd)")" \
      --rawfile artifacts "$tmp_dir/artifacts" \
      --slurpfile models "$tmp_dir/models.json" \
      --slurpfile files "$tmp_dir/files.json" \
      '{
          format: 1,
          exported_at: $exported_at,
          exported_by: $exported_by,
          playground_commit: $playground_commit,
          source_repro_roots: ($repro_roots | split("\n") | unique),
          source_root_folders: ($root_folders | split("\n") | unique),
          artifacts: [ $artifacts | split("\n")[] | select(. != "") | split("\t") | { path: .[0], original: .[2] } ],
          models: $models,
          files: $files
      }' > "$tmp_dir/repro-manifest.json"

  # 4. show what goes in
  nb_files=$(wc -l < "$tmp_dir/files" | tr -d ' ')
  log "👷‍♂️ ${#model_scripts[@]} reproduction model(s), $nb_files file(s):"
  jq -r '.models[] | "   🔖 \(.script)\n      ▶️  \(.run_command)" + (if (.credentials | length) > 0 then "\n      🔑 needs: \(.credentials | join(", "))" else "" end)' "$tmp_dir/repro-manifest.json"
  jq -r '.artifacts as $artifacts | .files[] | .path as $path | "   📄 \(.path)" + (if .link_to then "  (symlink to \(.link_to), stored as content)" else "" end) + ([ $artifacts[] | select(.path == $path) | .original ] | if length > 0 then "  (artifact, from \(join(", ")))" else "" end)' "$tmp_dir/repro-manifest.json"

  # 5. secrets and customer data, before anything leaves the machine
  log "🕵️ scanning the bundle for secrets and customer data"
  repro_bundle_scan "$repro_root" "$tmp_dir/files" "$tmp_dir/repro-manifest.json" "$tmp_dir/findings" "$(jq -r '[.models[].base_example | select(. != "")] | unique | join(" ")' "$tmp_dir/repro-manifest.json")" "$tmp_dir/artifacts"
  nb_blocks=$(grep -c "^block" "$tmp_dir/findings" || true)
  nb_warnings=$(grep -c "^warn" "$tmp_dir/findings" || true)
  repro_show_findings "$tmp_dir/findings"
  if [ $nb_warnings -gt 0 ]
  then
      logwarn "👀 $nb_warnings possible customer data finding(s): check them, a bundle must not contain customer data"
  fi
  if [ $nb_blocks -gt 0 ]
  then
      if [[ -n "$force" ]]
      then
          logwarn "🔓 $nb_blocks secret finding(s), exporting anyway as --force is set"
      else
          logerror "❌ $nb_blocks secret finding(s): remove them (use \${VAR} instead of the value), or use --force if they are not real secrets"
          exit 1
      fi
  elif [ $nb_warnings -eq 0 ]
  then
      log "✅ no secret nor customer data found"
  fi

  if [[ -n "$dry_run" ]]
  then
      log "🔍 dry run: no bundle written"
      exit 0
  fi

  # 6. the bundle: symlinks are stored as their content
  staging="$tmp_dir/staging"
  mkdir -p "$staging"
  while IFS= read -r file
  do
      mkdir -p "$staging/$(dirname "$file")"
      cp -pL "$(repro_bundle_source "$repro_root" "$tmp_dir/artifacts" "$file")" "$staging/$file"
  done < "$tmp_dir/files"
  cp "$tmp_dir/repro-manifest.json" "$staging/"

  if [ ${#model_scripts[@]} -eq 1 ]
  then
      bundle_name=$(basename "${model_scripts[0]}" .sh)
  elif [[ -n "$all_uncommitted" ]]
  then
      bundle_name="all-uncommitted"
  else
      bundle_name="${#model_scripts[@]}-models"
  fi

  if [[ -n "$output" ]]
  then
      output_dir="${output/#\~/$HOME}"
  else
      output_dir="$PWD"
      # never inside the submodule: the bundle would end up in the next export
      if [[ "$(cd -P "$output_dir" && pwd)/" == "$repro_root/"* ]]
      then
          output_dir="$root_folder"
      fi
  fi
  mkdir -p "$output_dir"
  output_dir=$(cd "$output_dir" && pwd)
  final_archive="$output_dir/playground_repro_${bundle_name}_$(date +%Y-%m-%d).tgz"

  if ! (cd "$staging" && tar czf "$final_archive" repro-manifest.json $(cut -d "/" -f 1 "$tmp_dir/files" | sort -u))
  then
      logerror "❌ export failed as archive $final_archive could not be created !"
      exit 1
  fi

  log "📤 Exported bundle is available: $final_archive ($(du -h "$final_archive" | cut -f 1 | tr -d ' '))"
  log "📥 To import it: playground repro import -f <path>/$(basename "$final_archive")"

  # the bundle itself (not its path) goes to the clipboard: Cmd+V in Slack, Zendesk or a mail attaches it.
  # Always, unless --no-clipboard: the 'clipboard' config is about the run line and connector configs
  if [[ "$OSTYPE" == "darwin"* ]] && [[ ! -n "$no_clipboard" ]]
  then
      if osascript -e "set the clipboard to (POSIX file \"$final_archive\")" > /dev/null 2>&1
      then
          log "📋 bundle copied to the clipboard as a file: paste it (Cmd+V) in a Slack conversation to attach it (--no-clipboard to skip)"
      else
          logwarn "📋 could not copy the bundle to the clipboard, attach $final_archive by hand"
      fi
  fi

}

# :command.function
playground_repro_check_command() {

  # src/commands/repro/check.sh
  eval "files=(${args[--file]:-})"
  staged="${args[--staged]}"
  all="${args[--all]}"
  skip_secrets_store="${args[--skip-secrets-store]}"
  json="${args[--json]}"

  repro_root="$root_folder/reproduction-models"
  if [ ! -d "$repro_root" ]
  then
      logerror "❌ folder $repro_root does not exist"
      exit 1
  fi
  repro_root=$(cd -P "$repro_root" && pwd)

  if [ ${#files[@]} -eq 0 ] && [ ! -e "$repro_root/.git" ]
  then
      logerror "❌ $repro_root is not a git repository, use --file to say which model to check"
      exit 1
  fi

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi
  : > "$tmp_dir/candidates"
  : > "$tmp_dir/artifacts"

  # 1. the files to check, relative to reproduction-models
  if [[ -n "$staged" ]]
  then
      git -C "$repro_root" diff --cached --name-only --diff-filter=ACMR > "$tmp_dir/candidates"
      what="staged file(s)"
  elif [[ -n "$all" ]]
  then
      git -C "$repro_root" ls-files --cached --others --exclude-standard > "$tmp_dir/candidates"
      what="file(s)"
  elif [ ${#files[@]} -gt 0 ]
  then
      for file in "${files[@]}"
      do
          if [[ $file == *"@"* ]]
          then
              file=$(echo "$file" | cut -d "@" -f 2)
          fi
          script_dir=$(cd -P "$(dirname "$file")" 2>/dev/null && pwd)
          if [ "$(dirname "$script_dir")" != "$repro_root" ]
          then
              # stderr: the output of the loop goes to the candidates file
              logerror "❌ $file is not a reproduction model of $repro_root (a script directly in one of its folders)" >&2
              exit 1
          fi
          repro_bundle_files "$script_dir/$(basename "$file")" "$repro_root"
      done > "$tmp_dir/candidates"
      what="file(s)"
  else
      # new and modified files, untracked folders expanded
      git -C "$repro_root" status --porcelain --untracked-files=all 2>/dev/null | while IFS= read -r line
      do
          status="${line:0:2}"
          path="${line:3}"
          if [[ "$status" != *D* ]]
          then
              echo "${path##* -> }"
          fi
      done > "$tmp_dir/candidates"
      what="uncommitted file(s)"
  fi

  # only the files of the model folders: not the dot folders (.github, .claude…), nor the
  # symlinks to the public examples. Credential files, dumps, logs and archives are findings
  # on their own: export leaves them out, but a commit would not
  : > "$tmp_dir/files"
  : > "$tmp_dir/file-findings"
  while IFS= read -r path
  do
      case "$path" in
          .*|*/.git/*|"") continue ;;
          */*) ;;
          *) continue ;;
      esac
      if [[ -n "$staged" ]]
      then
          mode=$(git -C "$repro_root" ls-files -s -- "$path" | awk '{ print $1; exit }')
          if [ "$mode" == "120000" ]
          then
              continue
          fi
      elif [ -L "$repro_root/$path" ] || [ ! -f "$repro_root/$path" ]
      then
          continue
      fi
      name="${path##*/}"
      case "$name" in
          keyfile.json|*.pem|*.key|*.p12|*.jks|secrets.properties|playground.ini|playground-run-history|.env)
              printf 'block\t%s\t%s\n' "$path" "is a credential file" >> "$tmp_dir/file-findings"
              continue
          ;;
          *.hprof|*.hprof.gz|*.jfr|*.log|*.tgz|*.tar.gz|*.zip)
              printf 'warn\t%s\t%s\n' "$path" "is a dump, log or archive: it may hold customer data" >> "$tmp_dir/file-findings"
              continue
          ;;
          repro-manifest.json|.DS_Store)
              continue
          ;;
      esac
      echo "$path" >> "$tmp_dir/files"
      if [[ -n "$staged" ]]
      then
          # what is committed is the staged content, not the working tree
          mkdir -p "$tmp_dir/index/$(dirname "$path")"
          git -C "$repro_root" show ":$path" > "$tmp_dir/index/$path" 2>/dev/null
          printf '%s\t%s\t%s\n' "$path" "$tmp_dir/index/$path" "$path" >> "$tmp_dir/artifacts"
      fi
  done < <(sort -u "$tmp_dir/candidates")

  nb_files=$(wc -l < "$tmp_dir/files" | tr -d ' ')
  nb_file_findings=$(wc -l < "$tmp_dir/file-findings" | tr -d ' ')
  if [ "$nb_files" -eq 0 ] && [ "$nb_file_findings" -eq 0 ]
  then
      if [[ -n "$json" ]]
      then
          jq -n '{ files: 0, blocks: [], warnings: [] }'
      else
          log "🤷 no $what of a reproduction model to check"
      fi
      exit 0
  fi

  # 2. the scan
  if [[ ! -n "$json" ]]
  then
      log "🕵️ scanning $nb_files $what of reproduction models for secrets and customer data"
  fi
  : > "$tmp_dir/findings"
  if [ "$nb_files" -gt 0 ]
  then
      repro_bundle_scan "$repro_root" "$tmp_dir/files" "" "$tmp_dir/findings" "$(repro_model_base_examples "$repro_root" "$tmp_dir/files")" "$tmp_dir/artifacts" "$skip_secrets_store"
  fi
  cat "$tmp_dir/file-findings" >> "$tmp_dir/findings"
  sort -u "$tmp_dir/findings" | sort -t $'\t' -k1,1 -k2,2V -o "$tmp_dir/findings"

  nb_blocks=$(grep -c "^block" "$tmp_dir/findings" || true)
  nb_warnings=$(grep -c "^warn" "$tmp_dir/findings" || true)

  # 3. the result
  if [[ -n "$json" ]]
  then
      jq -R -s --argjson files "$nb_files" '
          split("\n") | map(select(. != "") | split("\t") | { level: .[0], location: .[1], message: .[2] }) as $findings
          | {
              files: $files,
              blocks: [ $findings[] | select(.level == "block") | { location, message } ],
              warnings: [ $findings[] | select(.level == "warn") | { location, message } ]
            }' "$tmp_dir/findings"
  else
      repro_show_findings "$tmp_dir/findings"
      if [ $nb_warnings -gt 0 ]
      then
          logwarn "👀 $nb_warnings possible customer data finding(s): check them, a reproduction model must not contain customer data"
      fi
      if [ $nb_blocks -gt 0 ]
      then
          logerror "❌ $nb_blocks secret finding(s): remove them (use \${VAR} instead of the value)"
      elif [ $nb_warnings -eq 0 ]
      then
          log "✅ no secret nor customer data found"
      fi
  fi

  if [ $nb_blocks -gt 0 ]
  then
      exit 1
  fi

}

# :command.function
playground_repro_import_command() {

  # src/commands/repro/import.sh
  file="${args[--file]}"
  on_conflict="${args[--on-conflict]}"
  dry_run="${args[--dry-run]}"

  if [ ! -z "$OUTPUT_FOLDER" ]
  then
    output_folder="$OUTPUT_FOLDER"
  else
    output_folder="reproduction-models"
  fi

  if [ "$output_folder" != "reproduction-models" ]
  then
      logerror "❌ OUTPUT_FOLDER $output_folder is not set with reproduction-models, this is the only supported value !"
      exit 1
  fi

  if [[ $file == *"@"* ]]
  then
    file=$(echo "$file" | cut -d "@" -f 2)
  fi
  file=$(cd "$(dirname "$file")" && pwd)/$(basename "$file")

  mkdir -p "$root_folder/$output_folder"
  repro_root=$(cd -P "$root_folder/$output_folder" && pwd)

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  # 1. extract into an empty folder, the bundle is untrusted
  if ! tar tzf "$file" > "$tmp_dir/entries" 2>/dev/null
  then
      logerror "❌ $file is not a tgz file"
      exit 1
  fi
  if grep -qE '^/|(^|/)\.\.(/|$)' "$tmp_dir/entries"
  then
      logerror "❌ $file contains absolute paths or '..', refusing to import it:"
      grep -E '^/|(^|/)\.\.(/|$)' "$tmp_dir/entries" | head -10
      exit 1
  fi

  extract="$tmp_dir/extract"
  mkdir -p "$extract"
  if ! tar xzf "$file" -C "$extract"
  then
      logerror "❌ could not extract $file"
      exit 1
  fi

  special_files=$(cd "$extract" && find . ! -type f ! -type d ! -type l)
  if [ -n "$special_files" ]
  then
      logerror "❌ $file contains special files, refusing to import it:"
      echo "$special_files" | head -10
      exit 1
  fi

  manifest="$extract/repro-manifest.json"
  (cd "$extract" && find . \( -type f -o -type l \) ! -path ./repro-manifest.json | sed -e 's|^\./||' | sort) > "$tmp_dir/files"

  # 2. validate
  if [ -f "$manifest" ]
  then
      if ! jq -e . "$manifest" > /dev/null 2>&1
      then
          logerror "❌ repro-manifest.json of $file is not valid json"
          exit 1
      fi
      format=$(jq -r '.format // 0' "$manifest")
      if [ "$format" != "1" ]
      then
          logerror "❌ bundle format $format is not supported by this version of the playground, update it with 'git pull'"
          exit 1
      fi
      # a bundle has no symlink, they are stored as content
      if [ -n "$(cd "$extract" && find . -type l)" ]
      then
          logerror "❌ $file contains symlinks, refusing to import it"
          exit 1
      fi
      jq -r '.files[].path' "$manifest" | sort > "$tmp_dir/manifest_files"
      if ! diff -q "$tmp_dir/files" "$tmp_dir/manifest_files" > /dev/null
      then
          logerror "❌ the files of $file do not match its manifest, refusing to import it:"
          diff "$tmp_dir/files" "$tmp_dir/manifest_files" | grep '^[<>]' | head -10
          exit 1
      fi
      while IFS=$'\t' read -r path sha256
      do
          if [ "$(repro_sha256 "$extract/$path")" != "$sha256" ]
          then
              logerror "❌ sha256 of $path does not match the manifest, refusing to import it"
              exit 1
          fi
      done < <(jq -r '.files[] | "\(.path)\t\(.sha256)"' "$manifest")
  else
      logwarn "🗃️ legacy bundle without repro-manifest.json: no metadata (run flags, credentials), files are not verified"
      # former export kept the symlinks: only relative ones to a public example are accepted
      while IFS= read -r path
      do
          if [ -L "$extract/$path" ]
          then
              target=$(readlink "$extract/$path")
              normalized=""
              if [[ "$target" != /* ]]
              then
                  normalized=$(repro_normalize_path "$output_folder/$(dirname "$path")/$target")
              fi
              if [ -z "$normalized" ] || [[ "$normalized" == "$output_folder"/* ]] || [ ! -e "$root_folder/$normalized" ]
              then
                  logerror "❌ $path is a symlink to $target, which is not a file of a public example, refusing to import it"
                  exit 1
              fi
          fi
      done < "$tmp_dir/files"
      # same layout as a manifest, without models nor checksums
      jq -R -s '{ format: 0, models: [ split("\n")[] | select(test("^[^/]+/[^/]+\\.sh$") and (endswith("/stop.sh") | not)) | { script: ., run_flags: "", credentials: [], external_files: [] } ], files: [ split("\n")[] | select(. != "") | { path: . } ] }' "$tmp_dir/files" > "$tmp_dir/legacy-manifest.json"
      manifest="$tmp_dir/legacy-manifest.json"
  fi

  # files at the top of the bundle are not in a model folder
  top_files=$(grep -v "/" "$tmp_dir/files" || true)
  if [ -n "$top_files" ]
  then
      logwarn "⏭️ skipping files that are not in a reproduction model folder: $(echo $top_files)"
      grep "/" "$tmp_dir/files" > "$tmp_dir/files.tmp" || true
      mv "$tmp_dir/files.tmp" "$tmp_dir/files"
  fi
  if [ ! -s "$tmp_dir/files" ]
  then
      logerror "❌ $file contains no reproduction model file"
      exit 1
  fi

  # paths of the exporter's machine, rewritten to this one in the text files of the bundle and in
  # the run lines: artifacts (stored in <model folder>/artifacts/) and the exporter's checkout
  : > "$tmp_dir/rewrites"
  while IFS=$'\t' read -r original path
  do
      printf '%s\t%s\n' "$original" "$repro_root/$path" >> "$tmp_dir/rewrites"
  done < <(jq -r '.artifacts[]? | "\(.original)\t\(.path)"' "$manifest")
  while IFS= read -r source_path
  do
      printf '%s\t%s\n' "$source_path" "$repro_root" >> "$tmp_dir/rewrites"
  done < <(jq -r '.source_repro_roots[]?' "$manifest")
  while IFS= read -r source_path
  do
      printf '%s\t%s\n' "$source_path" "$root_folder" >> "$tmp_dir/rewrites"
  done < <(jq -r '.source_root_folders[]?' "$manifest")

  # one pass, longest path first, so that a path is never rewritten twice
  rewrite_perl='BEGIN { open(my $r, "<", $ENV{REWRITES}) or die; while (<$r>) { chomp; my ($f, $t) = split(/\t/, $_, 2); next if $f eq "" || $f eq $t; $m{$f} = $t; } @k = sort { length($b) <=> length($a) } keys %m; $re = @k ? join("|", map { quotemeta } @k) : undef; } s/($re)/$m{$1}/g if defined $re;'

  function apply_rewrites () {
      printf '%s' "$1" | REWRITES="$tmp_dir/rewrites" perl -pe "$rewrite_perl"
  }

  if [ -s "$tmp_dir/rewrites" ]
  then
      while IFS= read -r path
      do
          case "$path" in
              */artifacts/*) continue ;;
              *.sh|*.bash|*.yml|*.yaml) ;;
              *) continue ;;
          esac
          # files restored as symlinks to the public example are left as is
          if [ -n "$(jq -r --arg path "$path" '.files[]? | select(.path == $path) | .link_to // empty' "$manifest")" ]
          then
              continue
          fi
          cp -p "$extract/$path" "$tmp_dir/before"
          REWRITES="$tmp_dir/rewrites" perl -pi -e "$rewrite_perl" "$extract/$path"
          if ! cmp -s "$tmp_dir/before" "$extract/$path"
          then
              log "🔀 $path: paths of the exporter's machine rewritten to this one"
          fi
      done < "$tmp_dir/files"
  fi

  # 3. what is in it
  exported_at=$(jq -r '.exported_at // empty' "$manifest")
  if [ -n "$exported_at" ]
  then
      log "📦 bundle exported on $exported_at by $(jq -r '.exported_by' "$manifest") from playground commit $(jq -r '.playground_commit' "$manifest")"
      playground_commit=$(jq -r '.playground_commit // empty' "$manifest")
      if [ -n "$playground_commit" ] && ! git -C "$root_folder" cat-file -e "$playground_commit^{commit}" 2>/dev/null
      then
          logwarn "🆕 commit $playground_commit is not in your checkout: the models may use features your playground does not have yet, consider 'git pull'"
      fi
  fi
  while IFS= read -r model
  do
      log "🔖 $(jq -r '.script' <<< "$model")"
      description=$(jq -r '.description // empty' <<< "$model")
      [ -n "$description" ] && log "   💡 $description"
      case_number=$(jq -r '.case // empty' <<< "$model")
      [ -n "$case_number" ] && log "   🔮 https://confluent.zendesk.com/agent/tickets/$case_number"
      author=$(jq -r '.author // empty' <<< "$model")
      [ -n "$author" ] && log "   👤 $author"
      base_example=$(jq -r '.base_example // empty' <<< "$model")
      if [ -n "$base_example" ]
      then
          if [ -d "$root_folder/$base_example" ]
          then
              log "   🧬 based on $base_example"
          else
              logwarn "   🧬 based on $base_example, which does not exist in your checkout: the copies stored in the bundle are used"
          fi
      fi
  done < <(jq -c '.models[]' "$manifest")

  # 4. plan: new, identical or conflicting
  date_suffix=$(date +%Y%m%d)
  nb_new=0
  nb_identical=0
  declare -a conflicts=()
  : > "$tmp_dir/plan"
  while IFS= read -r path
  do
      dest="$repro_root/$path"
      link_to=$(jq -r --arg path "$path" '.files[] | select(.path == $path) | .link_to // empty' "$manifest")
      if [ -e "$dest" ]
      then
          # your copy links to the same public file (its content may have changed since, e.g. config-*.json)
          if [ -n "$link_to" ] && [ -L "$dest" ] && [ "$(repro_link_target "$output_folder/$path")" == "$link_to" ]
          then
              status="identical"
              nb_identical=$((nb_identical+1))
          elif cmp -s "$extract/$path" "$dest"
          then
              status="identical"
              nb_identical=$((nb_identical+1))
          else
              status="conflict"
              conflicts+=("$path")
          fi
      else
          status="new"
          nb_new=$((nb_new+1))
      fi
      printf '%s\t%s\n' "$status" "$path" >> "$tmp_dir/plan"
  done < "$tmp_dir/files"

  log "📋 $nb_new new, $nb_identical identical, ${#conflicts[@]} conflicting file(s)"
  if [[ -n "$dry_run" ]] || [ ${#conflicts[@]} -gt 0 ]
  then
      while IFS=$'\t' read -r status path
      do
          case "$status" in
              new) echo "   ✨ new        $path" ;;
              identical) echo "   🟰 identical  $path" ;;
              conflict) echo "   ⚔️  conflict   $path" ;;
          esac
      done < "$tmp_dir/plan"
  fi

  if [[ -n "$dry_run" ]]
  then
      log "🔍 dry run: nothing imported"
      exit 0
  fi

  if [ ${#conflicts[@]} -gt 0 ] && [ "$on_conflict" == "abort" ]
  then
      logerror "❌ ${#conflicts[@]} file(s) differ from your copy, nothing imported. Use --on-conflict rename (keeps yours) or --on-conflict overwrite"
      exit 1
  fi

  # 5. import
  declare -a renames=()
  while IFS=$'\t' read -r status path
  do
      dest="$repro_root/$path"
      if [ "$status" == "identical" ]
      then
          continue
      fi
      if [ "$status" == "conflict" ]
      then
          if [ "$on_conflict" == "rename" ]
          then
              name=$(basename "$path")
              if [[ "$name" == *.* ]]
              then
                  new_name="${name%.*}-imported-$date_suffix.${name##*.}"
              else
                  new_name="$name-imported-$date_suffix"
              fi
              dest="$(dirname "$dest")/$new_name"
              renames+=("$name	$new_name")
              log "✏️  $path imported as $(dirname "$path")/$new_name"
          fi
          rm -f "$dest"
      fi
      mkdir -p "$(dirname "$dest")"

      if [ -L "$extract/$path" ]
      then
          # legacy bundle: the symlink was validated above
          rm -f "$dest"
          ln -s "$(readlink "$extract/$path")" "$dest"
          continue
      fi

      # restore the symlinks of bootstrap when the public file is identical
      link_to=$(jq -r --arg path "$path" '.files[] | select(.path == $path) | .link_to // empty' "$manifest")
      if [ -n "$link_to" ] && [ -f "$root_folder/$link_to" ] && cmp -s "$extract/$path" "$root_folder/$link_to"
      then
          up=$(echo "$output_folder/$(dirname "$path")" | sed -e 's|[^/][^/]*|..|g')
          ln -s "$up/$link_to" "$dest"
      else
          if [ -n "$link_to" ]
          then
              logwarn "📄 $path differs from $link_to in your checkout, keeping the copy from the bundle"
          fi
          cp -p "$extract/$path" "$dest"
      fi
  done < "$tmp_dir/plan"

  # the final path of each model, with references to renamed files updated
  declare -a model_paths=()
  while IFS= read -r model
  do
      script=$(jq -r '.script' <<< "$model")
      name=$(basename "$script")
      for rename in "${renames[@]}"
      do
          if [ "${rename%%	*}" == "$name" ]
          then
              name="${rename##*	}"
          fi
      done
      model_path="$repro_root/$(dirname "$script")/$name"
      model_paths+=("$model_path")
      for rename in "${renames[@]}"
      do
          sed -e "s|${rename%%	*}|${rename##*	}|g" "$model_path" > "$tmp_dir/script"
          cat "$tmp_dir/script" > "$model_path"
      done
  done < <(jq -c '.models[]' "$manifest")

  log "📥 $file imported in $repro_root"
  # commits of the imported models get scanned for secrets and customer data
  repro_install_git_hook

  if [ ${#model_paths[@]} -eq 0 ]
  then
      exit 0
  fi

  # 6. register the first model as the current one, like bootstrap does
  test_file="${model_paths[0]}"
  playground state set run.test_file "$test_file"
  playground state set run.connector_type "$(get_connector_type | tr -d '\n')"

  # 7. how to run them
  i=0
  while IFS= read -r model
  do
      model_path="${model_paths[$i]}"
      i=$((i+1))
      run_flags=$(apply_rewrites "$(jq -r '.run_flags // empty' <<< "$model")")
      log "▶️  playground run -f $model_path${run_flags:+ $run_flags}"
      while IFS= read -r external_file
      do
          external_file=$(apply_rewrites "$external_file")
          if [ -n "$external_file" ] && [ ! -f "$external_file" ]
          then
              logwarn "   📎 it runs with $external_file, which is not on this machine: ask for it and fix the path"
          fi
      done < <(jq -r '.external_files[]?' <<< "$model")
      while IFS= read -r credential
      do
          case "$credential" in
              "")
                  ;;
              handle_*_credentials|bootstrap_ccloud_environment)
                  log "   🔑 calls $credential, make sure the matching credentials are set up"
                  ;;
              *)
                  if [ -z "$(secret_get "$credential" 2>/dev/null)" ]
                  then
                      logwarn "   🔑 $credential is not set: playground secrets set $credential"
                  fi
                  ;;
          esac
      done < <(jq -r '.credentials[]?' <<< "$model")
  done < <(jq -c '.models[]' "$manifest")

}

# :command.function
playground_repro_bootstrap_command() {

  # src/commands/repro/bootstrap.sh
  IGNORE_CHECK_FOR_DOCKER_COMPOSE=true

  test_file="${args[--file]}"
  description="${args[--description]}"
  producer="${args[--producer]}"
  nb_producers="${args[--nb-producers]}"
  add_custom_smt="${args[--custom-smt]}"

  eval "pipeline_array=(${args[--pipeline]})"

  eval "connector_plugin_array=(${args[--connector-plugin]})"

  no_run="${args[--no-run]}"
  schema_file_key="${args[--producer-schema-key]}"
  schema_file_value="${args[--producer-schema-value]}"

  if [[ ! -n "$test_file" ]]
  then
    display_interactive_menu_categories 1

    if [[ $test_file == *"@"* ]]
    then
      test_file=$(echo "$test_file" | cut -d "@" -f 2)
    fi

    declare -a array_flag_list=()
    terminal_columns=$(tput cols)
    if [[ $terminal_columns -gt 180 ]]
    then
      MAX_LENGTH=$((${terminal_columns}-120))
      fzf_version=$(get_fzf_version)
      if version_gt $fzf_version "0.38"
      then
        fzf_option_wrap="--preview-window=30%,wrap"
        fzf_option_pointer="--pointer=👉"
        fzf_option_empty_pointer=""
        fzf_option_rounded="--border=rounded"
      else
        fzf_option_wrap=""
        fzf_option_pointer=""
        fzf_option_empty_pointer=""
        fzf_option_rounded=""
      fi
    else
      MAX_LENGTH=$((${terminal_columns}-65))
      fzf_version=$(get_fzf_version)
      if version_gt $fzf_version "0.38"
      then
        fzf_option_wrap="--preview-window=20%,wrap"
        fzf_option_pointer="--pointer=👉"
        fzf_option_empty_pointer=""
        fzf_option_rounded="--border=rounded"
      else
        fzf_option_wrap=""
        fzf_option_pointer=""
        fzf_option_empty_pointer=""
        fzf_option_rounded=""
      fi
    fi
    readonly MENU_LETS_GO="🏭 Create the reproduction model !"

    MENU_ENABLE_CUSTOM_SMT="$(menu_label "🔧" "Add custom SMT" "--custom-smt")"
    MENU_ADD_CONNECTOR_PLUGIN="$(menu_label "🔌" "Add connector plugin" "--connector-plugin")"

    readonly MENU_DISABLE_CUSTOM_SMT="❌🔧 Disable custom SMT"
    readonly MENU_GO_BACK="🔙 Go back"

    last_two_folders=$(basename $(dirname $(dirname $test_file)))/$(basename $(dirname $test_file))
    example="$last_two_folders/$(basename "$test_file")"

    connector_example=0
    get_connector_paths
    if [ "$connector_paths" != "" ]
    then
      for connector_path in ${connector_paths//,/ }
      do
        full_connector_name=$(basename "$connector_path")
        owner=$(echo "$full_connector_name" | cut -d'-' -f1)
        name=$(echo "$full_connector_name" | cut -d'-' -f2-)

        if [ "$owner" == "java" ] || [ "$name" == "hub-components" ] || [ "$owner" == "filestream" ]
        then
          # happens when plugin is not coming from confluent hub
          continue
        else
          connector_example=1
        fi
      done
    fi

    stop=0
    description=""
    while [ $stop != 1 ]
    do
      length=${#pipeline_array[@]}
      if ((length > 0))
      then
        MENU_PIPELINE="$(menu_label "🔖" "Add another sink to pipeline" "--pipeline")"
      else
        MENU_PIPELINE="$(menu_label "🔖" "Create pipeline with sink" "--pipeline")"
      fi

      # an entry is only added when it applies to this example
      options=("$MENU_LETS_GO")
      if [ $connector_example == 1 ]
      then
        if [[ $test_file != *"sink"* ]]
        then
          options+=("$MENU_PIPELINE")
        fi
        if [ -z "$CUSTOM_SMT" ]
        then
          options+=("$MENU_ENABLE_CUSTOM_SMT")
        else
          options+=("$MENU_DISABLE_CUSTOM_SMT")
        fi
        options+=("$MENU_ADD_CONNECTOR_PLUGIN")
      fi
      options+=("$MENU_GO_BACK")

      if [ "$description" == "" ]
      then
        maybe_remove_flag "--description"
        set +e
        description=$(echo "" | fzf --margin=1%,1%,1%,1% $fzf_option_rounded --info=inline --cycle --prompt="💭 " --header="enter a description for this repro model (it cannot be empty !, esc to quit)" --color="bg:-1,bg+:-1,info:#BDBB72,border:#FFFFFF,spinner:0,hl:#beb665,fg:#00f7f7,header:#5CC9F5,fg+:#beb665,pointer:#E12672,marker:#5CC9F5,prompt:#98BEDE" $fzf_option_wrap $fzf_option_empty_pointer --print-query)
        if [ $? -eq 130 ]
        then
          # esc
          exit 0
        fi
        set -e
        if [ "$description" == "" ]
        then
          continue
        fi
        array_flag_list+=("--description=$description")
      fi

      oldifs=$IFS
      IFS=$'\n' flag_string="${array_flag_list[*]}"
      IFS=$oldifs
      res=$(printf '%s\n' "${options[@]}" | fzf --multi --margin=1%,1%,1%,1% $fzf_option_rounded --info=inline --cycle --prompt="🛠 " --header="select option(s) for $example (use tab to select more than one)" --color="bg:-1,bg+:-1,info:#BDBB72,border:#FFFFFF,spinner:0,hl:#beb665,fg:#00f7f7,header:#5CC9F5,fg+:#beb665,pointer:#E12672,marker:#5CC9F5,prompt:#98BEDE" $fzf_option_wrap $fzf_option_pointer --preview "echo -e \"👷 Number of repro models created so far: $(get_cli_metric nb_reproduction_models)\n\n🛠️  Number of repro models available: $(get_cli_metric nb_existing_reproduction_models)\n\n⛳ flag list:\n$flag_string\"")

      if [[ $res == *"$MENU_LETS_GO"* ]]
      then
        stop=1
      fi

      if [[ $res == *"$MENU_GO_BACK"* ]]
      then
        playground repro bootstrap
        exit $?
      fi

      if [[ $res == *"$MENU_ENABLE_CUSTOM_SMT"* ]]
      then
        array_flag_list+=("--custom-smt")
        export CUSTOM_SMT=true
        add_custom_smt="true"
      fi
      if [[ $res == *"$MENU_DISABLE_CUSTOM_SMT"* ]]
      then
        array_flag_list=("${array_flag_list[@]/"--custom-smt"}")
        unset CUSTOM_SMT
        add_custom_smt=""
      fi

      if [[ $res == *"$MENU_ADD_CONNECTOR_PLUGIN"* ]]
      then
        set +e
        selected_plugin=$(playground get-connector-plugin | head -1)
        if [[ $selected_plugin == *"@"* ]]
        then
          selected_plugin=$(echo "$selected_plugin" | cut -d "@" -f 2)
          connector_plugin_array+=("$selected_plugin")
        fi
        set -e
      fi

      if [[ $res == *"$MENU_PIPELINE"* ]]
      then
        sink_file=$(playground get-examples-list-with-fzf --without-repro --sink-only )
        if [[ $sink_file == *"@"* ]]
        then
          sink_file=$(echo "$sink_file" | cut -d "@" -f 2)
        fi
        array_flag_list+=("--pipeline=$sink_file")
        pipeline_array+=("$sink_file")
      fi
    done # end while loop stop
  fi

  if [ "$description" == "" ]
  then
    # -f without -d (for example the 🧪 entry of the playground run menu)
    set +e
    description=$(echo "" | fzf --margin=1%,1%,1%,1% --info=inline --cycle --prompt="💭 " --header="enter a description for this repro model (it cannot be empty !, esc to quit)" --color="bg:-1,bg+:-1,info:#BDBB72,border:#FFFFFF,spinner:0,hl:#beb665,fg:#00f7f7,header:#5CC9F5,fg+:#beb665,pointer:#E12672,marker:#5CC9F5,prompt:#98BEDE" --print-query 2>/dev/null)
    if [ $? -eq 130 ]
    then
      # esc
      exit 0
    fi
    set -e
    if [ "$description" == "" ]
    then
      logerror "❌ a description is required, use --description (-d)"
      exit 1
    fi
  fi

  if [[ $test_file == *"@"* ]]
  then
    test_file=$(echo "$test_file" | cut -d "@" -f 2)
  fi

  if [[ "$test_file" != *".sh" ]]
  then
    logerror "❌ test_file $test_file is not a .sh file!"
    exit 1
