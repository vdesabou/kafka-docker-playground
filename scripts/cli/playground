# :command.function
playground_debug_generate_diagnostics_command() {

  # src/commands/debug/generate-diagnostics.sh
  containers="${args[--container]}"

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  # Convert space-separated string to array
  IFS=' ' read -ra container_array <<< "$containers"

  for container in "${container_array[@]}"
  do
  	if [[ "$container" == "connect" ]] || [[ "$container" == "broker" ]]
  	then
  		log "⛑️ Creating diagnostics bundle for container ${container}"
  		log "⏳ please wait..."
  	else
  		logerror "❌ only connect and broker containers are supported"
  		exit 1
  	fi

  	playground --output-level ERROR container exec --container "$container" --command "curl -L https://packages.confluent.io/tools/diagnostics-bundle/diagnostics-bundle-1.0.4.jar -o /tmp/diagnostics-bundle-1.0.4.jar" > /dev/null 2>&1

  	fifo_path="$tmp_dir/collect_fifo"
  	mkfifo "$fifo_path"

  	set +e
  	playground --output-level ERROR container exec --container "$container" --command "java -jar /tmp/diagnostics-bundle-1.0.4.jar collect" > "$fifo_path" 2>&1 &

  	# Loop through each line in the named pipe
  	while read -r line
  	do
  		echo "$line"
  		echo "$line" >> $tmp_dir/result.log

  	done < "$fifo_path"

  	nb=$(grep -c "Diagnostics output has been zipped and written to" $tmp_dir/result.log)
  	if [ $nb -eq 0 ]
  	then
  		logerror "❌ Failed to generate bundle"
  		cat $tmp_dir/result.log
  		exit 1
  	fi
  	bundle_file=$(cat $tmp_dir/result.log | grep "Diagnostics output has been zipped and written to" | cut -d ":" -f 4 | sed 's/ //g')
  	bundle_file_filename=$(basename -- "$bundle_file")
  	log "⛑️ diagnostics bundle is available at ${bundle_file_filename}"
  	playground container cp --source ${container}:${bundle_file} --destination ${bundle_file_filename}
  done
}

# :command.function
playground_debug_thread_dump_command() {

  # src/commands/debug/thread-dump.sh
  containers="${args[--container]}"
  use_jstack="${args[--jstack]}"
  debug_image="${DEBUG_IMAGE:-eclipse-temurin:17-jdk}"

  get_environment_used

  get_cfk_target_container_name() {
      local requested_name="$1"
      case "$requested_name" in
          connect|connect2|connect3|connect-us|connect-europe)
              echo "connect"
              ;;
          broker|kafka)
              echo "kafka"
              ;;
          schema-registry|schemaregistry)
              echo "schemaregistry"
              ;;
          control-center|controlcenter)
              echo "controlcenter"
              ;;
          ksqldb-server|ksqldb)
              echo "ksqldb"
              ;;
          *)
              echo "$requested_name"
              ;;
      esac
  }

  # jstack -l (adds the java.util.concurrent lock owners); never restarts the container
  # $1: container, $2: resolved container, $3: output file
  take_thread_dump_with_jstack() {
      local container="$1" resolved_container="$2" filename="$3"
      local target_container_name
      target_container_name=$(get_cfk_target_container_name "$container")

      if [[ "$environment" == cfk* ]]
      then
          if ! playground --output-level ERROR container exec --container "$resolved_container" --command "test -x /tmp/jdk-tools/bin/jstack || type jstack" > /dev/null 2>&1
          then
              logwarn "jstack is not available on pod $resolved_container, attaching debug container $debug_image (the pod is not restarted)"
              debug_stderr=$(mktemp -t pg-debug-XXXXXXXXXX)
              kubectl -n confluent debug "$resolved_container" --image="$debug_image" --target="$target_container_name" --profile=sysadmin -- bash -lc 'set -e; TARGET_PID=""; for p in /proc/[0-9]*; do if grep -aq "java" "$p/cmdline" 2>/dev/null; then TARGET_PID="${p#/proc/}"; break; fi; done; [ -n "$TARGET_PID" ] || TARGET_PID=1; TARGET_ROOT="/proc/${TARGET_PID}/root"; mkdir -p "${TARGET_ROOT}/tmp/jdk-tools/bin"; JSTACK_BIN="$(command -v jstack)"; JDK_HOME="$(cd "$(dirname "$JSTACK_BIN")/.." && pwd)"; cp "$JSTACK_BIN" "${TARGET_ROOT}/tmp/jdk-tools/bin/"; rm -rf "${TARGET_ROOT}/tmp/jdk-tools/lib"; cp -r "$JDK_HOME/lib" "${TARGET_ROOT}/tmp/jdk-tools/"' > /dev/null 2>"$debug_stderr"
              if [ $? != 0 ]
              then
                  logerror "❌ could not prepare jstack tools in pod $resolved_container"
                  cat "$debug_stderr"
                  rm -f "$debug_stderr"
                  return 1
              fi
              rm -f "$debug_stderr"
          fi
          kubectl -n confluent exec "$resolved_container" -c "$target_container_name" -- /bin/sh -c "if [ -x /tmp/jdk-tools/bin/jstack ]; then cd /tmp/jdk-tools && ./bin/jstack -l 1; else jstack -l 1; fi" > "$filename" 2>&1
          return $?
      fi

      if ! playground --output-level ERROR container exec --container "$resolved_container" --command "type jstack" > /dev/null 2>&1
      then
          logerror "❌ jstack is not installed in container $container (the image has a JRE only)"
          log "💡 playground container change-jdk --version 17 installs a JDK, but it RESTARTS the container: the state you want to look at is lost"
          return 1
      fi
      playground --output-level ERROR container exec --container "$resolved_container" --command "date '+%Y-%m-%d %H:%M:%S'; jstack -l 1" > "$filename" 2>&1
  }

  # Convert space-separated string to array
  IFS=' ' read -ra container_array <<< "$containers"

  for container in "${container_array[@]}"
  do
      set +e
      resolved_container=$(resolve_container_name_for_environment "$container")
      filename="/tmp/thread-dump-$container-$(date '+%Y-%m-%d-%H-%M-%S').log"

      done_ok=""
      if [[ -z "$use_jstack" ]]
      then
          log "🎯 Taking thread dump on container ${container} with kill -3"
          if take_thread_dumps_with_kill_quit "$container" 1 0 "$filename"
          then
              done_ok=1
          else
              logwarn "⚠️  the kill -3 output did not reach the logs of $container, trying jstack"
          fi
      fi
      if [[ -z "$done_ok" ]]
      then
          log "🎯 Taking thread dump on container ${container} with jstack -l"
          take_thread_dump_with_jstack "$container" "$resolved_container" "$filename" && grep -q "Full thread dump" "$filename" && done_ok=1
      fi
      set -e

      if [[ -n "$done_ok" ]]
      then
          log "👻 thread dump is available at ${filename}"
          log "🔬 Analyze it with: playground analyze thread-dump --file ${filename}"
          playground open --file "${filename}"
      else
          logerror "❌ failed to take thread dump on container $container"
          failed=1
      fi
  done
  if [[ -n "$failed" ]]
  then
      exit 1
  fi

}

# :command.function
playground_debug_thread_analyze_command() {

  # src/commands/analyze/thread-dump.sh
  eval "file_array=(${args[--file]})"
  eval "sample_array=(${args[--sample]})"
  container="${args[--container]}"
  count="${args[--count]}"
  interval="${args[--interval]}"
  output_dir="${args[--output-dir]}"
  json_out="${args[--json]}"
  top="${args[--top]}"

  # with --json, logs go to stderr and only the analysis to stdout (same as analyze flight-recorder)
  if [[ -n "$json_out" ]]; then
      exec 3>&1 1>&2
  fi

  set +e

  nb_modes=0
  [[ ${#file_array[@]} -gt 0 ]] && nb_modes=$((nb_modes + 1))
  [[ ${#sample_array[@]} -gt 0 ]] && nb_modes=$((nb_modes + 1))
  [[ -n "$container" ]] && nb_modes=$((nb_modes + 1))
  if [[ $nb_modes -gt 1 ]]; then
      logerror "❌ Provide only one of --file, --container and --sample"
      exit 1
  fi
  if [[ $nb_modes -eq 0 ]]; then
      container="connect"
  fi

  # ── Sample mode: dumps shipped with the analyzer ──
  samples_dir="$root_folder/tools/thread-analyzer/samples"
  for sample in "${sample_array[@]}"
  do
      case "$sample" in
          deadlock_jdk21) file_array+=("$samples_dir/jdk21-scenario-1.txt" "$samples_dir/jdk21-scenario-2.txt" "$samples_dir/jdk21-scenario-3.txt") ;;
          deadlock_jdk8) file_array+=("$samples_dir/jdk8-scenario.txt") ;;
          healthy_connect) file_array+=("$samples_dir/cp-8.3.2-connect-kill-3-logs.txt") ;;
      esac
  done

  analyzer="$root_folder/tools/thread-analyzer/thread_dump_analyzer.py"
  if [[ ! -f "$analyzer" ]]; then
      logerror "❌ Thread dump analyzer not found at: $analyzer"
      exit 1
  fi
  if ! command -v python3 &>/dev/null; then
      logerror "❌ python3 is required but not found on PATH"
      exit 1
  fi

  mkdir -p "$output_dir"
  output_dir_abs=$(cd "$output_dir" && pwd)

  # ── Container mode: kill -3 the JVM (prints the dumps on its stdout, no JDK needed), read them back from the logs ──
  if [[ -n "$container" ]]; then
      get_environment_used
      resolved_container=$(resolve_container_name_for_environment "$container")
      dumps_file="$output_dir_abs/thread-dumps-${container}-$(date '+%Y%m%d-%H%M%S').log"
      log "🎯 Taking $count thread dump(s) of container $container with kill -3, $interval second(s) apart"
      if ! take_thread_dumps_with_kill_quit "$container" "$count" "$interval" "$dumps_file"; then
          # the JVM stdout does not reach the container logs: fall back to jstack when the image has a JDK
          if playground --output-level ERROR container exec --container "$resolved_container" --command "type jstack" > /dev/null 2>&1; then
              logwarn "⚠️  kill -3 output not found in the logs of $container, using jstack"
              : > "$dumps_file"
              for i in $(seq 1 "$count")
              do
                  playground --output-level ERROR container exec --container "$resolved_container" --command "date '+%Y-%m-%d %H:%M:%S'; jstack -l 1" >> "$dumps_file" 2>&1
                  [[ $i -lt $count ]] && sleep "$interval"
              done
          fi
      fi
      nb_dumps=$(grep -c "Full thread dump" "$dumps_file" 2>/dev/null)
      if [[ -z "$nb_dumps" || $nb_dumps -eq 0 ]]; then
          logerror "❌ Could not get a thread dump from container $container (kill -3 output not in its logs, no jstack)"
          log "💡 playground debug thread-dump --container $container --jstack also works on cfk (debug container)"
          exit 1
      fi
      log "✅ $nb_dumps thread dump(s) saved in $dumps_file"
      file_array=("$dumps_file")
  fi

  # Handle fzf @path trick
  for i in "${!file_array[@]}"
  do
      if [[ ! -e "${file_array[$i]}" && "${file_array[$i]}" == *"@"* ]]; then
          file_array[$i]=$(echo "${file_array[$i]}" | cut -d "@" -f 2)
      fi
  done

  analyzer_args=("${file_array[@]}" --top "$top")

  if [[ -n "$json_out" ]]; then
      python3 -I "$analyzer" "${analyzer_args[@]}" --json >&3
      exit $?
  fi

  html_out=""
  # the HTML report is always written (not with --json: stdout must stay JSON)
  if [[ -z "$json_out" ]]; then
      first=$(basename "${file_array[0]}")
      html_out="${output_dir_abs}/${first%.*}-thread-report.html"
      analyzer_args+=(--html-out "$html_out")
  fi

  log "🧵 Analyzing thread dump(s): ${file_array[*]}"
  log ""
  python3 -I "$analyzer" "${analyzer_args[@]}"
  exit_code=$?

  if [[ $exit_code -ne 0 ]]; then
      logerror "❌ Thread dump analysis failed (exit code $exit_code)"
      exit $exit_code
  fi

  if [[ -n "$html_out" && -f "$html_out" ]]; then
      log ""
      log "✅ HTML report saved: $html_out"
      # only open a browser in an interactive terminal
      if [[ -t 1 ]] && command -v open &>/dev/null; then
          log "🌐 Opening report in browser..."
          open "$html_out"
      else
          log "🔗 Open in browser: file://$html_out"
      fi
  fi

  exit 0

}

# :command.function
playground_debug_heap_dump_command() {

  # src/commands/debug/heap-dump.sh
  containers="${args[--container]}"
  live="${args[--live]}"
  histo="${args[--histo]}"
  debug_image="${DEBUG_IMAGE:-eclipse-temurin:17-jdk}"

  get_environment_used

  get_cfk_target_container_name() {
      local requested_name="$1"
      case "$requested_name" in
          connect|connect2|connect3|connect-us|connect-europe)
              echo "connect"
              ;;
          broker|kafka)
              echo "kafka"
              ;;
          schema-registry|schemaregistry)
              echo "schemaregistry"
              ;;
          control-center|controlcenter)
              echo "controlcenter"
              ;;
          ksqldb-server|ksqldb)
              echo "ksqldb"
              ;;
          *)
              echo "$requested_name"
              ;;
      esac
  }

  set +e

  # Convert space-separated string to array
  IFS=' ' read -ra container_array <<< "$containers"

  for container in "${container_array[@]}"
  do
      resolved_container=$(resolve_container_name_for_environment "$container")
      target_container_name=$(get_cfk_target_container_name "$container")

      playground --output-level ERROR container exec --container "$resolved_container" --command "type jmap" > /dev/null 2>&1
      if [ $? != 0 ]
      then
          if [[ "$environment" == cfk* ]]
          then
              logwarn "jmap is not available on pod $resolved_container, attaching debug container $debug_image"
              debug_stderr=$(mktemp -t pg-debug-XXXXXXXXXX)
              kubectl -n confluent debug "$resolved_container" --image="$debug_image" --target="$target_container_name" --profile=sysadmin -- bash -lc 'set -e; TARGET_PID=""; for p in /proc/[0-9]*; do if grep -aq "java" "$p/cmdline" 2>/dev/null; then TARGET_PID="${p#/proc/}"; break; fi; done; [ -n "$TARGET_PID" ] || TARGET_PID=1; TARGET_ROOT="/proc/${TARGET_PID}/root"; mkdir -p "${TARGET_ROOT}/tmp/jdk-tools/bin"; JMAP_BIN="$(command -v jmap)"; JDK_HOME="$(cd "$(dirname "$JMAP_BIN")/.." && pwd)"; cp "$JMAP_BIN" "${TARGET_ROOT}/tmp/jdk-tools/bin/"; rm -rf "${TARGET_ROOT}/tmp/jdk-tools/lib"; cp -r "$JDK_HOME/lib" "${TARGET_ROOT}/tmp/jdk-tools/"' > /dev/null 2>"$debug_stderr"
              if [ $? != 0 ]
              then
                  logerror "❌ could not prepare jmap tools in pod $resolved_container"
                  cat "$debug_stderr"
                  rm -f "$debug_stderr"
                  exit 1
              fi
              rm -f "$debug_stderr"

              playground --output-level ERROR container exec --container "$resolved_container" --command "test -x /tmp/jdk-tools/bin/jmap" > /dev/null 2>&1
              if [ $? != 0 ]
              then
                  logerror "❌ jmap tool copy completed but /tmp/jdk-tools/bin/jmap is missing in pod $resolved_container"
                  exit 1
              fi
          else
              logwarn "jmap is not installed on container $container, attempting to install jdk 17"
              playground container change-jdk --version 17

              playground --output-level ERROR container exec --container "$resolved_container" --command "type jmap" > /dev/null 2>&1
              if [ $? != 0 ]
              then
                  logerror "❌ jmap could not be installed on container $container"
                  exit 1
              fi
          fi
      fi

      if [[ -n "$histo" ]]
      then
          filename="heap-dump-$container-histo-$(date '+%Y-%m-%d-%H-%M-%S').txt"
          set -e
          if [[ -n "$live" ]]
          then
              log "📊 Taking histo (with live option) heap dump on container ${container}"
              if [[ "$environment" == cfk* ]]
              then
                  kubectl -n confluent exec "$resolved_container" -c "$target_container_name" -- /bin/sh -c "cd /tmp/jdk-tools && ./bin/jmap -histo:live 1" > /tmp/${filename}
              else
                  playground --output-level ERROR container exec --container "$resolved_container" --command "jmap -histo:live 1" > /tmp/${filename}
              fi
          else
              log "📊 Taking histo (without live option) heap dump on container ${container}"
              if [[ "$environment" == cfk* ]]
              then
                  kubectl -n confluent exec "$resolved_container" -c "$target_container_name" -- /bin/sh -c "cd /tmp/jdk-tools && ./bin/jmap -histo 1" > /tmp/${filename}
              else
                  playground --output-level ERROR container exec --container "$resolved_container" --command "jmap -histo 1" > /tmp/${filename}
              fi
          fi
          if [ $? -eq 0 ]
          then
              log "👻 heap dump is available at /tmp/${filename}"
          else
              logerror "❌ Failed to take heap dump"
          fi
      else
          filename="heap-dump-$container-$(date '+%Y-%m-%d-%H-%M-%S').hprof"
          set -e
          if [[ -n "$live" ]]
          then
              log "🎯 Taking heap dump (with live option) on container ${container}"
              if [[ "$environment" == cfk* ]]
              then
                  kubectl -n confluent exec "$resolved_container" -c "$target_container_name" -- /bin/sh -c "cd /tmp/jdk-tools && ./bin/jmap -dump:live,format=b,file=/tmp/${filename} 1"
              else
                  playground --output-level ERROR container exec --container "$resolved_container" --command "jmap -dump:live,format=b,file=/tmp/${filename} 1"
              fi
          else
              log "🎯 Taking heap dump (without live option) on container ${container}"
              if [[ "$environment" == cfk* ]]
              then
                  kubectl -n confluent exec "$resolved_container" -c "$target_container_name" -- /bin/sh -c "cd /tmp/jdk-tools && ./bin/jmap -dump:format=b,file=/tmp/${filename} 1"
              else
                  playground --output-level ERROR container exec --container "$resolved_container" --command "jmap -dump:format=b,file=/tmp/${filename} 1"
              fi
          fi
          if [ $? -eq 0 ]
          then
              log "👻 heap dump is available at ${filename}"
              playground container cp --source ${resolved_container}:/tmp/${filename} --destination ${filename}
              log "🔬 Analyze it with Eclipse MAT: playground analyze heap-dump --file ${filename}"
          else
              logerror "❌ Failed to take heap dump"
          fi
      fi
  done
}

# :command.function
playground_debug_heap_analyze_command() {

  # src/commands/analyze/heap-dump.sh
  heap_file="${args[--file]}"
  sample="${args[--sample]}"
  output_dir="${args[--output-dir]}"
  report_type="${args[--report-type]}"
  max_memory="${args[--max-memory]}"
  compare_file="${args[--compare]}"
  json_out="${args[--json]}"

  set +e

  # with --json, logs and the text digest go to stderr and only the analysis to stdout (same as analyze thread-dump)
  if [[ -n "$json_out" ]]; then
      exec 3>&1 1>&2
  fi

  if [[ -n "$heap_file" && -n "$sample" ]]; then
      logerror "❌ Provide either --file or --sample, not both"
      exit 1
  fi
  if [[ -z "$heap_file" && -z "$sample" ]]; then
      logerror "❌ Must provide --file <heap dump> (or --sample leak to try it)"
      exit 1
  fi

  # ── Sample mode: dumps shipped with the analyzer (see tools/heap-analyzer/samples) ──
  samples_dir="$root_folder/tools/heap-analyzer/samples"
  case "$sample" in
      leak) heap_file="$samples_dir/session-cache-leak-2.hprof.gz" ;;
      leak_growth)
          heap_file="$samples_dir/session-cache-leak-1.hprof.gz"
          compare_file="$samples_dir/session-cache-leak-2.hprof.gz"
      ;;
  esac

  if [[ ! -f "$heap_file" && $heap_file == *"@"* ]]
  then
    heap_file=$(echo "$heap_file" | cut -d "@" -f 2)
  fi
  if [[ ! -f "$compare_file" && $compare_file == *"@"* ]]
  then
    compare_file=$(echo "$compare_file" | cut -d "@" -f 2)
  fi

  for f in "$heap_file" $compare_file
  do
      if [[ ! -f "$f" ]]; then
          logerror "❌ Heap dump file not found: $f"
          exit 1
      fi
  done

  tools_dir="$root_folder/tools/heap-analyzer"
  if [ ! -f "$tools_dir/Dockerfile" ]; then
      logerror "❌ $tools_dir not found"
      exit 1
  fi

  # ── Analyzer image: Eclipse MAT baked once, scripts mounted at run time ────
  # The tag changes when the Dockerfile changes (new MAT version), so the image is rebuilt only then
  image="heap-analyzer:$(cksum < "$tools_dir/Dockerfile" | cut -d ' ' -f 1)"
  if ! docker image inspect "$image" > /dev/null 2>&1; then
      log "📦 Building $image with Eclipse MAT (first run only, downloads ~100 MB)..."
      build_log=$(mktemp -t heap-analyzer-build-XXXXXXXXXX)
      if ! docker build --load -t "$image" "$tools_dir" > "$build_log" 2>&1 && ! docker build -t "$image" "$tools_dir" >> "$build_log" 2>&1; then
          logerror "❌ Failed to build $image, see $build_log"
          tail -20 "$build_log"
          exit 1
      fi
      rm -f "$build_log"
  fi

  mkdir -p "$output_dir"
  heap_file_abs=$(cd "$(dirname "$heap_file")" && pwd -P)/$(basename "$heap_file")
  output_dir_abs=$(cd "$output_dir" && pwd -P)

  docker_args=(
      --rm
      --user "$(id -u):$(id -g)"
      -v "$tools_dir:/tools/heap-analyzer:ro"
      -v "$heap_file_abs:/input/$(basename "$heap_file"):ro"
      -v "$output_dir_abs:/output"
  )
  analyzer_args=(
      --file "/input/$(basename "$heap_file")"
      --output-dir /output
      --report-type "$report_type"
  )

  if [[ -n "$max_memory" ]]; then
      analyzer_args+=(--max-memory "$max_memory")
  fi

  if [[ -n "$compare_file" ]]; then
      compare_file_abs=$(cd "$(dirname "$compare_file")" && pwd -P)/$(basename "$compare_file")
      docker_args+=(-v "$compare_file_abs:/compare/$(basename "$compare_file"):ro")
      analyzer_args+=(--compare "/compare/$(basename "$compare_file")")
  fi

  log "🔬 Analyzing heap dump $heap_file, reports in $output_dir_abs"
  docker run "${docker_args[@]}" "$image" "${analyzer_args[@]}"
  exit_code=$?

  if [ $exit_code -ne 0 ]; then
      logerror "❌ Heap dump analysis failed (exit code $exit_code), MAT log: $output_dir_abs/mat.log"
      exit $exit_code
  fi

  log "📄 Digest saved in $output_dir_abs/summary.txt"

  if ! command -v python3 &>/dev/null; then
      logwarn "⚠️ python3 is not on PATH: no HTML report, MAT reports in $output_dir_abs"
      exit 0
  fi
  report_args=(--output-dir "$output_dir_abs" --heap-file "$(basename "$heap_file")")
  if [[ -n "$compare_file" ]]; then
      report_args+=(--compare-file "$(basename "$compare_file")")
  fi
  if [[ -n "$json_out" ]]; then
      python3 -I "$root_folder/tools/heap-analyzer/heap_report.py" "${report_args[@]}" --json >&3
      exit $?
  fi
  stem=$(basename "$heap_file")
  stem="${stem%.gz}"
  stem="${stem%.hprof}"
  html_out="$output_dir_abs/${stem}-heap-report.html"
  if ! python3 -I "$root_folder/tools/heap-analyzer/heap_report.py" "${report_args[@]}" --html-out "$html_out"; then
      logerror "❌ could not write the HTML report"
      exit 1
  fi
  open_html_report "$html_out"

}

# :command.function
playground_debug_analyze_logs_command() {

  # src/commands/analyze/logs.sh
  eval "file_array=(${args[--file]})"
  eval "sample_array=(${args[--sample]})"
  include_warnings="${args[--include-warnings]}"
  max_findings="${args[--max-findings]}"
  output_dir="${args[--output-dir]}"
  json_out="${args[--json]}"

  # with --json, logs and the text digest go to stderr and only the analysis to stdout (same as analyze thread-dump)
  if [[ -n "$json_out" ]]
  then
      exec 3>&1 1>&2
  fi

  if [[ ${#file_array[@]} -gt 0 && ${#sample_array[@]} -gt 0 ]]
  then
      logerror "❌ Provide either --file or --sample, not both"
      exit 1
  fi
  if [[ ${#file_array[@]} -eq 0 && ${#sample_array[@]} -eq 0 ]]
  then
      logerror "❌ Must provide --file <log file, folder or bundle> (or --sample connect_task_failure to try it)"
      exit 1
  fi

  # ── Sample mode: logs shipped in tools/log-analyzer/samples ──
  for sample in "${sample_array[@]}"
  do
      case "$sample" in
          connect_task_failure) file_array+=("$root_folder/tools/log-analyzer/samples/connect-oracle-xstream-task-failure.log") ;;
          support_bundle) file_array+=("$root_folder/tools/log-analyzer/samples/support-bundle.zip") ;;
      esac
  done

  for file in "${file_array[@]}"
  do
      if [ ! -e "$file" ]
      then
          logerror "❌ <$file> does not exist, please make sure to use absolute full path or correct relative path !"
          exit 1
      fi
  done

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  # every distinct record, for the HTML report and --json (see summarize_log_errors)
  records_file="$tmp_dir/records"
  : > "$records_file"
  nb_files=0
  nb_files_with_findings=0
  nb_skipped=0
  nb_extracted=0

  # prints the digest of one log, read on stdin, when it has findings
  # $1: label to display
  function analyze_logs_digest () {
      label="$1"
      output=$(PG_LOG_DIGEST_RECORDS_FILE="$records_file" PG_LOG_DIGEST_LABEL="$label" summarize_log_errors "$max_findings" "$include_warnings")
      nb_files=$((nb_files+1))
      if [[ "$output" == "✅"* ]]
      then
          return
      fi
      nb_files_with_findings=$((nb_files_with_findings+1))
      log "🔥 ERROR/FATAL digest for $label"
      # there is no --since here
      echo "$output" | sed 's/ or narrow with --since$//'
      echo ""
  }

  # analyzes a file, a folder or an archive, recursively
  # $1: path, $2: label to display
  function analyze_logs_path () {
      local path="$1"
      local label="$2"
      local extract_dir
      local f

      if [ -d "$path" ]
      then
          while IFS= read -r -d '' f
          do
              if [[ "$label" == *":" ]]
              then
                  analyze_logs_path "$f" "${label}${f#$path/}"
              else
                  analyze_logs_path "$f" "${label%/}/${f#$path/}"
              fi
          done < <(find "$path" -type f ! -path "*/__MACOSX/*" ! -name ".DS_Store" -print0 | sort -z)
          return
      fi

      case "$path" in
          *.zip|*.tar|*.tar.gz|*.tgz)
              nb_extracted=$((nb_extracted+1))
              extract_dir="$tmp_dir/$nb_extracted"
              mkdir -p "$extract_dir"
              case "$path" in
                  *.zip) unzip -q -o "$path" -d "$extract_dir" > /dev/null 2>&1 ;;
                  *) tar -xf "$path" -C "$extract_dir" > /dev/null 2>&1 ;;
              esac
              if [ $? -ne 0 ]
              then
                  logwarn "⚠️ could not fully extract $label"
              fi
              analyze_logs_path "$extract_dir" "$label:"
              ;;
          *.gz)
              analyze_logs_digest "$label" < <(gzip -dc "$path" 2>/dev/null)
              ;;
          *)
              if grep -Iq . "$path" 2>/dev/null
              then
                  analyze_logs_digest "$label" < "$path"
              else
                  nb_skipped=$((nb_skipped+1))
              fi
              ;;
      esac
  }

  set +e
  for file in "${file_array[@]}"
  do
      analyze_logs_path "${file%/}" "${file%/}"
  done
  set -e

  levels="ERROR/FATAL"
  if [[ -n "$include_warnings" ]]
  then
      levels="ERROR/FATAL/WARN"
  fi
  if [ $nb_files_with_findings -eq 0 ]
  then
      log "✅ no $levels record found in $nb_files file(s) (binary files skipped: $nb_skipped)"
  else
      log "📊 $nb_files_with_findings file(s) with findings out of $nb_files scanned (binary files skipped: $nb_skipped)"
  fi

  if ! command -v python3 &>/dev/null
  then
      logwarn "⚠️ python3 is not on PATH: no HTML report"
      exit 0
  fi
  title="${file_array[*]}"
  if [[ ${#sample_array[@]} -gt 0 ]]
  then
      title="sample ${sample_array[*]}"
  fi
  report_args=(--records "$records_file" --title "$title" --levels "$levels" --skipped "$nb_skipped")
  if [[ -n "$json_out" ]]
  then
      python3 -I "$root_folder/tools/log-analyzer/log_report.py" "${report_args[@]}" --json >&3
      exit $?
  fi

  mkdir -p "$output_dir"
  output_dir=$(cd "$output_dir" && pwd)
  stem=$(basename "${file_array[0]%/}")
  stem="${stem%%.*}"
  if [[ ${#sample_array[@]} -gt 0 ]]
  then
      stem="${sample_array[0]}"
  fi
  write_log_records_report "$records_file" "$output_dir/${stem}-log-report.html" "" "${report_args[@]:2}"

}

# :command.function
playground_debug_gc_analyze_command() {

  # src/commands/analyze/gc-logs.sh
  eval "file_array=(${args[--file]})"
  eval "sample_array=(${args[--sample]})"
  container="${args[--container]}"
  output_dir="${args[--output-dir]}"
  json_out="${args[--json]}"
  top_pauses="${args[--top-pauses]}"
  run="${args[--run]}"

  # with --json, logs go to stderr and only the analysis to stdout (same as analyze flight-recorder)
  if [[ -n "$json_out" ]]; then
      exec 3>&1 1>&2
  fi

  set +e

  # ── Validate input: one of --file, --container or --sample ─────────────────
  nb_modes=0
  [[ ${#file_array[@]} -gt 0 ]] && nb_modes=$((nb_modes + 1))
  [[ ${#sample_array[@]} -gt 0 ]] && nb_modes=$((nb_modes + 1))
  [[ -n "$container" ]] && nb_modes=$((nb_modes + 1))
  if [[ $nb_modes -eq 0 ]]; then
      logerror "❌ Must provide one of --file <gc-log-file-or-folder>, --container <name> or --sample <name>"
      log ""
      log "Examples:"
      log "  playground analyze gc-logs --file kafkaServer-gc.log"
      log "  playground analyze gc-logs --container broker"
      log "  playground analyze gc-logs --sample jdk21_g1_kafka_real"
      exit 1
  fi
  if [[ $nb_modes -gt 1 ]]; then
      logerror "❌ Provide only one of --file, --container and --sample"
      exit 1
  fi

  # ── Sample mode: GC logs shipped with the analyzer ──
  for sample in "${sample_array[@]}"
  do
      file_array+=("$root_folder/gc-analysis/samples/${sample}.log")
  done

  analyzer="$root_folder/gc-analysis/gc_log_analyzer.py"
  if [[ ! -f "$analyzer" ]]; then
      logerror "❌ GC analyzer not found at: $analyzer"
      exit 1
  fi

  if ! command -v python3 &>/dev/null; then
      logerror "❌ python3 is required but not found on PATH"
      exit 1
  fi

  # ── Container mode: find the GC log and copy it with its rotated files ─────
  if [[ -n "$container" ]]; then
      log "🐳 Looking for the GC log in container: $container"

      # path from the java command line: -Xlog:gc*:file=<path>:... (JDK 9+) or -Xloggc:<path> (JDK 8)
      gc_log_path=$(playground --output-level ERROR container exec --container "$container" --command "cat /proc/[0-9]*/cmdline 2>/dev/null | tr '\\000' '\\n' | sed -n -e 's/^-Xlog:gc[^:]*:file=\"\\{0,1\\}\\([^:\"]*\\).*/\\1/p' -e 's/^-Xloggc:\\(.*\\)/\\1/p' | head -1" 2>/dev/null | tr -d '\r')

      if [[ -z "$gc_log_path" ]]; then
          log "🔍 No -Xlog:gc / -Xloggc flag found, searching common log locations..."
          gc_log_path=$(playground --output-level ERROR container exec --container "$container" --command "find /usr/logs /var/log /tmp /opt /home -maxdepth 4 -type f -name '*gc*.log*' 2>/dev/null | head -1" 2>/dev/null | tr -d '\r')
      fi

      if [[ -z "$gc_log_path" ]]; then
          logerror "❌ Could not locate a GC log in container '$container'"
          log ""
          log "💡 The playground environments pass -loggc to ZooKeeper, brokers, controllers, Schema Registry and Connect"
          log "   (GC log in /var/log/kafka/<name>-gc.log, /usr/logs for Schema Registry), and ksqlDB writes one by default. If this container has none, it was"
          log "   started before that change (playground re-run) or its EXTRA_ARGS is overridden by the example."
          log "   To enable it on a running container (this replaces the current KAFKA_OPTS value, if any):"
          log "   playground container set-environment-variables --container $container --env \"KAFKA_OPTS: -Xlog:gc*:file=/tmp/gc.log:time,uptime,level,tags:filecount=5,filesize=20m\""
          log "   JDK 8: -XX:+PrintGCDetails -XX:+PrintGCDateStamps -XX:+PrintGCTimeStamps -Xloggc:/tmp/gc.log"
          exit 1
      fi

      # rotated files: <path>, <path>.0..N (JDK 9+), <path>.N.current (JDK 8)
      base="${gc_log_path%.current}"
      base=$(echo "$base" | sed -E 's/\.[0-9]+$//')
      log "📄 Found GC log: $gc_log_path"

      tmp_dir="$output_dir/gc-logs-${container}-$(date '+%Y%m%d-%H%M%S')"
      mkdir -p "$tmp_dir"
      nb_copied=0
      while read -r f
      do
          [[ -z "$f" ]] && continue
          if playground --output-level ERROR container cp --source "${container}:${f}" --destination "$tmp_dir/$(basename "$f")" > /dev/null 2>&1; then
              nb_copied=$((nb_copied+1))
          fi
      done < <(playground --output-level ERROR container exec --container "$container" --command "ls -1d ${base} ${base}.* 2>/dev/null" 2>/dev/null | tr -d '\r')

      if [[ $nb_copied -eq 0 ]]; then
          logerror "❌ Failed to copy the GC log from container '$container'"
          exit 1
      fi
      log "✅ $nb_copied GC log file(s) copied to: $tmp_dir"
      file_array=("$tmp_dir")
  fi

  # Handle fzf @path trick
  for i in "${!file_array[@]}"
  do
      if [[ ! -e "${file_array[$i]}" && "${file_array[$i]}" == *"@"* ]]; then
          file_array[$i]=$(echo "${file_array[$i]}" | cut -d "@" -f 2)
      fi
  done

  analyzer_args=("${file_array[@]}" --top-pauses "$top_pauses")
  if [[ -n "$run" ]]; then
      analyzer_args+=(--run "$run")
  fi

  if [[ -n "$json_out" ]]; then
      python3 -I "$analyzer" "${analyzer_args[@]}" --json >&3
      exit $?
  fi

  log "📈 Analyzing GC log: ${file_array[*]}"
  log ""

  html_out=""
  # the HTML report is always written (not with --json: stdout must stay JSON)
  if [[ -z "$json_out" ]]; then
      mkdir -p "$output_dir"
      output_dir_abs=$(cd "$output_dir" && pwd)
      first=$(basename "${file_array[0]}")
      html_out="${output_dir_abs}/${first%.log}-gc-report.html"
      analyzer_args+=(--html-out "$html_out")
  fi

  python3 -I "$analyzer" "${analyzer_args[@]}"
  exit_code=$?

  if [[ $exit_code -ne 0 ]]; then
      logerror "❌ GC log analysis failed (exit code $exit_code)"
      exit $exit_code
  fi

  if [[ -n "$html_out" && -f "$html_out" ]]; then
      log ""
      log "✅ HTML report saved: $html_out"
      # only open a browser in an interactive terminal
      if [[ -t 1 ]] && command -v open &>/dev/null; then
          log "🌐 Opening report in browser..."
          open "$html_out"
      else
          log "🔗 Open in browser: file://$html_out"
      fi
  fi

  exit 0

}

# :command.function
playground_debug_tcp_dump_command() {

  # src/commands/debug/tcp-dump.sh
  eval "containers=(${args[--container]})"
  port="${args[--port]}"
  filter="${args[--filter]}"
  duration="${args[--duration]}"
  snaplen="${args[--snaplen]}"
  action="${args[--action]}"
  output_dir="${args[--output-dir]}"
  no_analyze="${args[--no-analyze]}"
  no_open="${args[--no-open]}"

  get_environment_used

  #
  # tcpdump runs from the netshoot image in the network namespace of each container (an ephemeral container of the pod
  # with cfk): nothing is installed in the container, so it works with any image. The capture container stays up after
  # tcpdump stops, so that the capture can be copied out (no bind mount: no root-owned files, no shared folder needed),
  # then it is removed. playground analyze tcp-dump then analyzes each capture.
  #
  #   -U --immediate-mode   every packet is written as soon as it is captured: none is lost when the capture stops
  #   timeout -s INT        tcpdump stops by itself after --duration and closes the file properly
  #

  capture_script='mkdir -p /captures
  set -- -i any -U --immediate-mode -w "/captures/$TCPDUMP_FILE"
  if [ -n "$TCPDUMP_SNAPLEN" ]; then set -- "$@" -s "$TCPDUMP_SNAPLEN"; fi
  if [ -n "$TCPDUMP_FILTER" ]; then set -- "$@" "$TCPDUMP_FILTER"; fi
  if [ -n "$TCPDUMP_TIMEOUT" ]
  then
      timeout -s INT "$TCPDUMP_TIMEOUT" tcpdump "$@" 2> /captures/tcpdump.log
  else
      tcpdump "$@" 2> /captures/tcpdump.log
  fi
  touch /captures/.done
  exec sleep 3600'

  if [[ -n "$port" ]] && [[ -n "$filter" ]]
  then
      expression="port $port and ($filter)"
  elif [[ -n "$port" ]]
  then
      expression="port $port"
  else
      expression="$filter"
  fi

  duration_seconds=$(duration_to_seconds "$duration")
  if [[ -z "$action" ]] && [[ "$duration_seconds" -le 0 ]]
  then
      logerror "❌ --duration must be greater than 0"
      exit 1
  fi
  if [[ -n "$snaplen" ]] && [[ "$snaplen" -le 0 ]]
  then
      logerror "❌ --snaplen must be greater than 0"
      exit 1
  fi

  if [ "$action" == "start" ] || [ -z "$action" ]
  then
      if [[ "$environment" != cfk* ]] && ! docker image inspect $PLAYGROUND_NETSHOOT_IMAGE > /dev/null 2>&1
      then
          log "📥 pulling $PLAYGROUND_NETSHOOT_IMAGE (network tools image, only the first time)"
          docker pull $PLAYGROUND_NETSHOOT_IMAGE > /dev/null
      fi
  fi

  #
  # backend: a capture is identified by a handle, the name of the capture container (docker, podman) or <pod>/<ephemeral
  # container> (cfk)
  #
  function capture_start () {
      local container=$1
      local file=$2
      local timeout_seconds=$3
      local handle
      local pod_name
      local target_container
      local debug_container
      local debug_custom_file

      if [[ "$environment" == cfk* ]]
      then
          pod_name=$(resolve_container_name_for_environment "$container")
          target_container=$(kubectl -n confluent get pod "$pod_name" -o jsonpath='{.spec.containers[0].name}' 2> /dev/null)
          if [[ -z "$target_container" ]]
          then
              logerror "❌ pod $pod_name not found" >&2
              return 1
          fi
          debug_container="pg-tcpdump-$(date +%s)"
          debug_custom_file=$(mktemp -t pg-cfk-netshoot-XXXXXXXXXX.yaml)
          printf 'securityContext:\n  runAsUser: 0\n  runAsNonRoot: false\n' > "$debug_custom_file"
          if ! kubectl -n confluent debug "pod/$pod_name" --attach=false --profile=sysadmin --custom="$debug_custom_file" \
              --image=$PLAYGROUND_NETSHOOT_IMAGE --target="$target_container" --container="$debug_container" \
              --env="TCPDUMP_FILE=$file" --env="TCPDUMP_FILTER=$expression" --env="TCPDUMP_SNAPLEN=$snaplen" --env="TCPDUMP_TIMEOUT=$timeout_seconds" \
              -- sh -c "$capture_script" > /dev/null
          then
              rm -f "$debug_custom_file"
              logerror "❌ could not start an ephemeral container in pod $pod_name" >&2
              return 1
          fi
          rm -f "$debug_custom_file"
          handle="$pod_name/$debug_container"
      else
          handle="pg-tcpdump-$container"
          if docker inspect "$handle" > /dev/null 2>&1
          then
              logerror "❌ a capture is already running on $container (container $handle): stop it with --action stop" >&2
              return 1
          fi
          if ! docker run -d --name "$handle" --network "container:$container" --cap-add NET_RAW --cap-add NET_ADMIN \
              -e "TCPDUMP_FILE=$file" -e "TCPDUMP_FILTER=$expression" -e "TCPDUMP_SNAPLEN=$snaplen" -e "TCPDUMP_TIMEOUT=$timeout_seconds" \
              $PLAYGROUND_NETSHOOT_IMAGE sh -c "$capture_script" > /dev/null
          then
              logerror "❌ could not start the capture container in the network namespace of $container" >&2
              return 1
          fi
      fi
      echo "$handle"
  }

  function capture_exec () {
      local handle=$1
      shift
      if [[ "$environment" == cfk* ]]
      then
          kubectl -n confluent exec -i "${handle%%/*}" -c "${handle#*/}" -- "$@"
      else
          docker exec -i "$handle" "$@"
      fi
  }

  function capture_copy_in () {
      local handle=$1
      local source=$2
      local destination=$3
      capture_exec "$handle" sh -c "cat > '$destination'" < "$source"
  }

  function capture_copy_out () {
      local handle=$1
      local source=$2
      local destination=$3
      capture_exec "$handle" cat "$source" > "$destination"
  }

  function capture_remove () {
      local handle=$1
      if [[ "$environment" == cfk* ]]
      then
          # an ephemeral container can't be removed from its pod: ending its last process stops it
          capture_exec "$handle" pkill sleep > /dev/null 2>&1
      else
          docker rm -f "$handle" > /dev/null 2>&1
      fi
  }

  function capture_is_running () {
      capture_exec "$1" sh -c "pgrep tcpdump > /dev/null" > /dev/null 2>&1
  }

  # waits until tcpdump listens (or fails): a bad --filter or interface stops it at once
  function capture_wait_listening () {
      local handle=$1
      local container=$2
      local log
      for _ in $(seq 1 20)
      do
          log=$(capture_exec "$handle" cat /captures/tcpdump.log 2> /dev/null)
          if [[ "$log" == *"listening on"* ]]
          then
              return 0
          fi
          if capture_exec "$handle" test -f /captures/.done > /dev/null 2>&1
          then
              break
          fi
          sleep 1
      done
      logerror "❌ tcpdump did not start on $container${expression:+ with filter '$expression'}"
      # the warning about the promiscuous mode of the any device is printed every time
      echo "$log" | grep -v -i "promiscuous"
      return 1
  }

  # ip address → name of every container (or pod and service), for tshark and Wireshark name resolution
  function write_hosts_file () {
      local destination=$1
      local name
      local ip
      if [[ "$environment" == cfk* ]]
      then
          {
              kubectl -n confluent get pods -o jsonpath='{range .items[*]}{.status.podIP}{"\t"}{.metadata.name}{"\n"}{end}' 2> /dev/null
              kubectl -n confluent get svc -o jsonpath='{range .items[*]}{.spec.clusterIP}{"\t"}{.metadata.name}{"\n"}{end}' 2> /dev/null
          } | awk -F '\t' '$1 != "" && $1 != "None" && !seen[$1]++' > "$destination"
      else
          : > "$destination"
          for name in $(docker ps --format '{{.Names}}' | grep -v '^pg-tcpdump-')
          do
              for ip in $(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' "$name" 2> /dev/null)
              do
                  printf '%s\t%s\n' "$ip" "$name" >> "$destination"
              done
          done
      fi
  }

  # stops the capture (if still running), writes the pcap and the hosts file in --output-dir, then analyzes the capture
  function capture_collect () {
      local container=$1
      local handle=$2
      local file=$3
      local local_file="$output_dir/$file"
      local hosts_file="${local_file%.pcap}.hosts"
      local stats

      capture_exec "$handle" pkill -INT tcpdump > /dev/null 2>&1
      for _ in $(seq 1 30)
      do
          if capture_exec "$handle" test -f /captures/.done > /dev/null 2>&1
          then
              break
          fi
          sleep 1
      done

      if ! capture_copy_out "$handle" "/captures/$file" "$local_file" || [ ! -s "$local_file" ]
      then
          logerror "❌ the capture of $container could not be copied"
          capture_exec "$handle" cat /captures/tcpdump.log 2> /dev/null
          capture_remove "$handle"
          return 1
      fi

      # tcpdump prints "N packets captured", "M packets dropped by kernel" when it stops
      stats=$(capture_exec "$handle" cat /captures/tcpdump.log 2> /dev/null | grep -E "packets (captured|dropped by kernel)" | tr '\n' ',' | sed 's/,$//; s/,/, /g')
      log "🌶️ capture of $container: $local_file${stats:+ ($stats)}"
      if [[ "$stats" =~ ([1-9][0-9]*)\ packets\ dropped\ by\ kernel ]]
      then
          logwarn "⚠️ the kernel dropped packets: narrow the capture with --port / --filter, or reduce --snaplen"
      fi

      write_hosts_file "$hosts_file"
      capture_remove "$handle"
      collected_files+=("$local_file")
  }

  # playground analyze tcp-dump: text digest, findings and HTML report next to each capture
  function analyze_captures () {
      local file
      if [[ -n "$no_analyze" ]]
      then
          for file in "${collected_files[@]}"
          do
              log "🔎 analyze it with: playground analyze tcp-dump -f $file"
          done
          return
      fi
      for file in "${collected_files[@]}"
      do
          log "🔎 analyzing $file (--no-analyze to skip it)"
          playground analyze tcp-dump -f "$file" --output-dir "$output_dir"
          # 2: the capture has no packet, already explained by the analysis
          case $? in
              0|2) ;;
              *) logwarn "⚠️ the capture could not be analyzed, open it with Wireshark" ;;
          esac
      done
  }

  function capture_file_name () {
      echo "tcp-dump-${1}-${port:-all-ports}-$(date '+%Y-%m-%d-%H-%M-%S').pcap"
  }

  # opens the captures in Wireshark, in the background, when it runs in a terminal
  function open_in_wireshark () {
      local file
      if [[ ${#collected_files[@]} -eq 0 ]] || [[ -n "$no_open" ]] || [ -n "$GITHUB_RUN_NUMBER" ] || [ ! -t 1 ]
      then
          return
      fi
      log "🏷️ each .hosts file maps the ip addresses to container names: to see the names in Wireshark, copy it as 'hosts' into the Wireshark personal configuration folder (Help → About Wireshark → Folders) and enable View → Name Resolution → Resolve Network Addresses"
      if [[ "$(uname)" == "Darwin" ]] && [ -d "/Applications/Wireshark.app" ]
      then
          for file in "${collected_files[@]}"
          do
              log "🦈 opening $file with Wireshark (--no-open to skip it)"
              open -a Wireshark "$file"
          done
      elif command -v wireshark > /dev/null 2>&1
      then
          for file in "${collected_files[@]}"
          do
              log "🦈 opening $file with Wireshark (--no-open to skip it)"
              nohup wireshark "$file" > /dev/null 2>&1 &
          done
      else
          log "🦈 open the captures with Wireshark: https://www.wireshark.org/"
      fi
  }

  # true when the container was (re)started after the capture began: the capture stays in the network namespace of the
  # previous run of the container and sees nothing new (with cfk, a pod restart removes the ephemeral container)
  function target_restarted_since () {
      local container=$1
      local since=$2
      local started_at
      local started_epoch
      if [[ "$environment" == cfk* ]]
      then
          return 1
      fi
      started_at=$(docker inspect -f '{{.State.StartedAt}}' "$container" 2> /dev/null)
      started_at=${started_at%%.*}
      started_at=${started_at%Z}
      started_epoch=$(date -u -d "$started_at" +%s 2> /dev/null || date -u -j -f "%Y-%m-%dT%H:%M:%S" "$started_at" +%s 2> /dev/null)
      [[ -n "$started_epoch" ]] && [[ "$started_epoch" -gt "$since" ]]
  }

  function format_epoch () {
      date -r "$1" "$2" 2> /dev/null || date -d "@$1" "$2" 2> /dev/null || echo "$1"
  }

  mkdir -p "$output_dir"
  output_dir=$(cd "$output_dir" && pwd)
  collected_files=()
  failed=0

  case "$action" in
      "")
          # 1. every capture starts at the same time, so that both sides of a connection can be compared
          handles=()
          files=()
          started=()
          for container in "${containers[@]}"
          do
              file=$(capture_file_name "$container")
              if ! handle=$(capture_start "$container" "$file" "$duration_seconds")
              then
                  failed=1
                  continue
              fi
              if ! capture_wait_listening "$handle" "$container"
              then
                  capture_remove "$handle"
                  failed=1
                  continue
              fi
              handles+=("$handle")
              files+=("$file")
              started+=("$container")
          done
          if [[ ${#started[@]} -eq 0 ]]
          then
              exit 1
          fi

          log "🕵️‍♂️ capturing the traffic of ${started[*]}${expression:+ ($expression)} for ${duration_seconds} seconds, reproduce the issue now (Ctrl+C stops it earlier and keeps the capture)"

          # 2. wait, Ctrl+C included
          interrupted=""
          trap 'interrupted=1' INT
          end=$((SECONDS + duration_seconds))
          while [ $SECONDS -lt $end ] && [ -z "$interrupted" ]
          do
              sleep 1
          done
          trap - INT
          if [ -n "$interrupted" ]
          then
              log "✋ stopped after $((duration_seconds - (end - SECONDS))) seconds"
          fi

          # 3. stop, copy, summarize
          for i in "${!handles[@]}"
          do
              capture_collect "${started[$i]}" "${handles[$i]}" "${files[$i]}" || failed=1
          done
          analyze_captures
          open_in_wireshark
          ;;
      start)
          for container in "${containers[@]}"
          do
              state=$(playground state get "tcp_dump.$container" 2> /dev/null)
              if [[ -n "$state" ]]
              then
                  read -r handle file started_at <<< "$state"
                  logwarn "🕵️‍♂️ a capture is already running on $container (since $(format_epoch "$started_at" '+%H:%M:%S')): stop it with --action stop"
                  continue
              fi
              file=$(capture_file_name "$container")
              if ! handle=$(capture_start "$container" "$file" "")
              then
                  failed=1
                  continue
              fi
              if ! capture_wait_listening "$handle" "$container"
              then
                  capture_remove "$handle"
                  failed=1
                  continue
              fi
              playground state set "tcp_dump.$container" "$handle $file $(date +%s)"
              log "🕵️‍♂️ capturing the traffic of $container${expression:+ ($expression)}: stop it with playground debug tcp-dump -c $container --action stop"
          done
          ;;
      stop)
          for container in "${containers[@]}"
          do
              state=$(playground state get "tcp_dump.$container" 2> /dev/null)
              if [[ -z "$state" ]]
              then
                  logwarn "🤷 no capture started on $container with --action start"
                  continue
              fi
              read -r handle file started_at <<< "$state"
              playground state del "tcp_dump.$container" > /dev/null 2>&1
              log "✋ stopping the capture of $container, started at $(format_epoch "$started_at" '+%H:%M:%S')"
              if target_restarted_since "$container" "$started_at"
              then
                  logwarn "⚠️ $container was restarted after the capture started: it only has the traffic before the restart"
              fi
              capture_collect "$container" "$handle" "$file" || failed=1
          done
          analyze_captures
          open_in_wireshark
          ;;
      status)
          for container in "${containers[@]}"
          do
              state=$(playground state get "tcp_dump.$container" 2> /dev/null)
              if [[ -z "$state" ]]
              then
                  log "💤 no capture running on $container"
                  continue
              fi
              read -r handle file started_at <<< "$state"
              if target_restarted_since "$container" "$started_at"
              then
                  logwarn "⚠️ $container was restarted after the capture started at $(format_epoch "$started_at" '+%H:%M:%S'): the capture only has the traffic before the restart, --action stop collects it, then start a new one"
              elif capture_is_running "$handle"
              then
                  log "🕵️‍♂️ capturing the traffic of $container since $(format_epoch "$started_at" '+%H:%M:%S') ($file)"
              else
                  logwarn "⚠️ the capture of $container started at $(format_epoch "$started_at" '+%H:%M:%S') is no longer running (container restarted?): --action stop collects what was captured"
              fi
          done
          ;;
  esac

  if [ $failed -eq 1 ]
  then
      exit 1
  fi

}

# :command.function
playground_debug_block_traffic_command() {

  # src/commands/debug/block-traffic.sh
  containers="${args[--container]}"
  port="${args[--port]}"
  destination="${args[--destination]}"
  action="${args[--action]}"

  get_environment_used

  # Convert space-separated string to array
  IFS=' ' read -ra container_array <<< "$containers"
  resolved_container_array=()
  for container in "${container_array[@]}"
  do
  	resolved_container_array+=("$(resolve_container_name_for_environment "$container")")
  done

  install_iptables_if_needed() {
  	local container=$1

  	if [[ "$environment" == cfk* ]]
  	then
  		return
  	fi

  	set +e
  	playground --output-level ERROR container exec --container "$container" --command "type iptables" > /dev/null 2>&1
  	if [ $? != 0 ]
  	then
  		tag=$(get_running_cp_tag)
  		if [ $? != 0 ] || [ "$tag" == "" ]
  		then
  			logerror "Could not find current CP version from docker ps"
  			exit 1
  		fi
  		logwarn "iptables is not installed on container $container, attempting to install it"
  		if [[ "$tag" == *ubi8 ]] || version_gt $tag "5.9.0"
  		then
  		  docker exec --privileged --user root $container bash -c "yum -y install --disablerepo='Confluent*' iptables"
  		else
  		  docker exec --privileged --user root $container bash -c "apt-get update && echo iptables | xargs -n 1 apt-get install --force-yes -y && rm -rf /var/lib/apt/lists/*"
  		fi
  	fi
  	playground --output-level ERROR container exec --container "$container" --command "type iptables" > /dev/null 2>&1
  	if [ $? != 0 ]
  	then
  		logerror "❌ iptables could not be installed on container $container"
  		exit 1
  	fi
  	set -e
  }

  for container in "${resolved_container_array[@]}"
  do
  	install_iptables_if_needed "$container"
  done

  mapfile -t destination_ips < <(resolve_traffic_destination_ips "$destination")

  if [[ ${#destination_ips[@]} -eq 0 ]]
  then
  	logerror "❌ Unable to determine destination IPs for $destination"
  	exit 1
  fi

  deduped_destination_ips=()
  for ip in "${destination_ips[@]}"
  do
  	if [[ ! " ${deduped_destination_ips[*]} " =~ " ${ip} " ]]
  	then
  		deduped_destination_ips+=("$ip")
  	fi
  done
  destination_ips=("${deduped_destination_ips[@]}")

  ip_display=$(printf "%s " "${destination_ips[@]}")
  ip_display=${ip_display% }

  case "${action}" in
  	start)
  		action="A"
  		if [[ -n "$port" ]]
  		then
  			log "🚫 Blocking traffic on containers ${containers} and port ${port} for destination ${destination} (${ip_display})"
  		else
  			log "🚫 Blocking traffic on containers ${containers} for all ports for destination ${destination} (${ip_display})"
  		fi
  	;;
  	stop)
  		action="D"
  		if [[ -n "$port" ]]
  		then
  			log "🟢 Unblocking traffic on containers ${containers} and port ${port} for destination ${destination} (${ip_display})"
  		else
  			log "🟢 Unblocking traffic on containers ${containers} for all ports from destination ${destination} (${ip_display})"
  		fi
  	;;
  	*)
  		logerror "should not happen"
  		exit 1
  	;;
  esac

  for container in "${resolved_container_array[@]}"
  do
  	log "Applying iptables rule to container: $container"
  	for ip in "${destination_ips[@]}"
  	do
  		if [[ -n "$port" ]]
  		then
  			if [[ "$environment" == cfk* ]]
  			then
  					rule_cmd="iptables -${action} OUTPUT -p tcp -d ${ip} --dport ${port} -j DROP"
  					check_cmd="iptables -C OUTPUT -p tcp -d ${ip} --dport ${port} -j DROP"
  					run_cfk_netshoot_command "$container" "$rule_cmd"
  					if [[ "$action" == "A" ]]
  					then
  						run_cfk_netshoot_command "$container" "$check_cmd"
  					fi
  			else
  				docker exec --privileged --user root ${container} bash -c "iptables -${action} OUTPUT -p tcp -d ${ip} --dport ${port} -j DROP"
  			fi
  		else
  			if [[ "$environment" == cfk* ]]
  			then
  					rule_cmd="iptables -${action} OUTPUT -d ${ip} -j DROP"
  					check_cmd="iptables -C OUTPUT -d ${ip} -j DROP"
  					run_cfk_netshoot_command "$container" "$rule_cmd"
  					if [[ "$action" == "A" ]]
  					then
  						run_cfk_netshoot_command "$container" "$check_cmd"
  					fi
  			else
  				docker exec --privileged --user root ${container} bash -c "iptables -${action} OUTPUT -d ${ip} -j DROP"
  			fi
  		fi
  	done

  	log "Output of command iptables-save for container $container"
  	if [[ "$environment" == cfk* ]]
  	then
  		run_cfk_netshoot_command "$container" "iptables-save" "true"
  	else
  		docker exec --privileged --user root ${container} bash -c "iptables-save"
  	fi
  done

}

# :command.function
playground_debug_degrade_traffic_command() {

  # src/commands/debug/degrade-traffic.sh
  eval "containers=(${args[--container]})"
  destination="${args[--destination]}"
  port="${args[--port]}"
  latency="${args[--latency]}"
  jitter="${args[--jitter]}"
  loss="${args[--loss]}"
  corruption="${args[--corruption]}"
  duplicate="${args[--duplicate]}"
  rate="${args[--rate]}"
  action="${args[--action]}"

  get_environment_used

  # 1. the netem parameters
  time_pattern="^[0-9]+(\.[0-9]+)?(us|ms|s)$"
  percent_pattern="^[0-9]+(\.[0-9]+)?%$"
  rate_pattern="^[0-9]+(\.[0-9]+)?(bit|kbit|mbit|gbit|bps|kbps|mbps|gbps)$"
  for check in "--latency@$latency@$time_pattern@100ms" "--jitter@$jitter@$time_pattern@20ms" "--loss@$loss@$percent_pattern@1%" "--corruption@$corruption@$percent_pattern@1%" "--duplicate@$duplicate@$percent_pattern@1%" "--rate@$rate@$rate_pattern@1mbit"
  do
      IFS='@' read -r flag value pattern sample <<< "$check"
      if [[ -n "$value" ]] && [[ ! "$value" =~ $pattern ]]
      then
          logerror "❌ $flag $value is not valid, example: $flag $sample"
          exit 1
      fi
  done
  if [[ -n "$jitter" ]] && [[ -z "$latency" ]]
  then
      logerror "❌ --jitter needs --latency"
      exit 1
  fi

  netem=""
  description=""
  if [[ -n "$latency" ]]
  then
      netem="$netem delay $latency${jitter:+ $jitter}"
      description="$description, ${latency}${jitter:+ ± $jitter} latency"
  fi
  if [[ -n "$loss" ]]
  then
      netem="$netem loss $loss"
      description="$description, $loss packet loss"
  fi
  if [[ -n "$corruption" ]]
  then
      netem="$netem corrupt $corruption"
      description="$description, $corruption packet corruption"
  fi
  if [[ -n "$duplicate" ]]
  then
      netem="$netem duplicate $duplicate"
      description="$description, $duplicate packet duplication"
  fi
  if [[ -n "$rate" ]]
  then
      netem="$netem rate $rate"
      description="$description, $rate bandwidth"
  fi
  description="${description#, }"

  if [ "$action" == "start" ] && [[ -z "$netem" ]]
  then
      logerror "❌ --action start needs at least one of --latency, --loss, --corruption, --duplicate or --rate"
      exit 1
  fi
  if [ "$action" != "start" ] && [[ -n "$netem" ]]
  then
      logwarn "🤷 --latency, --loss, --corruption, --duplicate and --rate are only used with --action start"
  fi
  if [[ -n "$port" ]] && [[ -z "$destination" ]]
  then
      logerror "❌ --port needs --destination"
      exit 1
  fi

  # 2. the destination
  destination_ips=()
  if [[ -n "$destination" ]]
  then
      mapfile -t destination_ips < <(resolve_traffic_destination_ips "$destination")
      if [[ ${#destination_ips[@]} -eq 0 ]]
      then
          logerror "❌ Unable to determine destination IPs for $destination"
          exit 1
      fi
  fi
  ip_display=$(printf "%s " "${destination_ips[@]}")
  ip_display=${ip_display% }

  if [[ -n "$destination" ]]
  then
      target="to $destination ($ip_display)${port:+ port $port}"
  else
      target="to any destination"
  fi

  #
  # 3. the tc commands, run in the network namespace of each container
  #
  # - with a destination: a prio qdisc whose band 1:1 (the destination, and port) goes through
  #   netem and band 1:2 (everything else) through sfq, unchanged
  # - without: netem as root qdisc of the interface of the default route
  # tc only shapes outgoing packets: the round trip to the destination grows by the latency.
  #
  # the interface: the one of the route to the destination (containers on several networks
  # have several), the one of the default route otherwise
  interface_cmd="ip route get ${destination_ips[0]:-1.1.1.1} 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1"

  case "$action" in
      start)
          cmd="dev=\$($interface_cmd); [ -n \"\$dev\" ] || { echo 'no network interface found' >&2; exit 1; }; tc qdisc del dev \$dev root 2>/dev/null;"
          if [[ -n "$destination" ]]
          then
              cmd="$cmd tc qdisc add dev \$dev root handle 1: prio && tc qdisc add dev \$dev parent 1:1 handle 10: netem$netem && tc qdisc add dev \$dev parent 1:2 handle 20: sfq"
              for ip in "${destination_ips[@]}"
              do
                  if [[ -n "$port" ]]
                  then
                      cmd="$cmd && tc filter add dev \$dev protocol ip parent 1: prio 1 u32 match ip dst $ip/32 match ip dport $port 0xffff flowid 1:1"
                  else
                      cmd="$cmd && tc filter add dev \$dev protocol ip parent 1: prio 1 u32 match ip dst $ip/32 flowid 1:1"
                  fi
              done
              # everything else (ip and icmp) to the band without degradation
              cmd="$cmd && tc filter add dev \$dev protocol all parent 1: prio 2 u32 match ip dst 0.0.0.0/0 flowid 1:2 && tc filter add dev \$dev protocol all parent 1: prio 2 u32 match ip protocol 1 0xff flowid 1:2"
          else
              cmd="$cmd tc qdisc add dev \$dev root netem$netem"
          fi
          ;;
      stop)
          # every interface but lo; 'Cannot delete qdisc with handle of zero' only means there was nothing
          cmd="for dev in \$(ls /sys/class/net | grep -v '^lo\$'); do tc qdisc del dev \$dev root 2>/dev/null; done; true"
          ;;
      status)
          cmd="for dev in \$(ls /sys/class/net | grep -v '^lo\$'); do tc qdisc show dev \$dev | grep -E 'netem|prio|sfq' | sed \"s/^/\$dev: /\"; done; true"
          ;;
  esac

  # round trip measured from the container, to show the effect: ping, or the time of a tcp
  # connection when --port is set (only that tcp traffic is degraded, not icmp)
  function measure_round_trip() {
      local container=$1
      local output
      local average
      if [[ -z "$destination" ]]
      then
          return
      fi
      if [[ -n "$port" ]]
      then
          output=$(run_in_network_namespace "$container" "bash -c 'for i in 1 2 3 4; do s=\$EPOCHREALTIME; if timeout 5 bash -c \"exec 3<>/dev/tcp/${destination_ips[0]}/$port\" 2>/dev/null; then e=\$EPOCHREALTIME; echo \"tcp \$s \$e\"; fi; done'" 2>&1 || true)
          average=$(echo "$output" | awk '$1 == "tcp" { total += ($3 - $2) * 1000; n++ } END { if (n > 0) printf "%.3f", total / n }')
          if [[ -n "$average" ]]
          then
              log "⏱️ tcp connection time from $container to $destination:$port: $average ms (average of $(echo "$output" | grep -c "^tcp") connections)"
          else
              logwarn "⏱️ no tcp connection to $destination:$port could be opened in 5 seconds"
          fi
          return
      fi
      output=$(run_in_network_namespace "$container" "ping -c 4 -i 0.3 -W 2 ${destination_ips[0]} 2>&1 | tail -2" 2>&1 || true)
      if grep -q "rtt" <<< "$output"
      then
          log "⏱️ round trip from $container to $destination: $(echo "$output" | grep rtt | awk -F '/' '{ print $5 }') ms (average of 4 pings)"
      else
          loss_line=$(echo "$output" | grep "packet loss" || true)
          logwarn "⏱️ no ping answer from $destination${loss_line:+ ($loss_line)}"
      fi
  }

  for container in "${containers[@]}"
  do
      container=$(resolve_container_name_for_environment "$container")
      case "$action" in
          start)
              log "🐌 Applying $description on container $container $target"
              ;;
          stop)
              log "🟢 Removing the traffic degradation of container $container"
              ;;
          status)
              log "🔎 Traffic degradation of container $container"
              ;;
      esac

      set +e
      output=$(run_in_network_namespace "$container" "$cmd" 2>&1)
      ret=$?
      set -e
      if [ $ret -ne 0 ]
      then
          logerror "❌ tc failed on container $container"
          echo "$output"
          exit 1
      fi

      case "$action" in
          start)
              measure_round_trip "$container"
              ;;
          stop)
              log "✅ traffic of container $container is back to normal"
              measure_round_trip "$container"
              ;;
          status)
              if grep -q "netem" <<< "$output"
              then
                  echo "$output" | grep "netem" | sed -e 's/^/   /' -e 's/ seed [0-9]*//'
              else
                  log "✅ no degradation applied on container $container"
              fi
              measure_round_trip "$container"
              ;;
      esac
  done

}

# :command.function
playground_debug_java_debug_command() {

  # src/commands/debug/java-debug.sh
  containers="${args[--container]}"
  type="${args[--type]}"
  action="${args[--action]}"

  # Convert space-separated string to array
  IFS=' ' read -ra container_array <<< "$containers"

  for container in "${container_array[@]}"
  do
  	if [[ "$action" == "enable" ]]
  	then
  		case "${type}" in
  			"ssl_all")
  				OPTS="-Djavax.net.debug=all"
  			;;
  			"ssl_handshake")
  				OPTS="-Djavax.net.debug=ssl:handshake"
  			;;
  			"class_loading")
  				OPTS="-verbose:class"
  			;;
  			"kerberos")
  				OPTS="-Dsun.security.krb5.debug=true"
  			;;
  		esac

  		playground container set-environment-variables --container "${container}" --env "KAFKA_OPTS: ${OPTS}"
  	else
  		playground container set-environment-variables --container "${container}" --restore-original-values
  	fi
  done
}

# :command.function
playground_debug_jscissors_command() {

  # src/commands/debug/jscissors.sh
  containers="${args[--container]}"
  action="${args[--action]}"
  # Convert the space delimited strings to arrays
  eval "operations=(${args[--operation]})"
  eval "classes=(${args[--class]})"
  eval "methods=(${args[--method]})"
  config_file="${args[--config-file]}"
  duration="${args[--duration]}"
  restart="${args[--restart]}"
  pid="${args[--pid]}"
  max_calls="${args[--max-calls]}"
  max_calls_per_method="${args[--max-calls-per-method]}"
  max_value_length="${args[--max-value-length]}"
  only_failed="${args[--only-failed]}"
  slower_than="${args[--slower-than]}"
  output_dir="${args[--output-dir]}"
  no_analyze="${args[--no-analyze]}"

  # names of jscissors 1.0
  case "$action" in
      enable) action="start" ;;
      disable) action="stop" ;;
  esac

  get_environment_used

  # Convert space-separated string to array
  IFS=' ' read -ra container_array <<< "$containers"

  # in the container: the agent, its rules and the files of the session (out/pid-<pid>/)
  remote_dir="/tmp/jscissors"
  agent_args="config=$remote_dir/jscissors.props,out=$remote_dir/out"

  function format_epoch () {
      date -r "$1" "$2" 2> /dev/null || date -d "@$1" "$2" 2> /dev/null || echo "$1"
  }

  function jmx_port_of () {
      if [[ "$environment" == cfk* ]]
      then
          return 0
      fi
      docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$1" 2> /dev/null | sed -n 's/^[A-Z_]*JMX_PORT=//p' | head -1
  }

  function in_container () {
      playground --output-level ERROR container exec --container "$1" --command "$2"
  }

  # loads the agent in the running JVM of the container (jscissors.Attach), with the agent arguments $2
  function attach () {
      local container="$1" arguments="$2" port jmx_arg=""
      port=$(jmx_port_of "$container")
      if [[ -n "$port" ]]
      then
          jmx_arg="--jmx localhost:$port"
      fi
      in_container "$container" "env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS java -Xmx64m -cp $remote_dir/jscissors.jar jscissors.Attach --pid $pid $jmx_arg --agent-args $arguments"
  }

  # summary.json of the traced JVM: with --restart, every JVM started in the container (kafka tools...) loads the agent
  # too, so the one with the most calls, then the most classes instrumented, then the oldest
  function summary_of () {
      in_container "$1" "cat $remote_dir/out/pid-*/summary.json 2> /dev/null" 2> /dev/null \
          | jq -c -s 'sort_by(-.calls, -(.instrumented | length), .pid) | first // empty' 2> /dev/null
  }

  function write_rules () {
      local file="$1" class method operation_string
      operation_string=$(IFS=+; echo "${operations[*]}")
      {
          echo "# written by playground debug jscissors on $(date '+%Y-%m-%d %H:%M:%S')"
          if [[ -n "$config_file" ]]
          then
              cat "$config_file"
          fi
          for class in "${classes[@]}"
          do
              for method in "${methods[@]}"
              do
                  echo "${class}{${method}}=${operation_string}"
              done
          done
          if [[ -n "$max_calls" ]]
          then
              echo "jscissors.maxCalls=$max_calls"
          fi
          if [[ -n "$max_calls_per_method" ]]
          then
              echo "jscissors.maxCallsPerMethod=$max_calls_per_method"
          fi
          if [[ -n "$max_value_length" ]]
          then
              echo "jscissors.maxValueLength=$max_value_length"
          fi
          if [[ -n "$only_failed" ]]
          then
              echo "jscissors.onlyFailed=1"
          fi
          if [[ -n "$slower_than_ms" ]]
          then
              echo "jscissors.slowerThanMs=$slower_than_ms"
          fi
      } > "$file"
  }

  # prints what the agent instrumented, from its summary.json
  function report_start () {
      local container="$1" summary="$2" instrumented
      instrumented=$(echo "$summary" | jq -r '.instrumented | length' 2> /dev/null)
      echo "$summary" | jq -r '.warnings[]?, .errors[]?' 2> /dev/null | while read -r line
      do
          logwarn "⚠️ $line"
      done
      if [[ "$instrumented" == "0" ]]
      then
          logwarn "🔍 no class of $container matches the rules yet: they are instrumented when they load (start the connector now), unless the class name is wrong (exact name, or a regex like io.confluent.connect.jdbc.*) or it is a JDK class (java.*: not supported)"
      else
          log "✂️ $instrumented class(es) instrumented in $container: $(echo "$summary" | jq -r '.instrumented[:5] | join(", ")')$([[ $instrumented -gt 5 ]] && echo ", ...")"
      fi
  }

  function start_one () {
      local container="$1" stage="/tmp/playground-jscissors/$1" summary output i
      rm -rf "$stage"
      mkdir -p "$stage/out"
      cp "$jar" "$stage/jscissors.jar"
      write_rules "$stage/jscissors.props"
      log "✂️ rules for $container:"
      grep -v '^#' "$stage/jscissors.props" | sed 's/^/     /'

      if [[ -n "$restart" ]]
      then
          # the container is recreated with the agent in JAVA_TOOL_OPTIONS: the startup of the JVM is traced too.
          # docker: $stage is mounted on $remote_dir (written by appuser, uid 1000); cfk: copied in a new image
          chmod -R a+rwX "$stage"
          log "🔁 recreating $container with the agent loaded at the start of the JVM"
          if ! playground container set-environment-variables --container "$container" --env "JAVA_TOOL_OPTIONS: -javaagent:$remote_dir/jscissors.jar=$agent_args" --mount-jscissors-files
          then
              logerror "❌ could not recreate $container with the agent"
              exit 1
          fi
          playground state set "jscissors.$container" "restart $(date +%s)"
      else
          in_container "$container" "mkdir -p $remote_dir && rm -rf $remote_dir/out $remote_dir/jscissors.jar $remote_dir/jscissors.props"
          playground container cp --source "$stage/jscissors.jar" --destination "$container:$remote_dir/jscissors.jar" > /dev/null 2>&1
          playground container cp --source "$stage/jscissors.props" --destination "$container:$remote_dir/jscissors.props" > /dev/null 2>&1
          log "💉 loading the agent in the running JVM of $container (no restart)"
          if ! output=$(attach "$container" "$agent_args" 2>&1)
          then
              echo "$output" | sed 's/^/     /'
              logerror "❌ could not load the agent in $container: the JVM refuses the attach (-XX:+DisableAttachMechanism), or its JDK is older than 16 and it has no JMX port"
              log "💡 use --restart to load the agent at the start of the JVM (the container is recreated)"
              exit 1
          fi
          echo "$output" | sed 's/^/     /'
          playground state set "jscissors.$container" "attach $(date +%s)"
      fi

      for i in $(seq 1 30)
      do
          summary=$(summary_of "$container")
          [[ -n "$summary" ]] && break
          sleep 2
      done
      if [[ -z "$summary" ]]
      then
          logerror "❌ the agent did not start in $container, see: playground container logs -c $container --grep jscissors --no-follow"
          exit 1
      fi
      report_start "$container" "$summary"
  }

  function stop_one () {
      local container="$1" stage="/tmp/playground-jscissors/$1" state mode started_at dest file files output
      state=$(playground state get "jscissors.$container" 2> /dev/null)
      read -r mode started_at <<< "$state"
      if [[ -z "$state" ]]
      then
          logerror "✂️ jscissors is not started on $container !"
          exit 1
      fi
      dest="$output_dir/jscissors-$container-$(date '+%Y-%m-%d-%H-%M-%S')"
      mkdir -p "$dest"

      # stops the session: original classes restored, final summary.json written
      if ! output=$(attach "$container" "action=stop" 2>&1)
      then
          echo "$output" | sed 's/^/     /'
          logwarn "⚠️ could not stop the agent in $container cleanly: copying what it wrote so far"
      fi
      if [[ "$mode" == "restart" && "$environment" != cfk* ]]
      then
          # mounted from the host: the files are already there, and survive the recreation of the container
          log "🧽 recreating $container without the agent"
          playground container set-environment-variables --container "$container" --restore-original-values
          cp -R "$stage/out/." "$dest/"
      else
          files=$(in_container "$container" "cd $remote_dir/out 2> /dev/null && find . -type f")
          for file in $files
          do
              mkdir -p "$dest/$(dirname "$file")"
              playground container cp --source "$container:$remote_dir/out/${file#./}" --destination "$dest/${file#./}" > /dev/null 2>&1
          done
          in_container "$container" "rm -rf $remote_dir/out" > /dev/null 2>&1
          if [[ "$mode" == "restart" ]]
          then
              log "🧽 restoring $container without the agent"
              playground container set-environment-variables --container "$container" --restore-original-values
          fi
      fi
      playground state del "jscissors.$container" > /dev/null 2>&1
      if ! ls "$dest"/pid-*/summary.json > /dev/null 2>&1
      then
          logerror "❌ no trace copied from $container to $dest"
          exit 1
      fi
      log "✂️ trace of $container ($(( $(date +%s) - started_at ))s) copied to $dest"
      if [[ -n "$no_analyze" ]]
      then
          log "🔎 analyze it with: playground analyze jscissors -f $dest"
          return
      fi
      playground analyze jscissors -f "$dest" --output-dir "$dest" || logwarn "⚠️ the trace could not be analyzed: the raw events are in $dest/pid-*/events.jsonl"
  }

  function status_one () {
      local container="$1" state mode started_at summary
      state=$(playground state get "jscissors.$container" 2> /dev/null)
      read -r mode started_at <<< "$state"
      if [[ -z "$state" ]]
      then
          log "✂️ jscissors is not started on $container by the playground"
          return
      fi
      summary=$(summary_of "$container")
      log "✂️ jscissors running on $container since $(format_epoch "$started_at" '+%Y-%m-%d %H:%M:%S') ($(( $(date +%s) - started_at ))s), $([[ "$mode" == "restart" ]] && echo "loaded at the start of the JVM" || echo "attached")"
      if [[ -n "$summary" ]]
      then
          echo "$summary" | jq -r '"     \(.calls) call(s) (summary refreshed every 5s), \(.calls_recorded) with details, \(.instrumented | length) class(es) instrumented, \(.error_count) agent error(s)", (.rules[] | "     rule \(.)")'
          echo "$summary" | jq -r '.methods | sort_by(-.total_us) | .[:5][] | "     \(.calls) call(s) \(.total_us / 1000 | floor) ms  \(.class | split(".") | last).\(.method)"'
      fi
  }

  # --slower-than: 500ms, 2s, 1m or a number of milliseconds
  slower_than_ms=""
  if [[ -n "$slower_than" ]]
  then
      case "$slower_than" in
          *ms) slower_than_ms="${slower_than%ms}" ;;
          *s|*m|*h) slower_than_ms=$(( $(duration_to_seconds "$slower_than") * 1000 )) ;;
          *) slower_than_ms="$slower_than" ;;
      esac
      if ! [[ "$slower_than_ms" =~ ^[0-9]+$ ]] || [[ "$slower_than_ms" -eq 0 ]]
      then
          logerror "❌ --slower-than $slower_than: expected a duration like 500ms, 2s or 1m"
          exit 1
      fi
  fi

  if [[ "$action" == "start" ]]
  then
      if [[ ${#classes[@]} -eq 0 && -z "$config_file" ]]
      then
          logerror "❌ --class (or --config-file) is required with --action start"
          exit 1
      fi
      if [[ -n "$config_file" && ! -f "$config_file" ]]
      then
          logerror "❌ --config-file $config_file not found"
          exit 1
      fi
      if ! jar=$(jscissors_agent_jar)
      then
          exit 1
      fi
  fi

  mkdir -p "$output_dir"
  output_dir=$(cd "$output_dir" && pwd)

  for container in "${container_array[@]}"
  do
      case "${action}" in
          start)
              if [[ -n "$(playground state get "jscissors.$container" 2> /dev/null)" ]]
              then
                  logwarn "✂️ jscissors is already started on $container: its rules are replaced (the trace so far is discarded)"
              fi
              start_one "$container"
          ;;
          stop)
              stop_one "$container"
          ;;
          status)
              status_one "$container"
          ;;
          *)
              logerror "should not happen"
              exit 1
          ;;
      esac
  done

  if [[ "$action" == "start" && -n "$duration" ]]
  then
      seconds=$(duration_to_seconds "$duration")
      log "⏱️ tracing for ${seconds}s, then stopping and analyzing (reproduce the problem now)"
      sleep "$seconds"
      for container in "${container_array[@]}"
      do
          stop_one "$container"
      done
  elif [[ "$action" == "start" ]]
  then
      log "🛑 stop it, copy the trace and analyze it with: playground debug jscissors --action stop$(for c in "${container_array[@]}"; do printf ' -c %s' "$c"; done)"
  fi

}

# :command.function
playground_debug_flight_recorder_command() {

  # src/commands/debug/flight-recorder.sh
  containers="${args[--container]}"
  action="${args[--action]}"
  settings="${args[--settings]}"
  output_dir="${args[--output-dir]}"
  no_analyze="${args[--no-analyze]}"
  eval "trace_methods=(${args[--trace-method]})"

  # Convert space-separated string to array
  IFS=' ' read -ra container_array <<< "$containers"

  # settings: a .jfc file of the playground, or settings shipped with the JDK
  case "${settings}" in
      playground) settings_file="$root_folder/tools/jfr-analyzer/playground.jfc" ;;
      all) settings_file="$root_folder/scripts/cli/all.jfc" ;;
      *) settings_file="" ;;
  esac

  get_environment_used

  if [[ ${#trace_methods[@]} -gt 0 && "$action" == "start" ]]
  then
      if [[ -z "$settings_file" ]]
      then
          logerror "❌ --trace-method needs --settings playground or all (the settings $settings of the JDK cannot be extended)"
          exit 1
      fi
      for container in "${container_array[@]}"
      do
          check_method_trace_supported "$container"
      done
      settings_file=$(jfr_settings_with_method_trace "$settings_file" "${trace_methods[@]}") || exit 1
      log "🎯 tracing every call of ${trace_methods[*]} (JDK 25 method tracing)"
  fi

  # the recording of each container is kept in playground.ini, flight_recorder.<container>:
  #   jmx <jmx port> <recording id> <settings> <start epoch>   recording driven over JMX (FlightRecorderMXBean)
  #   jcmd - dump1 <settings> <start epoch>                    recording started with jcmd (cfk pods, no JMX port)
  function jmx_port_of () {
      docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$1" 2> /dev/null | sed -n 's/^[A-Z_]*JMX_PORT=//p' | head -1
  }

  function format_epoch () {
      date -r "$1" "$2" 2> /dev/null || date -d "@$1" "$2" 2> /dev/null || echo "$1"
  }

  function has_jcmd () {
      playground --output-level ERROR container exec --container "$1" --command "type jcmd" > /dev/null 2>&1
  }

  function analyze_recording () {
      local file="$1"
      if [[ -n "$no_analyze" ]]
      then
          log "🔎 analyze it with: playground analyze flight-recorder -f $file"
          return
      fi
      log "🔎 analyzing $file (--no-analyze to skip it)"
      playground analyze flight-recorder -f "$file" --output-dir "$(dirname "$file")" || logwarn "⚠️ the recording could not be analyzed, open it with JDK Mission Control (https://jdk.java.net/jmc/)"
  }

  mkdir -p "$output_dir"
  output_dir=$(cd "$output_dir" && pwd)

  for container in "${container_array[@]}"
  do
      state=$(playground state get "flight_recorder.$container" 2> /dev/null)
      read -r mode port id recorded_settings started_at <<< "$state"

      case "${action}" in
          start)
              if [[ -n "$state" ]]
              then
                  logwarn "🛩️ flight recorder is already started on $container (settings $recorded_settings, since $(format_epoch "$started_at" '+%H:%M:%S')): stop it with --action stop"
                  continue
              fi
              # over JMX first: no jcmd needed (the cp images ship a JRE) and no restart
              port=""
              if [[ "$environment" != cfk* ]]
              then
                  port=$(jmx_port_of "$container")
              fi
              if [[ -n "$port" ]]
              then
                  benchmark_jmx_init "$container $port"
                  if recording=$(jfr_jmx_start "$container $port" "${settings_file:-$settings}")
                  then
                      read -r _ _ id <<< "$recording"
                      playground state set "flight_recorder.$container" "jmx $port $id $settings $(date +%s)"
                      log "🛩️ flight recorder is now started on $container over JMX (recording $id, settings $settings)"
                      continue
                  fi
                  logwarn "⚠️ the flight recorder of $container could not be started over JMX (localhost:$port), trying jcmd"
              fi
              if ! has_jcmd "$container"
              then
                  logerror "❌ cannot start the flight recorder of $container: no JMX port (KAFKA_JMX_PORT, SCHEMA_REGISTRY_JMX_PORT...) reachable and no jcmd in the image"
                  log "💡 playground container change-jdk --version <n> installs a JDK with jcmd, but it restarts the container"
                  exit 1
              fi
              remote_settings="$settings"
              if [[ -n "$settings_file" ]]
              then
                  remote_settings="/tmp/$(basename "$settings_file")"
                  playground container cp --source "$settings_file" --destination "$container:$remote_settings" > /dev/null 2>&1
              fi
              if playground --output-level ERROR container exec --container "$container" --command "jcmd 1 JFR.start name=dump1 settings=$remote_settings"
              then
                  playground state set "flight_recorder.$container" "jcmd - dump1 $settings $(date +%s)"
                  log "🛩️ flight recorder is now started on $container with jcmd (settings $settings)"
              else
                  logerror "❌ failed to start the flight recorder of $container with jcmd"
                  exit 1
              fi
          ;;
          stop)
              if [[ -z "$state" ]]
              then
                  logerror "🛩️ flight recorder is not started on $container !"
                  exit 1
              fi
              filename="$output_dir/flight-recorder-$container-$(date '+%Y-%m-%d-%H-%M-%S').jfr"
              if [[ "$mode" == "jmx" ]]
              then
                  benchmark_jmx_init "$container $port"
                  recorded=$(jfr_jmx_stop "$container $port $id" "${filename%.jfr}.tmp")
                  if [[ -z "$recorded" ]]
                  then
                      playground state del "flight_recorder.$container" > /dev/null 2>&1
                      logerror "❌ failed to stop the flight recorder of $container over JMX (recording $id): the JVM restarted, or the recording was closed"
                      exit 1
                  fi
                  mv "$recorded" "$filename"
              else
                  remote="/tmp/$(basename "$filename")"
                  if ! playground --output-level ERROR container exec --container "$container" --command "jcmd 1 JFR.stop name=dump1 filename=$remote"
                  then
                      playground state del "flight_recorder.$container" > /dev/null 2>&1
                      logerror "❌ failed to stop the flight recorder of $container with jcmd"
                      exit 1
                  fi
                  playground container cp --source "$container:$remote" --destination "$filename" > /dev/null 2>&1
                  playground --output-level ERROR container exec --container "$container" --command "rm -f $remote" > /dev/null 2>&1
              fi
              playground state del "flight_recorder.$container" > /dev/null 2>&1
              log "🛩️ flight recording of $container ($(( $(date +%s) - started_at ))s, settings $recorded_settings) is available at $filename"
              log "use JDK Mission Control JMC (https://jdk.java.net/jmc/) to open it"
              analyze_recording "$filename"
          ;;
          status)
              if [[ -z "$state" ]]
              then
                  log "🛩️ no flight recording started on $container by the playground"
              else
                  log "🛩️ flight recording running on $container since $(format_epoch "$started_at" '+%Y-%m-%d %H:%M:%S') ($(( $(date +%s) - started_at ))s), with $mode, settings $recorded_settings"
              fi
          ;;
          *)
              logerror "should not happen"
              exit 1
          ;;
      esac
  done

}

# :command.function
playground_debug_log_level_get_command() {

  # src/commands/debug/log-level/get.sh
  get_connect_url_and_security

  package="${args[--package]}"

  if [[ -n "$package" ]]
  then
    log "🧬 Get log level for package $package"
    # echo: the REST API answers without a final new line
    echo "$(curl $security -s "$connect_url/admin/loggers/$package")"
  else
    log "🧬 Get log level for all packages"
    curl $security -s "$connect_url/admin/loggers" | jq .
  fi
}

# :command.function
playground_debug_log_level_set_command() {

  # src/commands/debug/log-level/set.sh
  get_connect_url_and_security

  package="${args[--package]}"
  level="${args[--level]}"

  current_level=$(curl $security -s "$connect_url/admin/loggers/$package" | jq -r '.level')

  if [ "$current_level" != "$level" ]
  then
      get_connect_image
      if ! version_gt $CP_CONNECT_TAG "7.6.99"
      then
          log "🧬 Set log level for package $package to $level"
          curl $security -s --request PUT \
          --url "$connect_url/admin/loggers/$package" \
          --header 'Accept: application/json' \
          --header 'Content-Type: application/json' \
          --data "{
          \"level\": \"$level\"
          }" | jq .
      else
          log "🧬 Set log level for package $package to $level (scope=cluster)"
          curl $security -s --request PUT \
          --url "$connect_url/admin/loggers/$package?scope=cluster" \
          --header 'Accept: application/json' \
          --header 'Content-Type: application/json' \
          --data "{
          \"level\": \"$level\"
          }" | jq .
      fi

      playground debug log-level get -p "$package"
  else
      log "🧬⏭️ Skipping as log level for package $package was already set to $level"
  fi
}

# :command.function
playground_debug_cfk_cfk_bundle_analyze_command() {

  # src/commands/analyze/cfk-bundle.sh
  bundle="${args[--bundle]}"
  sample="${args[--sample]}"
  json_out="${args[--json]}"
  no_sanitize="${args[--no-sanitize]}"
  severity="${args[--severity]}"
  top="${args[--top]}"
  output_dir="${args[--output-dir]}"
  include_warnings="${args[--include-warnings]}"
  eval "component_array=(${args[--component]})"

  set +e

  if [[ -n "$bundle" && -n "$sample" ]]; then
      logerror "❌ Provide either --bundle or --sample, not both"
      exit 1
  fi
  if [[ -z "$bundle" && -z "$sample" ]]; then
      logerror "❌ Must provide --bundle <directory or archive> (or --sample synthetic to try it)"
      exit 1
  fi
  # ── Sample mode: bundle shipped in cfk-analysis/samples (built by make_synthetic_bundle.py) ──
  if [[ "$sample" == "synthetic" ]]; then
      bundle="$root_folder/cfk-analysis/samples/cfk-support-bundle-synthetic.tar.gz"
  fi

  # Handle fzf @path trick (mirrors gc-logs convention), only when the path itself does not exist
  if [[ ! -e "$bundle" && "$bundle" == *"@"* ]]; then
      bundle=$(echo "$bundle" | cut -d "@" -f 2)
  fi

  if [[ ! -e "$bundle" ]]; then
      logerror "❌ Bundle path does not exist: $bundle"
      exit 1
  fi

  analyzer_dir="$root_folder/cfk-analysis"
  if [[ ! -f "$analyzer_dir/analyzer_cli.py" ]]; then
      logerror "❌ CFK analyzer not found at: $analyzer_dir/analyzer_cli.py"
      exit 1
  fi

  # ── Analyzer image (dependencies baked once, code mounted at run time) ─────
  # The tag changes when the Dockerfile or requirements change, so the image is rebuilt only then
  image_tag=$(cat "$analyzer_dir/Dockerfile" "$analyzer_dir/requirements.txt" | cksum | cut -d ' ' -f 1)
  image="cfk-bundle-analyzer:$image_tag"
  if ! docker image inspect "$image" > /dev/null 2>&1; then
      # stderr: stdout must stay valid JSON with --json
      log "🏗️  Building $image (first run only)..." >&2
      build_log="/tmp/cfk-bundle-analyzer-build.log"
      if ! docker build --load -t "$image" "$analyzer_dir" > "$build_log" 2>&1 && ! docker build -t "$image" "$analyzer_dir" >> "$build_log" 2>&1; then
          logerror "❌ Failed to build $image, see $build_log"
          tail -20 "$build_log" >&2
          exit 1
      fi
  fi

  bundle_abs=$(cd "$(dirname "$bundle")" && pwd -P)/$(basename "$bundle")
  bundle_container="/tmp/input/$(basename "$bundle")"

  # ── Build CLI args ─────────────────────────────────────────────────────────
  cli_args=("$bundle_container")

  if [[ -n "$json_out" ]]; then
      cli_args+=(--json)
  fi

  if [[ -n "$no_sanitize" ]]; then
      cli_args+=(--no-sanitize)
      logwarn "⚠️  Sanitization DISABLED. Do not share this output for customer bundles."
  fi

  if [[ -n "$severity" ]]; then
      cli_args+=(--severity "$severity")
  fi

  if [[ -n "$top" ]]; then
      cli_args+=(--top "$top")
  fi

  if [[ -n "$include_warnings" ]]; then
      cli_args+=(--include-warnings)
  fi

  for component in "${component_array[@]}"; do
      cli_args+=(--component "$component")
  done

  # run as the current user: it can read the bundle and write the HTML report
  docker_args=(
      --rm
      --user "$(id -u):$(id -g)"
      -v "$analyzer_dir:/tmp/cfk-analysis:ro"
      -v "$root_folder/tools/report-common:/tmp/report-common:ro"
      -v "$bundle_abs:$bundle_container:ro"
  )

  # ── HTML output target ─────────────────────────────────────────────────────
  html_out=""
  # the HTML report is always written (not with --json: stdout must stay JSON)
  if [[ -z "$json_out" ]]; then
      : "${output_dir:=./cfk-reports}"
      mkdir -p "$output_dir"
      output_dir_abs=$(cd "$output_dir" && pwd -P)

      bundle_basename=$(basename "$bundle")
      # strip common archive suffixes for a clean filename
      bundle_basename="${bundle_basename%.tar.gz}"
      bundle_basename="${bundle_basename%.tgz}"
      bundle_basename="${bundle_basename%.tar}"
      bundle_basename="${bundle_basename%.zip}"

      html_out="${output_dir_abs}/${bundle_basename}-cfk-report-$(date '+%Y%m%d-%H%M%S').html"
      cli_args+=(--html-out "/tmp/output/$(basename "$html_out")")
      docker_args+=( -v "$output_dir_abs:/tmp/output" )
  fi

  # ── Run the analyzer ───────────────────────────────────────────────────────
  if [[ -z "$json_out" ]]; then
      log "🔬 Analyzing CFK bundle: $bundle"
      log ""
  fi

  docker run "${docker_args[@]}" "$image" "${cli_args[@]}"
  exit_code=$?

  case $exit_code in
      0) ;;
      64) logerror "❌ Analysis failed — invalid, unsafe or empty bundle (see error above)." ;;
      *) logerror "❌ Analyzer failed with exit code $exit_code." ;;
  esac

  # ── Open HTML report in browser ────────────────────────────────────────────
  if [[ $exit_code -eq 0 && -n "$html_out" && -f "$html_out" ]]; then
      log ""
      log "🌐 HTML report saved: $html_out"
      # only open a browser in an interactive terminal
      if [[ ! -t 1 ]]; then
          log "🔗 Open in browser: file://$html_out"
      elif command -v open &>/dev/null; then
          log "🌐 Opening report in browser..."
          open "$html_out"
      elif command -v xdg-open &>/dev/null; then
          log "🌐 Opening report in browser..."
          xdg-open "$html_out" >/dev/null 2>&1 &
      else
          log "🔗 Open in browser: file://$html_out"
      fi
  fi

  exit $exit_code

}

# :command.function
playground_debug_cfk_generate_bundle_command() {

  # src/commands/debug/cfk/generate-bundle.sh
  #!/bin/bash

  # Extract arguments
  namespace="confluent"
  follow_logs_duration="${args[--follow-logs-duration]}"
  output_dir="/tmp/cfk-support-bundle"
  verbose="${args[--verbose]}"

  set +e

  # Check if confluent plugin is installed
  if ! kubectl confluent support-bundle -h &> /dev/null 2>&1; then
      log "⚠️  kubectl confluent plugin not found. Installing..."
      install_confluent_plugin
  fi

  # ── Create output directory if needed ───────────────────────────────────────
  if [[ -n "$output_dir" ]]; then
      if ! mkdir -p "$output_dir"; then
          logerror "❌ Failed to create output directory: $output_dir"
          exit 1
      fi
      cd "$output_dir" || exit 1
      log "📁 Output directory: $(pwd)"
  fi

  # ── Build kubectl command ──────────────────────────────────────────────────
  cmd="kubectl confluent support-bundle --namespace $namespace"

  if [[ -n "$follow_logs_duration" ]]; then

      if [[ $follow_logs_duration -gt 0 ]]; then
          cmd="$cmd --follow-logs-duration $follow_logs_duration"
          log "📝 Following pod logs for $follow_logs_duration seconds"
      fi
  fi

  # Add verbose flag if requested
  if [[ -n "$verbose" ]]; then
      cmd="$cmd --verbose"
  fi

  # ── Generate support bundle ────────────────────────────────────────────────
  log "🔧 Generating CFK support bundle for namespace: $namespace"
  log "⏳ Please wait... this may take a few minutes"
  log ""

  if [[ -n "$verbose" ]]; then
      log "📋 Running: $cmd"
      log ""
  fi

  # Run the command and capture output
  output=$($cmd 2>&1)
  exit_code=$?

  if [[ $exit_code -eq 0 ]]; then
      log "✅ Support bundle generated successfully!"
      log ""

      # Extract bundle full path from output (kubectl outputs the full path)
      bundle_file=$(echo "$output" | grep -oE '/[^ ]*support-bundle.*\.tar\.gz' | head -1)

      if [[ -z "$bundle_file" ]]; then
          # Fallback: try to extract just the filename
          bundle_filename=$(echo "$output" | grep -oE 'support-bundle.*\.tar\.gz' | head -1)
          if [[ -n "$bundle_filename" ]]; then
              bundle_file="$output_dir/$bundle_filename"
          fi
      fi

      if [[ -n "$bundle_file" ]]; then
          log "📦 Bundle: $bundle_file"
          log ""
          log "📊 To analyze the bundle, run:"
          log "   playground analyze cfk-bundle --bundle $bundle_file"
          log ""
          log "📈 To extract the bundle, run:"
          log "   tar -xzf $bundle_file"
      else
          log "Full output:"
          echo "$output"
      fi
  else
      logerror "❌ Failed to generate support bundle"
      logerror ""
      logerror "Output:"
      echo "$output" >&2
      exit $exit_code
  fi

  set -e

}

