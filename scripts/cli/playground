  if [[ -n "$json_out" ]]; then
      python3 -I "$analyzer" "${analyzer_args[@]}" --json
      exit $?
  fi

  html_out=""
  # the HTML report is always written (not with --json: stdout must stay JSON)
  if [[ -z "$json_out" ]]; then
      first=$(basename "${file_array[${#file_array[@]}-1]}")
      html_out="${output_dir_abs}/${first%.*}-xstream-report.html"
      analyzer_args+=(--html-out "$html_out")
  fi

  log "🅾️ Analyzing Oracle XStream diagnostics report(s): ${file_array[*]}"
  log ""
  python3 -I "$analyzer" "${analyzer_args[@]}" 2> >(grep -v '^HTML report:' >&2)
  exit_code=$?

  if [[ $exit_code -ne 0 ]]; then
      logerror "❌ Oracle XStream report analysis failed (exit code $exit_code)"
      exit $exit_code
  fi

  if [[ -n "$html_out" && -f "$html_out" ]]; then
      log ""
      log "✅ HTML report saved: $html_out"
      # only open a browser in an interactive terminal
      if [[ -t 1 ]] && command -v open &>/dev/null; then
          log "🌐 Opening report in browser..."
          open "$html_out"
      else
          log "🔗 Open in browser: file://$html_out"
      fi
  fi

  exit 0

}

# :command.function
playground_analyze_cfk_bundle_command() {

  # src/commands/analyze/cfk-bundle.sh
  bundle="${args[--bundle]}"
  sample="${args[--sample]}"
  json_out="${args[--json]}"
  no_sanitize="${args[--no-sanitize]}"
  severity="${args[--severity]}"
  top="${args[--top]}"
  output_dir="${args[--output-dir]}"
  include_warnings="${args[--include-warnings]}"
  eval "component_array=(${args[--component]})"

  set +e

  if [[ -n "$bundle" && -n "$sample" ]]; then
      logerror "❌ Provide either --bundle or --sample, not both"
      exit 1
  fi
  if [[ -z "$bundle" && -z "$sample" ]]; then
      logerror "❌ Must provide --bundle <directory or archive> (or --sample synthetic to try it)"
      exit 1
  fi
  # ── Sample mode: bundle shipped in cfk-analysis/samples (built by make_synthetic_bundle.py) ──
  if [[ "$sample" == "synthetic" ]]; then
      bundle="$root_folder/cfk-analysis/samples/cfk-support-bundle-synthetic.tar.gz"
  fi

  # Handle fzf @path trick (mirrors gc-logs convention), only when the path itself does not exist
  if [[ ! -e "$bundle" && "$bundle" == *"@"* ]]; then
      bundle=$(echo "$bundle" | cut -d "@" -f 2)
  fi

  if [[ ! -e "$bundle" ]]; then
      logerror "❌ Bundle path does not exist: $bundle"
      exit 1
  fi

  analyzer_dir="$root_folder/cfk-analysis"
  if [[ ! -f "$analyzer_dir/analyzer_cli.py" ]]; then
      logerror "❌ CFK analyzer not found at: $analyzer_dir/analyzer_cli.py"
      exit 1
  fi

  # ── Analyzer image (dependencies baked once, code mounted at run time) ─────
  # The tag changes when the Dockerfile or requirements change, so the image is rebuilt only then
  image_tag=$(cat "$analyzer_dir/Dockerfile" "$analyzer_dir/requirements.txt" | cksum | cut -d ' ' -f 1)
  image="cfk-bundle-analyzer:$image_tag"
  if ! docker image inspect "$image" > /dev/null 2>&1; then
      # stderr: stdout must stay valid JSON with --json
      log "🏗️  Building $image (first run only)..." >&2
      build_log="/tmp/cfk-bundle-analyzer-build.log"
      if ! docker build --load -t "$image" "$analyzer_dir" > "$build_log" 2>&1 && ! docker build -t "$image" "$analyzer_dir" >> "$build_log" 2>&1; then
          logerror "❌ Failed to build $image, see $build_log"
          tail -20 "$build_log" >&2
          exit 1
      fi
  fi

  bundle_abs=$(cd "$(dirname "$bundle")" && pwd -P)/$(basename "$bundle")
  bundle_container="/tmp/input/$(basename "$bundle")"

  # ── Build CLI args ─────────────────────────────────────────────────────────
  cli_args=("$bundle_container")

  if [[ -n "$json_out" ]]; then
      cli_args+=(--json)
  fi

  if [[ -n "$no_sanitize" ]]; then
      cli_args+=(--no-sanitize)
      logwarn "⚠️  Sanitization DISABLED. Do not share this output for customer bundles."
  fi

  if [[ -n "$severity" ]]; then
      cli_args+=(--severity "$severity")
  fi

  if [[ -n "$top" ]]; then
      cli_args+=(--top "$top")
  fi

  if [[ -n "$include_warnings" ]]; then
      cli_args+=(--include-warnings)
  fi

  for component in "${component_array[@]}"; do
      cli_args+=(--component "$component")
  done

  # run as the current user: it can read the bundle and write the HTML report
  docker_args=(
      --rm
      --user "$(id -u):$(id -g)"
      -v "$analyzer_dir:/tmp/cfk-analysis:ro"
      -v "$root_folder/tools/report-common:/tmp/report-common:ro"
      -v "$bundle_abs:$bundle_container:ro"
  )

  # ── HTML output target ─────────────────────────────────────────────────────
  html_out=""
  # the HTML report is always written (not with --json: stdout must stay JSON)
  if [[ -z "$json_out" ]]; then
      : "${output_dir:=./cfk-reports}"
      mkdir -p "$output_dir"
      output_dir_abs=$(cd "$output_dir" && pwd -P)

      bundle_basename=$(basename "$bundle")
      # strip common archive suffixes for a clean filename
      bundle_basename="${bundle_basename%.tar.gz}"
      bundle_basename="${bundle_basename%.tgz}"
      bundle_basename="${bundle_basename%.tar}"
      bundle_basename="${bundle_basename%.zip}"

      html_out="${output_dir_abs}/${bundle_basename}-cfk-report-$(date '+%Y%m%d-%H%M%S').html"
      cli_args+=(--html-out "/tmp/output/$(basename "$html_out")")
      docker_args+=( -v "$output_dir_abs:/tmp/output" )
  fi

  # ── Run the analyzer ───────────────────────────────────────────────────────
  if [[ -z "$json_out" ]]; then
      log "🔬 Analyzing CFK bundle: $bundle"
      log ""
  fi

  docker run "${docker_args[@]}" "$image" "${cli_args[@]}"
  exit_code=$?

  case $exit_code in
      0) ;;
      64) logerror "❌ Analysis failed — invalid, unsafe or empty bundle (see error above)." ;;
      *) logerror "❌ Analyzer failed with exit code $exit_code." ;;
  esac

  # ── Open HTML report in browser ────────────────────────────────────────────
  if [[ $exit_code -eq 0 && -n "$html_out" && -f "$html_out" ]]; then
      log ""
      log "🌐 HTML report saved: $html_out"
      # only open a browser in an interactive terminal
      if [[ ! -t 1 ]]; then
          log "🔗 Open in browser: file://$html_out"
      elif command -v open &>/dev/null; then
          log "🌐 Opening report in browser..."
          open "$html_out"
      elif command -v xdg-open &>/dev/null; then
          log "🌐 Opening report in browser..."
          xdg-open "$html_out" >/dev/null 2>&1 &
      else
          log "🔗 Open in browser: file://$html_out"
      fi
  fi

  exit $exit_code

}

# :command.function
playground_analyze_flight_recorder_command() {

  # src/commands/analyze/flight-recorder.sh
  eval "file_array=(${args[--file]})"
  sample="${args[--sample]}"
  container="${args[--container]}"
  duration=$(duration_to_seconds "${args[--duration]}")
  connector="${args[--connector]}"
  connector_class="${args[--connector-class]}"
  threads="${args[--threads]}"
  output_dir="${args[--output-dir]}"
  json_out="${args[--json]}"
  top="${args[--top]}"
  eval "trace_methods=(${args[--trace-method]})"

  set +e

  nb_modes=0
  [[ ${#file_array[@]} -gt 0 ]] && nb_modes=$((nb_modes + 1))
  [[ -n "$sample" ]] && nb_modes=$((nb_modes + 1))
  [[ -n "$container" ]] && nb_modes=$((nb_modes + 1))
  if [[ $nb_modes -gt 1 ]]; then
      logerror "❌ Provide only one of --file, --container and --sample"
      exit 1
  fi
  if [[ $nb_modes -eq 0 ]]; then
      container="connect"
  fi

  analyzer="$root_folder/tools/jfr-analyzer/jfr_analyzer.py"
  if ! command -v python3 &>/dev/null; then
      logerror "❌ python3 is required but not found on PATH"
      exit 1
  fi

  # with --json, logs go to stderr and only the analysis to stdout
  if [[ -n "$json_out" ]]; then
      exec 3>&1 1>&2
  fi

  mkdir -p "$output_dir"
  output_dir_abs=$(cd "$output_dir" && pwd)

  if [[ -n "$connector" ]]; then
      [[ -z "$threads" ]] && threads="^task-thread-$(printf '%s' "$connector" | sed 's/[][\.*^$(){}+?|/]/\\&/g')-[0-9]+$"
      if [[ -z "$connector_class" ]]; then
          get_connect_url_and_security
          if handle_onprem_connect_rest_api "curl -s $security \"$connect_url/connectors/$connector/config\"" > /dev/null 2>&1; then
              connector_class=$(echo "$curl_output" | jq -r '."connector.class" // empty' 2> /dev/null)
          fi
      fi
  fi
  [[ -z "$threads" ]] && threads="^task-thread-"

  if [[ ${#trace_methods[@]} -gt 0 && -z "$container" ]]; then
      logwarn "⚠️ --trace-method is only used when recording a container (-c): a recording made with method tracing already holds its events"
  fi

  # fzf completion returns <display>@<path>
  for i in "${!file_array[@]}"
  do
      if [[ ! -e "${file_array[$i]}" && "${file_array[$i]}" == *"@"* ]]; then
          file_array[$i]=$(echo "${file_array[$i]}" | cut -d "@" -f 2)
      fi
  done

  # ── Container mode: record the JVM over JMX ──
  if [[ -n "$container" ]]; then
      port=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2> /dev/null | sed -n 's/^[A-Z_]*JMX_PORT=//p' | head -1)
      if [[ -z "$port" ]]; then
          logerror "❌ container $container is not running or has no JMX port (KAFKA_JMX_PORT, SCHEMA_REGISTRY_JMX_PORT...): the flight recorder is driven over JMX"
          exit 1
      fi
      workers="$container $port"
      settings_file=""
      if [[ ${#trace_methods[@]} -gt 0 ]]; then
          check_method_trace_supported "$container"
          settings_file=$(jfr_settings_with_method_trace "$root_folder/tools/jfr-analyzer/playground.jfc" "${trace_methods[@]}") || exit 1
          log "🎯 tracing every call of ${trace_methods[*]} (JDK 25 method tracing)"
      fi
      benchmark_jmx_init "$workers"
      recordings=$(jfr_jmx_start "$workers" "$settings_file")
      if [[ $? -ne 0 || -z "$recordings" ]]; then
          logerror "❌ could not start the flight recorder of $container over JMX (localhost:$port): JDK 8 before 8u262, or JMX not reachable"
          exit 1
      fi
      trap 'jfr_jmx_discard "$recordings"' EXIT
      log "🛩️ recording $container for ${duration}s with the settings of tools/jfr-analyzer/playground.jfc"
      sleep "$duration"
      recorded=$(jfr_jmx_stop "$recordings" "$output_dir_abs/flight-recorder-$(date '+%Y-%m-%d-%H-%M-%S')")
      recordings=""
      trap - EXIT
      if [[ -z "$recorded" ]]; then
          logerror "❌ the recording could not be copied from $container"
          exit 1
      fi
      log "✅ recording saved in $recorded"
      file_array=("$recorded")
  fi

  # ── Digests: from the samples, the .json digests given, or the .jfr files ──
  digests=()
  if [[ -n "$sample" ]]; then
      # a sample digest also carries the connector class, type and mode of its benchmark
      digests=("$root_folder/tools/jfr-analyzer/samples/$sample.digest.json")
  fi
  jfr_files=()
  for file in "${file_array[@]}"
  do
      if [[ "$file" == *.digest.json ]]; then
          digests+=("$file")
      else
          jfr_files+=("$file")
      fi
  done
  if [[ ${#jfr_files[@]} -gt 0 ]]; then
      log "🔬 reading ${#jfr_files[@]} recording(s) with the JDK flight recorder API ($JFR_ANALYZER_IMAGE)"
      produced=$(jfr_digest "$output_dir_abs" "$threads" "${jfr_files[@]}")
      ret=$?
      for digest in $produced
      do
          digests+=("$digest")
      done
      if [[ $ret -ne 0 ]]; then
          logerror "❌ not a flight recording, or it could not be read: ${jfr_files[*]}"
          for file in "${jfr_files[@]}"
          do
              log_file="$output_dir_abs/$(basename "${file%.jfr}").digest.json.log"
              [[ -s "$log_file" ]] && grep -m1 -E "Exception|Error" "$log_file"
          done
          exit 2
      fi
  fi

  analyzer_args=()
  for digest in "${digests[@]}"
  do
      analyzer_args+=(--digest "$digest")
  done
  analyzer_args+=(--top "$top")
  [[ -n "$connector_class" ]] && analyzer_args+=(--connector-class "$connector_class")

  if [[ -n "$json_out" ]]; then
      python3 -I "$analyzer" "${analyzer_args[@]}" --json >&3
      exit $?
  fi

  if [[ ${#jfr_files[@]} -gt 0 ]]; then
      first=$(basename "${jfr_files[0]}")
      html_out="$output_dir_abs/${first%.jfr}-jfr-report.html"
      [[ ${#jfr_files[@]} -eq 1 ]] && analyzer_args+=(--recording-link "${jfr_files[0]}")
  else
      first=$(basename "${digests[0]}")
      html_out="$output_dir_abs/${first%.digest.json}-jfr-report.html"
  fi
  analyzer_args+=(--html-out "$html_out")

  log ""
  python3 -I "$analyzer" "${analyzer_args[@]}"
  exit_code=$?
  if [[ $exit_code -ne 0 ]]; then
      logerror "❌ flight recording analysis failed (exit code $exit_code)"
      exit $exit_code
  fi

  if [[ -f "$html_out" ]]; then
      log ""
      log "✅ HTML report saved: $html_out"
      # only open a browser in an interactive terminal
      if [[ -t 1 ]] && command -v open &>/dev/null; then
          log "🌐 Opening report in browser..."
          open "$html_out"
      else
          log "🔗 Open in browser: file://$html_out"
      fi
  fi

  exit 0

}

