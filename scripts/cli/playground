# :command.usage
playground_topic_dlq_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground topic dlq\n\n"
    printf "  📬 Dead letter queue commands\n  \n  Read the dead letter queue of a sink connector\n  (errors.tolerance=all with errors.deadletterqueue.topic.name, or the\n  dlq-<lcc id> topic of a fully managed connector) without decoding\n  its headers by hand, and send the records back once the cause is\n  fixed.\n  \n    inspect   records grouped by error (exception, message, root cause,\n              original topic, partition and offsets)\n    replay    produce the records again to their original topic, or\n              to --to\n  \n  Without --topic, the dead letter queue of --connector, or of the only\n  running connector that has one, is used.\n  \n  The errors are in the __connect.errors.* headers, which are only\n  written with \"errors.deadletterqueue.context.headers.enable\": \"true\"\n  ('playground connector snippets --dlq' has it).\n  \n  👉 Example:\n  https://github.com/vdesabou/kafka-docker-playground/tree/master/other/reprocess-dlq-messages-with-sink-connector\n  \n  🍪 Deep dive:\n  https://kafka-docker-playground.io/#/deep-dive-connector-troubleshooting\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%A9%%BA-a-sink-is-running-but-writes-nothing\n\n"
  else
    printf "playground topic dlq - 📬 Dead letter queue commands\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground topic dlq COMMAND\n"
  printf "  playground topic dlq [COMMAND] --help | -h\n"
  echo
  # :command.usage_commands
  printf "%s\n" "$(bold "Topic commands:")"
