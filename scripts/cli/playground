# :command.usage
playground_repro_export_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground repro export\n\n"
    printf "  📤 Export reproduction models as a self-contained tgz bundle\n  \n  Produces a single tgz that a colleague can feed to\n  'playground repro import' to run your scenario as is.\n  \n  The bundle holds what the model needs, committed or not: the script,\n  the files of its folder it mentions (docker compose override, producer,\n  SQL files…) and the support files linked by bootstrap (README.md,\n  stop.sh, benchmark-load.bash, config-*). Symlinks are stored as their\n  content, so the bundle does not depend on the version of the base\n  example. Git-ignored files, build output (target/), dumps, flight\n  recordings, logs and credential files (keyfile.json, *.pem, *.key) are\n  left out.\n  \n  A repro-manifest.json describes the bundle: the last 'playground run'\n  line of each model (from playground-run-history), its case number,\n  author, base example, the playground commit, the names (never the\n  values) of the credentials it needs, and the sha256 of every file.\n  \n  Before anything is written, the bundle is scanned. The export stops\n  (unless --force) when a file contains the value of a credential known\n  to this machine ('playground secrets' store, exported credential\n  variables, CLUSTER_CREDS / SCHEMA_REGISTRY_CREDS of playground.ini,\n  ~/.aws/credentials) or a well-known token format (AWS access key id,\n  private key, GitHub / Slack token, Google API key, JWT, Azure storage\n  account key). Email addresses, public IP addresses and hard-coded\n  passwords that do not come from the base example are reported as\n  possible customer data. Values are never printed.\n  \n  Files outside the repository that a model needs (--connector-zip /\n  --connector-jar of its run line, files whose absolute path appears in\n  the script or its compose files, like ~/Downloads/config.json) are\n  only listed, unless --include-artifacts packs them under\n  <model folder>/artifacts/. Import then points the run line, the script\n  and the compose files to the imported copies. Import also rewrites the\n  paths of the exporter's checkout (like the jar path written by\n  'repro bootstrap --custom-smt') to the local ones.\n  \n  --cluster-creds / --cluster-schema-registry-creds are removed from the\n  run line: whoever imports runs with their own cluster.\n  \n  Without --file, the current reproduction model is exported.\n  \n  📋 On macOS, the bundle is copied to the clipboard as a file: paste it\n  (Cmd+V) in a Slack conversation to attach it (--no-clipboard to skip).\n  \n  🎓 Tip: start with --dry-run to see what would be packed, and what the scan\n  finds.\n  The same scan runs on commits with 'playground repro check'.\n\n"
  else
    printf "playground repro export - 📤 Export reproduction models as a self-contained tgz bundle\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground repro export [OPTIONS]\n"
  printf "  playground repro export --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--file, -f FILE (repeatable)")"
    printf "    🔖 Reproduction model script to export (default: current one)\n    \n    Can be repeated to put several models in one bundle.\n"
    printf "    %s\n" "Conflicts: --all-uncommitted, --all"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--all-uncommitted")"
    printf "    📦 Export every reproduction model with uncommitted changes (new or modified)\n"
    printf "    %s\n" "Conflicts: --file"
    echo

    if [[ -n "${PLAYGROUND_SHOW_PRIVATE:-}" ]]; then
      # :flag.usage
      printf "  %s\n" "$(magenta "--all")"
      printf "    📦 Former name of --all-uncommitted\n"
      printf "    %s\n" "Conflicts: --file"
      echo

    fi
    # :flag.usage
    printf "  %s\n" "$(magenta "--output, -o OUTPUT")"
    printf "    📁 Folder where to write the bundle (default: current folder, or the\n    repository root when run from reproduction-models)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--dry-run")"
    printf "    🔍 Only list the models and files that would be packed, and run the scan\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--force")"
    printf "    🔓 Export even if the scan finds secrets (when they are not real ones)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--include-artifacts")"
    printf "    📎 Also pack the files outside the repository the models need (connector zip\n    / jar, files referenced by absolute path)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-clipboard")"
    printf "    📋 Do not copy the bundle to the clipboard (macOS)\n"
    echo

    if [[ -n "${PLAYGROUND_SHOW_PRIVATE:-}" ]]; then
      # :flag.usage
      printf "  %s\n" "$(magenta "--clipboard")"
      printf "    📋 Former flag: the bundle is now copied to the clipboard by default\n"
      echo

    fi

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground repro export\n"
    printf "  playground repro export -f\n  ~/kafka-docker-playground/reproduction-models/connect-connect-http-sink/http-repro-123456-dlq.sh\n  --dry-run\n"
    printf "  playground repro export --all-uncommitted --output ~/Desktop\n"
    printf "  playground repro export --include-artifacts\n"
    echo

  fi
}

# :command.usage
playground_repro_check_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground repro check\n\n"
    printf "  🕵️ Scan reproduction models for secrets and customer data before they are\n  committed\n  \n  Runs the scan of 'playground repro export' on the files of the\n  reproduction models, without packing anything. It stops (exit code 1)\n  when a file contains the value of a credential known to this machine\n  ('playground secrets' store, exported credential variables,\n  CLUSTER_CREDS / SCHEMA_REGISTRY_CREDS of playground.ini,\n  ~/.aws/credentials) or a well-known token format (AWS access key id,\n  private key, GitHub / Slack token, Google API key, JWT, Azure storage\n  account key), and when a credential file (keyfile.json, *.pem, *.key,\n  *.p12, *.jks, secrets.properties, playground.ini) is about to be\n  committed. Email addresses, public IP addresses, hard-coded passwords\n  that do not come from the base example, and dumps, logs or archives\n  are reported as possible customer data, without failing. Values are\n  never printed.\n  \n  Without flag, the new and modified files of reproduction-models are\n  checked. Symlinks to the public examples are not.\n  \n  🪝 'playground repro bootstrap' and 'playground repro import' set up a\n  pre-commit hook in reproduction-models (git config core.hooksPath\n  <playground>/scripts/repro-git-hooks) that runs\n  'playground repro check --staged --skip-secrets-store' on every commit.\n  An existing pre-commit hook or core.hooksPath is never replaced. To skip\n  the scan of one commit: git commit --no-verify, or\n  PLAYGROUND_REPRO_SCAN=skip git commit. PLAYGROUND_REPRO_SCAN=full also\n  reads the 'playground secrets' store.\n\n"
  else
    printf "playground repro check - 🕵️ Scan reproduction models for secrets and customer data before they are committed\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground repro check [OPTIONS]\n"
  printf "  playground repro check --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
