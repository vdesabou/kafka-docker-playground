# :command.function
playground_get_ci_result_command() {

  # src/commands/get-ci-result.sh
  test="${args[--test]}"
  environment_flag="${args[--environment]}"
  podman="${args[--podman]}"
  logs="${args[--logs]}"
  max_findings="${args[--max-findings]}"
  output_dir="${args[--output-dir]}"
  no_open="${args[--no-open]}"

  if [[ -n "$test" ]]
  then
      # accept a directory or a script, absolute or relative to the repository
      test="${test#$root_folder/}"
      test="${test%/}"
      if [[ "$test" == *.sh ]]
      then
          test="$(dirname "$test")"
      fi
      if [ ! -d "$root_folder/$test" ]
      then
          logerror "❌ --test $test is not an example directory of $root_folder"
          exit 1
      fi
      dir2="$test"
      environment="plaintext"
  else
      test_file=$(playground state get run.test_file)
      get_environment_used

      if [ ! -f $test_file ]
      then

          logerror "File $test_file retrieved from $root_folder/playground.ini does not exist!"
          exit 1
      fi

      test_file_directory="$(dirname "${test_file}")"
      base1="${test_file_directory##*/}" # connect-cdc-oracle12-source
      dir1="${test_file_directory%/*}" #connect
      dir2="${dir1##*/}/$base1" # connect/connect-cdc-oracle12-source
  fi

  if [[ -n "$environment_flag" ]]
  then
      environment="$environment_flag"
  fi

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  if [[ "$dir2" == reproduction-models* ]]
  then
      exit 0
  fi

  content_file="$tmp_dir/content.md"
  curl -s -o $content_file  https://kafka-docker-playground.io/content.md

  result_ok=""
  result_fail=""

  if [[ "$environment" == cfk* ]]
  then
      result_ok="$(grep "$dir2" $content_file | sed -n 's/.*\[CI_CFK \(ok\)\].*(\(https[^)]*\)).*/🤖CI status: 🟢 cfk ok\n🔗test url: \2/p')"
      result_fail="$(grep "$dir2" $content_file | sed -n 's/.*\[CI_CFK \(fail\)\].*(\(https[^)]*\)).*/🤖CI status: 🔴 cfk fail\n🐛 github issue: \2/p')"

      # Backward-compatible fallback when CI_CFK badge is missing.
      if [ -z "$result_ok" ] && [ -z "$result_fail" ]
      then
          result_ok="$(grep "$dir2" $content_file | sed -n 's/.*\[CI \(ok\)\].*(\(https[^)]*\)).*/🤖CI status: 🟢 ok\n🔗test url: \2/p')"
          result_fail="$(grep "$dir2" $content_file | sed -n 's/.*\[CI \(fail\)\].*(\(https[^)]*\)).*/🤖CI status: 🔴 fail\n🐛 github issue: \2/p')"
      fi
  else
      result_ok="$(grep "$dir2" $content_file | sed -n 's/.*\[CI \(ok\)\].*(\(https[^)]*\)).*/🤖CI status: 🟢 ok\n🔗test url: \2/p')"
      result_fail="$(grep "$dir2" $content_file | sed -n 's/.*\[CI \(fail\)\].*(\(https[^)]*\)).*/🤖CI status: 🔴 fail\n🐛 github issue: \2/p')"
  fi

  result_not_tested="$(grep "$dir2" $content_file | sed -n 's/.*\[not tested\].*/🤖CI status: 🤷‍♂️ not tested/p')"

  # print only result not empty
  if [ -n "$result_ok" ]
  then
      log "$result_ok"
  fi

  if [ -n "$result_fail" ]
  then
      logwarn "$result_fail"
  fi

  if [ -n "$result_not_tested" ]
  then
      log "$result_not_tested"
  fi

  if [[ ! -n "$logs" ]]
  then
      exit 0
  fi

  if [[ $(type -f gh 2>&1) =~ "not found" ]]
  then
      logerror "❌ --logs needs the GitHub CLI, visit https://cli.github.com/manual/installation to install"
      exit 1
  fi

  repo="vdesabou/kafka-docker-playground"

  # CI issue titles, see update-readme: only the first '-' becomes a '/' (multi-data-center/replicator-executable -> multi/data-center-replicator-executable)
  issue_dir=$(echo "$dir2" | sed 's/\//-/g' | sed 's/-/\//')
  title="🔥 $issue_dir"
  job_suffix_regex=" plaintext ?$"
  job_label="plaintext"
  if [[ "$environment" == cfk* ]] && [[ -n "$podman" ]]
  then
      title="🔥 $issue_dir (cfk, podman)"
      job_suffix_regex=" cfk 🦭$"
      job_label="cfk 🦭"
  elif [[ "$environment" == cfk* ]]
  then
      title="🔥 $issue_dir (cfk)"
      job_suffix_regex=" cfk ?$"
      job_label="cfk"
  elif [[ -n "$podman" ]]
  then
      title="🔥 $issue_dir (podman)"
      job_suffix_regex=" plaintext 🦭$"
      job_label="plaintext 🦭"
  fi

  issue_number=$(gh issue list --repo "$repo" --state open --search "\"$title\" in:title" --json number,title --limit 50 2>/dev/null | jq -r --arg title "$title" '.[] | select(.title == $title) | .number' | head -1)
  if [ -z "$issue_number" ]
  then
      log "✅ no open CI issue <$title>: no failure logs to show"
      exit 0
  fi

  # the latest CI occurrence: body or comment with a job url (human or triage comments have none)
  occurrence=$(gh issue view "$issue_number" --repo "$repo" --json body,comments -q '[.body] + [.comments[].body] | map(select(test("/actions/runs/[0-9]+/job/[0-9]+"))) | last')
  # the job url is on the '🔥 CP ...' header line: the embedded logs contain other job urls
  # (e.g. '🐛 github issue: .../job/...' printed by playground run), never take the last one
  job_url=$(echo "$occurrence" | grep -m1 -E "^🔥 CP " | grep -oE "https://github.com/$repo/actions/runs/[0-9]+/job/[0-9]+" | head -1)
  if [ -z "$job_url" ]
  then
      job_url=$(echo "$occurrence" | grep -oE "https://github.com/$repo/actions/runs/[0-9]+/job/[0-9]+" | head -1)
  fi
  if [ -z "$job_url" ]
  then
      logerror "❌ no CI job url found in issue #$issue_number (https://github.com/$repo/issues/$issue_number)"
      exit 1
  fi
  run_id=$(echo "$job_url" | sed -E 's#.*/runs/([0-9]+)/job/.*#\1#')

  # issues often link a sibling job of the same run: pick the one running this example in this environment
  run_json=$(gh run view "$run_id" --repo "$repo" --json jobs,headSha,createdAt 2>/dev/null)
  job_id=$(echo "$run_json" | jq -r --arg dir "$dir2" --arg suffix "$job_suffix_regex" '[.jobs[] | select(.name | contains(" " + $dir + " ")) | select(.name | test($suffix))][0].databaseId // empty')
  if [ -z "$job_id" ]
  then
      # the linked job runs other examples: reading it would only show unrelated scripts
      logwarn "🤷 issue #$issue_number links run $run_id, which has no '$job_label' job running $dir2: the issue may be stale (reported from another run's result)"
      echo "   🔗 $job_url"
      echo "   🐛 https://github.com/$repo/issues/$issue_number"
      exit 0
  fi
  head_sha=$(echo "$run_json" | jq -r '.headSha // empty')
  run_date=$(echo "$run_json" | jq -r '.createdAt // empty')

  header=$(echo "$occurrence" | grep -m1 -E "^🔥 CP " | sed -E 's/ 📄.*//')
  log "🔥 latest failure reported in https://github.com/$repo/issues/$issue_number"
  if [ -n "$header" ]
  then
      echo "   $header"
  fi
  echo "   🔗 https://github.com/$repo/actions/runs/$run_id/job/$job_id"
  echo "   🕐 run of $run_date on commit ${head_sha:0:9}"

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  # the full log: 'gh run view --log' truncates long jobs
  if ! gh api --allow-escape-sequences "repos/$repo/actions/jobs/$job_id/logs" > "$tmp_dir/job.log" 2> "$tmp_dir/error.log"
  then
      logerror "❌ could not download the log of job $job_id (logs are kept 90 days)"
      cat "$tmp_dir/error.log"
      exit 1
  fi
  sed -E -e 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //' -e 's/\x1b\[[0-9;]*m//g' "$tmp_dir/job.log" > "$tmp_dir/clean.log"

  # one section per script of the example: from "Executing <script> in dir <dir>" to its RESULT line
  awk -v dir="$dir2" -v out="$tmp_dir/section" '
      index($0, "🚀 Executing ") && index($0, " in dir " dir) && $0 ~ (" in dir " dir "$") {
          script = $0
          sub(/^.*🚀 Executing /, "", script)
          sub(/ in dir .*$/, "", script)
          n++
          file = out "-" n
          print script > (out "-" n ".name")
          close(out "-" n ".name")
          capture = 1
      }
      capture { print > file }
      capture && index($0, "RESULT: ") && index($0, " in dir " dir " ") {
          if (index($0, "RESULT: FAILURE")) print "failure" > (file ".status")
          else print "other" > (file ".status")
          close(file ".status")
          close(file)
          capture = 0
      }
  ' "$tmp_dir/clean.log"

  # every distinct record of the failing scripts, for the HTML report (see summarize_log_errors)
  records_file="$tmp_dir/records"
  : > "$records_file"
  section_args=()
  nb_failures=0
  for status_file in "$tmp_dir"/section-*.status
  do
      [ -f "$status_file" ] || continue
      if [ "$(cat "$status_file")" != "failure" ]
      then
          continue
      fi
      section="${status_file%.status}"
      script=$(cat "$section.name")
      nb_failures=$((nb_failures+1))
      echo ""
      log "🔥 $script failed, last lines before the failure:"
      awk '/RESULT: FAILURE for .* \(took/ { exit } { print }' "$section" | tail -25 > "$section.tail"
      sed 's/^/   /' "$section.tail"
      section_args+=(--section "🔥 $script: last lines before the failure" "$section.tail")
      echo ""
      log "🔎 ERROR/FATAL digest of $script in the CI job"
      # the runner's own failure messages are already shown above, keep the causes
      grep -v -E "RESULT: FAILURE|has failed after [0-9]+ attempts|^playground container display-error-all$|🔥 #+$" "$section" \
          | PG_LOG_DIGEST_RECORDS_FILE="$records_file" PG_LOG_DIGEST_LABEL="$script" summarize_log_errors "$max_findings" \
          | sed 's/ or narrow with --since$//'
  done

  if [ $nb_failures -gt 0 ]
  then
      echo ""
      report_name=$(printf '%s' "$dir2-${job_label%% *}${podman:+-podman}" | tr -c 'A-Za-z0-9._-' '_')
      write_log_records_report "$records_file" "$output_dir/ci-result-${report_name}-${job_id}.html" "$no_open" \
          --title "$dir2 ($job_label)" --heading "🤖 CI failure" --unit script \
          --command "playground get-ci-result --test $dir2 --logs" \
          --link "🐛 issue #$issue_number" "https://github.com/$repo/issues/$issue_number" \
          --link "🔗 job $job_id (run of $run_date, commit ${head_sha:0:9})" "https://github.com/$repo/actions/runs/$run_id/job/$job_id" \
          "${section_args[@]}"
  fi

  if [ $nb_failures -eq 0 ]
  then
      nb_passed=$(ls "$tmp_dir"/section-*.status 2>/dev/null | wc -l | tr -d ' ')
      if [ "$nb_passed" -gt 0 ]
      then
          log "✅ the $nb_passed script(s) of $dir2 run in job $job_id passed: issue #$issue_number may be stale (fixed since, or reported from an older result)"
      else
          logwarn "🤷 no script of $dir2 ran to completion in job $job_id, it may have been cancelled or timed out. Full log: gh api repos/$repo/actions/jobs/$job_id/logs"
      fi
  fi

}

# :command.function
playground_history_command() {

  # src/commands/history.sh
  if [ ! -f $root_folder/playground-run-history ]
  then
      logerror "❌ history could not be found !"
      logerror "$root_folder/playground-run-history does not exist"
      exit 1
  fi

  fzf_version=$(get_fzf_version)
  if version_gt $fzf_version "0.38"
  then
      fzf_option_wrap="--preview-window=40%,wrap"
      fzf_option_pointer="--pointer=👉"
      fzf_option_rounded="--border=rounded"
  else
      fzf_options=""
      fzf_option_pointer=""
      fzf_option_rounded=""
  fi

  tmp_dir=$(mktemp -d -t pg-XXXXXXXXXX)
  if [ -z "$PG_VERBOSE_MODE" ]
  then
      trap 'rm -rf $tmp_dir' EXIT
  else
      log "🐛📂 not deleting tmp dir $tmp_dir"
  fi

  tac $root_folder/playground-run-history > $tmp_dir/tmp
  awk '!seen[$0]++' $tmp_dir/tmp > $tmp_dir/tmp2
  res=$(cat $tmp_dir/tmp2 | sed '/^$/d' | fzf --margin=1%,1%,1%,1% $fzf_option_rounded --info=inline --cycle --prompt="🏰" --header="ctrl-c or esc to quit" --color="bg:-1,bg+:-1,info:#BDBB72,border:#FFFFFF,spinner:0,hl:#beb665,fg:#00f7f7,header:#5CC9F5,fg+:#beb665,pointer:#E12672,marker:#5CC9F5,prompt:#98BEDE" --delimiter "kafka-docker-playground" --with-nth "2,3,4" $fzf_option_wrap $fzf_option_pointer)

  # Prompt the user to edit the res variable
  read -e -p "" -i "$res" edited_res

  # Use the edited value if it is not empty
  if [[ -n "$edited_res" ]]
  then
    res="$edited_res"
  fi

  $res
}

# :command.function
playground_find_example_command() {

  # src/commands/find-example.sh
  query="${args[query]}"
  category="${args[--category]}"
  limit="${args[--limit]}"
  json="${args[--json]}"

  if [ ${#other_args[@]} -gt 0 ]
  then
      query="$query ${other_args[*]}"
  fi

  hits=$(find_examples "$query" "$limit" "$category")

  if [[ -n "$json" ]]
  then
      # one object per hit, fields in the order printed by find_examples
      if [ -z "$hits" ]
      then
          echo "[]"
          exit 1
      fi
      echo "$hits" | jq -R -s --arg root "$root_folder" '
          split("\n") | map(select(length > 0) | split("\t")) | map({
              script: ($root + "/" + .[1]),
              path: .[1],
              title: .[2],
              connector_classes: ((.[3] // "") | split(" ") | map(select(length > 0))),
              environment: (.[4] // ""),
              score: (.[0] | tonumber),
              run_command: ("playground run -f " + $root + "/" + .[1])
          })'
      exit 0
  fi

  if [ -z "$hits" ]
  then
      logwarn "❌ no example matches all the words of \"$query\"${category:+ in $category/}"
      exit 1
  fi

  log "🔎 examples matching \"$query\"${category:+ in $category/}, best first"
  while IFS=$'\t' read -r score script title classes environment
  do
      details="$title"
      if [[ -n "$classes" ]]
      then
          details="${details:+$details · }$classes"
      fi
      if [[ -n "$environment" ]]
      then
          details="${details:+$details · }$environment"
      fi
      echo "playground run -f $root_folder/$script"
      if [[ -n "$details" ]]
      then
          echo "    ${details}"
      fi
  done <<< "$hits"

}

# :command.function
playground_start_environment_command() {

  # src/commands/start-environment.sh
  IGNORE_CHECK_FOR_DOCKER_COMPOSE=true

  environment="${args[--environment]}"
  docker_compose_override_file="${args[--docker-compose-override-file]}"
  wait_for_control_center="${args[--wait-for-control-center]}"
  no_stop="${args[--no-stop]}"
  rbac_role_bindings_file="${args[--rbac-role-bindings-file]}"

  if [ "$environment" = "ccloud" ]
  then
    test_file="$root_folder/ccloud/environment/start.sh"
  else
    test_file="$root_folder/environment/$environment/start.sh"
  fi
  test_file_directory="$(dirname "${test_file}")"

  # a new environment invalidates any previous switch-ccloud, otherwise create-or-update
  # and get-connector-list keep resolving the stale environment
  playground state del run.environment_before_switch
  playground state del run.connector_type_before_switch

  if [[ ! -n "$no_stop" ]]
  then
      set +e
      container_kill_all_before_run=$(playground config get container-kill-all-before-run)
      if [ "$container_kill_all_before_run" == "" ]
      then
          playground config set container-kill-all-before-run false
      fi

      if [ "$container_kill_all_before_run" == "true" ] || [ "$container_kill_all_before_run" == "" ]
      then
          log "💀 kill all docker containers (disable with 'playground config container-kill-all-before-run false')"
          playground container kill-all
      else
          playground stop
      fi
      set -e
  fi

  if [[ -n "$wait_for_control_center" ]]
  then
    export WAIT_FOR_CONTROL_CENTER=1
  fi

  if [[ -n "$no_stop" ]]
  then
    export NO_STOP=1
  fi

  if [[ -n "$rbac_role_bindings_file" ]]
  then
    if [ "$environment" != "rbac-sasl-plain" ]
    then
      logerror "❌ --rbac-role-bindings-file only works with --environment rbac-sasl-plain (it is $environment)"
      exit 1
    fi
    export RBAC_ROLE_BINDINGS_FILE="$rbac_role_bindings_file"
  fi

  # Handle --service flag (can be passed multiple times)
  services_list="${args[--service]}"
  if [[ -n "$services_list" ]]
  then
    eval "service_array=($services_list)"
    START_SERVICES="${service_array[*]}"
    export START_SERVICES
  fi

  # playground run --enable-multiple-connect-workers: connect2 and connect3 get the
  # connect configuration of the example, in a generated copy of its override file,
  # instead of editing the example's own file. Compose resolves relative paths from
  # the first -f file, so the copy can live anywhere; it keeps the <folder>/<example>
  # end of the path, which check_arm64_support relies on
  if [ -n "$ENABLE_CONNECT_NODES" ] && [[ "$environment" != cfk* ]] && [ -f "$docker_compose_override_file" ]
  then
    example_dir="$(dirname "$docker_compose_override_file")"
    generated_override_dir="${PLAYGROUND_HOST_TMP_DIR:-/tmp}/playground-connect-workers/$(basename "$(dirname "$example_dir")")/$(basename "$example_dir")"
    mkdir -p "$generated_override_dir"
    generated_override_file="$generated_override_dir/$(basename "$docker_compose_override_file")"
    yq '.services.connect2 = (.services.connect // {}) | .services.connect3 = (.services.connect // {})' "$docker_compose_override_file" > "$generated_override_file"
    log "🥉 connect2 and connect3 use the connect configuration of $(basename "$docker_compose_override_file") (generated $generated_override_file)"
    docker_compose_override_file="$generated_override_file"
  fi

  cd $test_file_directory
  if [ -f $docker_compose_override_file ]
  then
    $test_file "$docker_compose_override_file"
  else
    $test_file
  fi

  # playground run --connect-log-level: connect is ready, the example has not created its connector yet
  apply_connect_log_levels

}

# :command.function
playground_switch_ccloud_command() {

  # src/commands/switch-ccloud.sh
  log "🌩️ switch to ccloud environment"

  for item in {ENVIRONMENT,CLUSTER_NAME,CLUSTER_CLOUD,CLUSTER_REGION,CLUSTER_CREDS,SCHEMA_REGISTRY_CREDS}
  do
      i=$(playground state get "ccloud.${item}")
      if [ "$i" == "" ]
      then
          logerror "ccloud.${item} is missing"
          logerror "a ccloud example was probably not executed before"
          exit 1
      fi
  done

  ENVIRONMENT=$(playground state get ccloud.ENVIRONMENT)
  CLUSTER_NAME=$(playground state get ccloud.CLUSTER_NAME)
  CLUSTER_CLOUD=$(playground state get ccloud.CLUSTER_CLOUD)
  CLUSTER_REGION=$(playground state get ccloud.CLUSTER_REGION)
  CLUSTER_CREDS=$(playground state get ccloud.CLUSTER_CREDS)
  SCHEMA_REGISTRY_CREDS=$(playground state get ccloud.SCHEMA_REGISTRY_CREDS)

  playground state set run.environment_before_switch "$(playground state get run.environment)"
  playground state set run.connector_type_before_switch "$(playground state get run.connector_type)"
  playground state set run.connector_type "$CONNECTOR_TYPE_FULLY_MANAGED"

  log "🔌 bootstrapping ccloud environment"
  bootstrap_ccloud_environment
}

