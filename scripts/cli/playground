    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--throughput THROUGHPUT")"
    printf "    🐢 Maximum number of records per second (default is 0, no limit)\n    \n    Useful with --nb-messages -1 to get a steady flow of records, for example:\n    \n    playground topic produce -t a-topic --nb-messages -1 --throughput 10 --value\n    '{\"id\": %%g}'\n"
    printf "    %s\n" "Default: 0"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--nb-partitions NB-PARTITIONS")"
    printf "    🔢 Number of partitions for the topic. (default is 1)\n    \n    ❌ Important: if the topic exists with another number of partitions, it is\n    re-created when it\n    is empty, and the command fails when it is not.\n"
