# :command.usage
playground_connector_wait_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground connector wait\n\n"
    printf "  ⏳ Wait for connectors to reach a state\n  \n  Polls the connector status every --interval seconds until the connector\n  and all its tasks are in --state (RUNNING by default), and fails after\n  --max-wait seconds, displaying the status with the stack trace.\n  \n  RUNNING is only reached when the connector and its tasks are still\n  RUNNING one --interval later, since a task is RUNNING before it\n  processes its first record and can fail right after.\n  \n  When waiting for RUNNING, it fails right away if the connector or one of\n  its tasks is FAILED, since a failed task does not recover on its own,\n  and runs 'playground connector diagnose --no-open' on it: status with\n  the trace, digest of the connect errors since the wait started, offsets,\n  next steps and HTML report (PG_SKIP_AUTO_DIAGNOSE=1 for the status only).\n  A connector RUNNING without any task for 30 seconds (Replicator without\n  matching topic yet, JDBC source without table) is accepted with a\n  warning. A Datagen task that failed with \"Stopping connector: generated\n  the configured N number of messages\" (\"iterations\" reached) is\n  completed, not FAILED, and counts as RUNNING.\n  For the same reason, --state FAILED is reached as soon as the connector\n  or one of its tasks is FAILED (the connector itself usually stays\n  RUNNING when only a task fails).\n  \n  🎓 Tip: 'connector create-or-update' already waits for RUNNING. Use\n  it for another state, or after 'connector create-or-update --no-wait'.\n  \n  🍪 Deep dive:\n  https://kafka-docker-playground.io/#/deep-dive-connector-create-or-update\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%94%%8C-the-sink-fails-right-after-it-is-deployed\n\n"
  else
    printf "playground connector wait - ⏳ Wait for connectors to reach a state\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground connector wait [OPTIONS]\n"
  printf "  playground connector wait --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--verbose, -v")"
    printf "    🐞 Show command being ran.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--connector, -c CONNECTOR")"
    printf "    🔗 Connector name\n    \n    🎓 Tip: If not specified, the command will apply to all connectors\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--state STATE")"
    printf "    🎯 State to wait for (default is RUNNING)\n"
    printf "    %s\n" "Allowed: RUNNING, PAUSED, STOPPED, FAILED"
    printf "    %s\n" "Default: RUNNING"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-wait MAX_WAIT")"
    printf "    ⏳ Max time in seconds to wait (default is 120)\n"
    printf "    %s\n" "Default: 120"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--interval INTERVAL")"
    printf "    🔁 Interval in seconds between status checks (default is 5)\n"
    printf "    %s\n" "Default: 5"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_environment_variables
    printf "%s\n" "$(bold "Environment Variables:")"

    # :environment_variable.usage
    printf "  %s\n" "$(cyan "PG_SKIP_AUTO_DIAGNOSE")"
    printf "    🩺 Set to 1 to display only the status of a FAILED connector, instead of\n    running 'connector diagnose' on it (also for create-or-update)\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground connector wait --connector filestream-sink\n"
    printf "  playground connector wait --connector filestream-sink --state PAUSED\n  --max-wait 60\n"
    echo

  fi
}

