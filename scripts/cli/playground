    printf "  🐢 Show lag of sink connector\n  \n  The consumer lag of the sink, refreshed every --interval seconds, so you\n  see whether it is catching up, standing still or falling behind. A lag\n  that does not move while the connector reports RUNNING means the tasks\n  are stuck rather than slow.\n  \n  It will run until all lag becomes 0 (press ctrl-c to exit)\n  \n  🍪 Deep dive: https://kafka-docker-playground.io/#/deep-dive-offsets-and-lag\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%E2%%8F%%AA-the-lag-of-a-sink-is-stuck\n\n"
  else
    printf "playground connector show-lag - 🐢 Show lag of sink connector\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground connector show-lag [OPTIONS]\n"
  printf "  playground connector show-lag --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--verbose, -v")"
    printf "    🐞 Show command being ran.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--connector, -c CONNECTOR")"
    printf "    🔗 Connector name\n    \n    🎓 Tip: If not specified, the command will apply to all connectors\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--interval INTERVAL")"
    printf "    Interval between lag checks (default is 20 seconds).\n"
    printf "    %s\n" "Default: 20"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-wait MAX_WAIT")"
    printf "    ⏳ Max time in seconds to wait for lag to become 0. If set to 0 (default), it\n    will run until all lag becomes 0.\n"
    printf "    %s\n" "Default: 0"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground connector show-lag\n"
    echo

  fi
}

# :command.usage
playground_connector_benchmark_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground connector benchmark\n\n"
    printf "  🏎️ Benchmark the throughput of a connector\n  \n  Measures how many records per second a running self managed connector\n  processes, so that two runs can be compared: another --connector-tag,\n  another batch size, another number of tasks. Everything runs on one\n  docker host, so the numbers are relative: compare runs on the same\n  machine only.\n  \n  🎓 Tip: playground run --benchmark runs it right after the example (also\n  a toggle in the playground run menu).\n  \n  --mode drain (default) pauses the connector, loads a backlog of\n  --nb-records, resumes the connector and measures the time it takes to\n  process the backlog. This is the most reproducible number, since it does\n  not depend on how fast the load is generated.\n  \n  --mode steady measures the throughput during --duration (after\n  --warmup), while --stream-load-command runs in the background. When the\n  connector simply keeps up with the load (consumer lag of a sink, records\n  generated by the load of a source), the summary says so: the result is\n  then the speed of the load, not of the connector.\n  \n  ⏱️ For a source connector, --mode steady also measures the end-to-end\n  latency of the records: kafka record timestamp - time of the change in\n  the source system (a field of the value). After the measure, the\n  benchmark reads the records written to the topics of the connector\n  during it (all of them up to 100000, a sample spread over the measure\n  otherwise), and the summary, the result json and the report give its\n  p50 / p95 / p99 / max (over time, distribution, slowest records), also\n  in the comparable runs and the --connector-tag comparisons. When the\n  connector simply keeps up with the load, this is the number to compare.\n  The field is --latency-field, or the one the load writes the time of\n  the change to (create_ts of the CUSTOMERS table, update_ts with --shape\n  update), or source.ts_ms of a CDC envelope (commit time in the\n  database), or wallTime / clusterTime of a MongoDB change event. It is\n  not measured in a drain, where the latency of a record is the time it\n  waited in the backlog.\n  \n  The load comes from the example:\n  \n    - sink connectors: the 'playground topic produce' of the example\n      script that feeds the connector is replayed with --nb-messages\n      <n> (same schema, key and headers), so every sink example that\n      produces its data works without anything else\n    - source connectors: benchmark-load.bash next to the example\n      script, called with --records <n> --mode preload|stream --shape\n      bulk|small-txn|update (rows in the CUSTOMERS table for the\n      postgres, mysql, oracle and sql server examples, documents for\n      mongodb, messages for ibm mq, mqtt, activemq, sqs, kinesis,\n      pub/sub and cloudwatch logs, files for spool dir, filepulse,\n      filestream, sftp, ftps, hdfs 2 / 3 and the generalized s3, gcs and\n      azure blob storage sources, see the README of the example). It is\n      called with --check first, so that an unsupported\n      combination fails before the connector is paused\n    - or --load-command / --stream-load-command, which take precedence\n  \n  BENCHMARK_LOAD_SCRIPT=<file> uses another load script than\n  benchmark-load.bash: a file name in the folder of the example (or an\n  absolute path), e.g. one per reproduction model named after its ticket\n  (BENCHMARK_LOAD_SCRIPT=benchmark-load-123456.bash). It takes the same\n  arguments, and --enable-sql-datagen uses it too.\n  \n  Throughput is read from the connect JMX metrics of the tasks\n  (sink-record-read-total: records read from kafka, including the ones\n  filtered or sent to the dlq; source-record-write-total), sampled every\n  --interval. Results are written to --output-dir (samples csv, result\n  json and an html report with the charts, opened in the browser at the\n  end in an interactive terminal) and appended to the benchmark-history\n  file, and the summary compares them with the previous benchmark of the\n  same connector in the same example (or with --compare <result json>).\n  \n  Each result records the setup it ran on (host cpu and memory, container\n  engine resources, connect image and whether it is emulated, jvm and\n  heap, number of workers and brokers, environment, connector config with\n  secrets masked): the report shows it, and the summary warns when the\n  previous run was on a different setup.\n  \n  🛩️ The connect workers are recorded with Java Flight Recorder during\n  the measure (over JMX: the cp images have no jcmd, nothing is\n  restarted), and the report and the summary say where the time of the\n  task threads went: running, blocked on the system behind the\n  connector, in the Kafka client, locks, waits; the CPU by layer\n  (connector, converters, SMTs, Kafka client, libraries, logging), hot\n  methods, allocation, GC, exceptions, with findings and next steps.\n  With --connector-tag, the versions are compared the same way. The\n  recording costs a few %% of throughput: --no-flight-recorder disables\n  it, and the summary warns when the previous run was not recorded the\n  same way. The .jfr files are kept in --output-dir (JDK Mission\n  Control, or playground analyze flight-recorder).\n  \n  📊 When Grafana runs (example started with --enable-jmx-grafana,\n  or --enable-sql-datagen), the measure is annotated on the Kafka\n  Connect, connector (Debezium, Oracle CDC, XStream, MongoDB) and\n  Kafka cluster dashboards, and the summary and the report link to\n  them at the time of the run (each version is annotated with\n  --connector-tag). Grafana is not started by the benchmark: its\n  JMX exporter and containers use CPU, and the summary warns when\n  the previous run was not measured the same way.\n  \n  ☁️ Fully managed source connectors (ccloud/fm-*-source examples that\n  ship a benchmark-load.bash, the one of the equivalent self managed\n  example: same local database or broker, reached by the connector\n  through ngrok): the records are counted from the end offsets of the\n  topics of the connector every --interval (its kafka.topic or\n  topic.prefix, and the topics consumed by the example script,\n  --topic to choose them), since Confluent Cloud gives no JMX: no batch\n  time, running ratio, cpu, gc, flight recorder nor --connector-tag.\n  A drain starts measuring at the first records seen after the resume\n  (Confluent Cloud takes a few seconds to restart the tasks, and its\n  status lags behind them), so the records seen by that first sample\n  are not measured. The throughput includes the network between the\n  docker host and Confluent Cloud. Run the example and answer n when it asks to\n  delete the connector, then run the benchmark.\n  \n  ☁️ Fully managed sink connectors: the load is the replay of the\n  'playground topic produce' of the example, like for a self managed\n  sink, and the records are counted from the offsets committed by the\n  consumer group of the connector (connect-<lcc id>). Confluent Cloud\n  commits them about every minute, so the end of a drain is known\n  within one commit interval: a drain that sees less than 5 commits\n  is reported as a lower bound, and the summary gives the\n  --nb-records of a drain of 10 commits (within ~10%%, usually 1M\n  records or more).\n  \n  📈 After the measure of a fully managed connector, the benchmark\n  reads its per minute metrics in the Confluent Cloud Metrics API\n  (sent_records / received_records, exact counts published about 30s\n  into each minute): the steady throughput is the median of the full\n  minutes of the measure (a drain of 3 minutes or more has one), which\n  does not depend on when a sink commits its offsets, and the put batch\n  time, batch size and dlq records fill the rows that JMX gives for a\n  self managed connector. The Metrics API uses the Cloud API key\n  (CONFLUENT_CLOUD_API_KEY) and does not answer for a deleted connector.\n  \n  ⚠️ Not available with the cfk environment yet.\n  \n  🍪 Deep dive:\n  https://kafka-docker-playground.io/#/deep-dive-connector-benchmark\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%93%%88-is-version-y-slower-benchmark-two-versions\n\n"
  else
    printf "playground connector benchmark - 🏎️ Benchmark the throughput of a connector\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground connector benchmark [OPTIONS]\n"
  printf "  playground connector benchmark --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--verbose, -v")"
    printf "    🐞 Show command being ran.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--connector, -c CONNECTOR")"
    printf "    🔗 Connector name\n    \n    🎓 Tip: not needed when only one connector is running\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--mode MODE")"
    printf "    🏁 drain (time to process a backlog of --nb-records) or steady (throughput\n    during --duration)\n"
    printf "    %s\n" "Allowed: drain, steady"
    printf "    %s\n" "Default: drain"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--nb-records NB-RECORDS")"
    printf "    💯 Number of records of the backlog in drain mode (default is 100000)\n"
    printf "    %s\n" "Default: 100000"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--shape SHAPE")"
    printf "    🧱 Shape of the load, passed to benchmark-load.bash (default is bulk)\n    \n    - bulk: one transaction with all the records\n    - small-txn: one transaction per record\n    - update: updates existing records\n    - delete: deletes existing records (drain only; not for a JDBC source, which\n    does not capture deletes; with Debezium or XStream, each deleted row also\n    gives a tombstone, unless tombstones.on.delete=false)\n    \n    A sequence of shapes, e.g. bulk,update,delete, runs one drain per shape on\n    the same rows (insert, update, then delete them) and compares the phases in\n    the summary and the report. Drain of a source connector only.\n"
    printf "    %s\n" "Default: bulk"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--record-size RECORD-SIZE")"
    printf "    🏋️ Record size in bytes, passed to benchmark-load.bash (default is 0: size\n    given by the load)\n"
    printf "    %s\n" "Default: 0"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--load-command LOAD-COMMAND")"
    printf "    📥 Command that loads the backlog in drain mode, instead of\n    benchmark-load.bash (or of the replayed produce of a sink)\n    \n    It runs with bash -c, from the current directory, while the connector is\n    paused. It must create the records and return: --nb-records is then the\n    number of records the connector should process, unless the command prints a\n    line BENCHMARK_RECORDS=<n>.\n    \n    Examples:\n    \n      # sink: 1M records in the topic of the connector (use the schema of its\n    records)\n      --nb-records 1000000 --load-command \"playground topic produce -t my-topic\n    --nb-messages 1000000 --value @predefined-schemas/avro/customer.avsc\"\n    \n      # source: your own script, which inserts the rows and prints\n    BENCHMARK_RECORDS=<n>\n      --load-command \"./load-my-table.sh 500000\"\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--stream-load-command STREAM-LOAD-COMMAND")"
    printf "    🌊 Command that generates load continuously in steady mode, instead of\n    benchmark-load.bash (or of the replayed produce of a sink)\n    \n    It runs in the background with bash -c, from the current directory. At the\n    end of the measure, the file named by the BENCHMARK_STOP_FILE environment\n    variable is created: the command should stop at the end of its current batch\n    when it exists. It is killed after 120s otherwise, and killing a producer in\n    the middle of a batch can send a truncated record to the topic. If it prints\n    BENCHMARK_BATCH=<records> <epoch seconds> after each batch, the summary\n    tells when the connector only kept up with the load.\n    \n    Example, batches of 10000 records in the topic of the connector until the\n    end of the measure:\n    \n      --stream-load-command 'while [ ! -f \"\$BENCHMARK_STOP_FILE\" ]; do\n    playground topic produce -t my-topic --nb-messages 10000 --value\n    @predefined-schemas/avro/customer.avsc; echo \"BENCHMARK_BATCH=10000 \$(date\n    +%%s)\"; done'\n    \n    A line BENCHMARK_LATENCY_FIELD=<field> tells which field of the records of a\n    source holds the time of the change, for the end-to-end latency (see\n    --latency-field).\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--topic, -t TOPIC (repeatable)")"
    printf "    🗳 Topics to count records in at the end of a drain, to check the result of a\n    source connector (default is the topics of the connector)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--duration DURATION")"
    printf "    ⏱️ Duration of the measure in steady mode, in seconds or with a s/m/h suffix\n    (default is 5m)\n"
    printf "    %s\n" "Default: 5m"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--warmup WARMUP")"
    printf "    🔥 Time excluded from the measure at the beginning in steady mode (default is\n    30s)\n"
    printf "    %s\n" "Default: 30s"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--interval INTERVAL")"
    printf "    🔁 Interval between samples (default is 5s)\n"
    printf "    %s\n" "Default: 5s"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-wait MAX-WAIT")"
    printf "    ⏳ Max time to wait for the backlog to be processed in drain mode (default is\n    30m)\n"
    printf "    %s\n" "Default: 30m"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--connector-tag CONNECTOR-TAG (repeatable)")"
    printf "    🧩 Benchmark these versions of the connector plugin one after the other\n    (repeat the flag), and compare them\n    \n    For each version: playground update-version --connector-tag (only the\n    connect container is restarted, the connector and its offsets are kept),\n    check that the connector runs the requested version, an untimed warm-up\n    drain (the worker jvm was restarted), then the benchmark. The original\n    version is restored at the end, and the summary and the report compare the\n    versions.\n    \n    Example: --connector-tag 10.8.4 --connector-tag 10.9.9\n    \n    ⚠️ A downgrade or a major version change can be incompatible with the\n    offsets or the config of the connector: the benchmark stops at the first\n    FAILED state.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--rounds ROUNDS")"
    printf "    🔁 With --connector-tag, number of rounds over the versions (default is 1): 2\n    alternates them (A B A B), which shows a drift from one run to the next\n"
    printf "    %s\n" "Default: 1"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--output-dir OUTPUT-DIR")"
    printf "    📂 Folder for the samples csv, the result json and the html report (default\n    is /tmp/playground-benchmark)\n"
    printf "    %s\n" "Default: /tmp/playground-benchmark"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--compare COMPARE")"
    printf "    ⚖️ Result json of a previous benchmark to compare with (default is the\n    previous benchmark of the same connector in the same example, from the\n    benchmark-history file)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-history")"
    printf "    🙈 Do not append the result to the benchmark-history file\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--sessions SESSIONS")"
    printf "    🧵 Run the benchmark-load.bash of the example in <sessions> parallel sessions\n    (default is 1)\n    \n    A drain splits --nb-records between them, steady mode gives each session\n    batches of --nb-records. Concurrent transactions are what a busy database\n    looks like to a CDC connector (interleaved transactions in the redo log or\n    the WAL, several open transactions). Only with the benchmark-load.bash of\n    the example, not with --load-command.\n"
    printf "    %s\n" "Default: 1"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-flight-recorder")"
    printf "    🛩️ Do not record the connect workers with Java Flight Recorder during the\n    measure (no \"where the time goes\" section in the report)\n    \n    The recording costs a few %% of throughput: compare runs recorded the same\n    way.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--latency-field LATENCY-FIELD")"
    printf "    ⏱️ Field of the records of a source connector that holds the time of the\n    change in the source system, for the end-to-end latency measured in --mode\n    steady (kafka record timestamp - this field)\n    \n    A dotted path for a nested field (after.create_ts, source.ts_ms), matched\n    case insensitively, through avro unions. Its value can be an epoch in s, ms,\n    µs or ns, an ISO-8601 string, or a MongoDB date or timestamp.\n    \n    Default: the field the load writes the time of the change to\n    (BENCHMARK_LATENCY_FIELD printed by benchmark-load.bash: create_ts of the\n    CUSTOMERS table, update_ts with --shape update), otherwise source.ts_ms of a\n    CDC envelope (commit time in the database), wallTime or clusterTime of a\n    MongoDB change event.\n    \n    🎓 Tip: use a column with milliseconds (TIMESTAMP(3)), and --shape small-txn:\n    with --shape bulk, a default CURRENT_TIMESTAMP is the start of the\n    transaction of the whole batch.\n"
    printf "    %s\n" "Conflicts: --no-latency"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-latency")"
    printf "    🙈 Do not measure the end-to-end latency of a source connector in --mode\n    steady (it reads the records of the measure after it)\n"
    printf "    %s\n" "Conflicts: --latency-field"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--json")"
    printf "    📄 Print the result as json instead of the summary\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_environment_variables
    printf "%s\n" "$(bold "Environment Variables:")"

    # :environment_variable.usage
    printf "  %s\n" "$(cyan "BENCHMARK_LOAD_SCRIPT")"
    printf "    📜 Load script to use instead of benchmark-load.bash: a file of the example\n    folder, or an absolute path\n"
    echo

    if [[ -n "${PLAYGROUND_SHOW_PRIVATE:-}" ]]; then
      # :environment_variable.usage
      printf "  %s\n" "$(cyan "BENCHMARK_MATRIX_CHILD")"
      printf "    Set for the child runs of --shape / --connector-tag matrices (internal)\n"
      echo

    fi
    if [[ -n "${PLAYGROUND_SHOW_PRIVATE:-}" ]]; then
      # :environment_variable.usage
      printf "  %s\n" "$(cyan "BENCHMARK_MATRIX_RESULTS")"
      printf "    File where a child run appends its result file (internal)\n"
      echo

    fi
    if [[ -n "${PLAYGROUND_SHOW_PRIVATE:-}" ]]; then
      # :environment_variable.usage
      printf "  %s\n" "$(cyan "BENCHMARK_NO_OPEN")"
      printf "    Do not open the HTML report in a browser (internal)\n"
      echo

    fi

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground connector benchmark --connector filestream-sink --nb-records\n  3000000\n"
    printf "  playground connector benchmark --connector jdbc-postgres-source --nb-records\n  1000000 --shape small-txn\n"
    printf "  playground connector benchmark --mode steady --duration 2m --warmup 20s\n"
    printf "  playground connector benchmark --connector debezium-postgres-source --mode\n  steady --duration 2m --shape small-txn --latency-field after.create_ts\n"
    printf "  playground connector benchmark --nb-records 1000000 --load-command \"playground\n  topic produce -t my-topic --nb-messages 1000000 --value\n  @predefined-schemas/avro/customer.avsc\"\n"
    printf "  playground connector benchmark --mode steady --duration 2m\n  --stream-load-command 'while [ ! -f \"\$BENCHMARK_STOP_FILE\" ]; do playground\n  topic produce -t my-topic --nb-messages 10000 --value\n  @predefined-schemas/avro/customer.avsc; echo \"BENCHMARK_BATCH=10000 \$(date\n  +%%s)\"; done'\n"
    printf "  playground connector benchmark --load-command \"./my-load.sh\" --json\n"
    printf "  playground connector benchmark --nb-records 1000000 --connector-tag 10.8.4\n  --connector-tag 10.9.9 --rounds 2\n"
    printf "  playground connector benchmark --nb-records 1000000 --no-flight-recorder\n"
    printf "  playground connector benchmark --nb-records 1000000 --shape small-txn\n  --sessions 5\n"
    printf "  playground connector benchmark --nb-records 500000 --shape bulk,update,delete\n"
    echo

  fi
}

