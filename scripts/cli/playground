      logerror "  export DOCKER_HOST=\"unix:///run/podman-api/podman.sock\""
    fi
  else
    logerror "Is the docker daemon running?"
  fi
  if [ -z "${1:-}" ]
  then
    logerror "👉 run 'playground doctor' for a full check of the container engine"
  fi
}

