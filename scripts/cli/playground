# :command.function
playground_consumer_group_describe_command() {

  # src/commands/consumer-group/describe.sh
  group="${args[--group]}"
  members="${args[--members]}"
  state="${args[--state]}"
  verbose="${args[--verbose]}"

  # kafka-consumer-groups exits 0 on errors such as an unknown group, detect them from the output
  function describe_group() {
      set +e
      output=$(run_kafka_admin_tool kafka-consumer-groups --describe --group "$group" "$@" 2>&1)
      set -e
      error=$(echo "$output" | grep -m1 "^Error: " || true)
      if [ -n "$error" ]
      then
          logerror "❌ Failed to describe consumer group $group: ${error#Error: }"
          exit 1
      fi
      echo "$output"
  }

  if [[ ! -n "$group" ]]
  then
      log "✨ --group flag was not provided, applying command to all consumer groups"
      group=$(playground get-consumer-group-list)
      if [ "$group" == "" ]
      then
          logerror "❌ No consumer group found !"
          exit 1
      fi
  fi

  items=($group)
  for group in "${items[@]}"
  do
      log "🔬 Describing consumer group $group"
      if [[ -n "$state" ]]
      then
          describe_group --state
      fi
      if [[ -n "$members" ]]
      then
          describe_group --members --verbose
      fi
      if [[ -z "$state" ]] && [[ -z "$members" ]]
      then
          describe_group
          # LAG is the 6th column, it is "-" when the group has no committed offset for the partition
          total_lag=$(echo "$output" | awk '$1 != "GROUP" && $6 ~ /^[0-9]+$/ {sum += $6; found = 1} END {if (found) print sum}')
          if [ -n "$total_lag" ]
          then
              if [ "$total_lag" == "0" ]
              then
                  log "🏁 Total lag for consumer group $group: 0"
              else
                  log "🐢 Total lag for consumer group $group: $total_lag"
              fi
          fi
      fi
  done

}

# :command.function
playground_consumer_group_reset_offsets_command() {

  # src/commands/consumer-group/reset-offsets.sh
  group="${args[--group]}"
  topic="${args[--topic]}"
  to_earliest="${args[--to-earliest]}"
  to_latest="${args[--to-latest]}"
  to_offset="${args[--to-offset]}"
  to_datetime="${args[--to-datetime]}"
  shift_by="${args[--shift-by]}"
  by_duration="${args[--by-duration]}"
  dry_run="${args[--dry-run]}"
  verbose="${args[--verbose]}"

  reset_args=()
  nb_specs=0
  [[ -n "$to_earliest" ]] && { reset_args+=(--to-earliest); nb_specs=$((nb_specs+1)); description="to earliest"; }
  [[ -n "$to_latest" ]] && { reset_args+=(--to-latest); nb_specs=$((nb_specs+1)); description="to latest"; }
  [[ -n "$to_offset" ]] && { reset_args+=(--to-offset "$to_offset"); nb_specs=$((nb_specs+1)); description="to offset $to_offset"; }
  [[ -n "$to_datetime" ]] && { reset_args+=(--to-datetime "$to_datetime"); nb_specs=$((nb_specs+1)); description="to datetime $to_datetime"; }
  [[ -n "$shift_by" ]] && { reset_args+=(--shift-by "$shift_by"); nb_specs=$((nb_specs+1)); description="shifted by $shift_by"; }
  [[ -n "$by_duration" ]] && { reset_args+=(--by-duration "$by_duration"); nb_specs=$((nb_specs+1)); description="by duration $by_duration"; }
  if [ $nb_specs -ne 1 ]
  then
      logerror "❌ set exactly one of --to-earliest, --to-latest, --to-offset, --to-datetime, --shift-by, --by-duration"
      exit 1
  fi

  if [[ -n "$topic" ]]
  then
      reset_args+=(--topic "$topic")
      scope="topic $topic"
  else
      reset_args+=(--all-topics)
      scope="all its topics"
  fi

  if [[ -n "$dry_run" ]]
  then
      reset_args+=(--dry-run)
      log "🧪 Dry run: offsets of consumer group $group on $scope $description"
  else
      reset_args+=(--execute)
      log "⏪ Resetting offsets of consumer group $group on $scope $description"
  fi

  output=$(run_kafka_admin_tool kafka-consumer-groups --reset-offsets --group "$group" "${reset_args[@]}" 2>&1) || true

  # kafka-consumer-groups exits 0 on errors such as an active group, detect them from the output
  error=$(echo "$output" | grep -m1 -E "^Error: |inactive|does not exist" || true)
  if [ -n "$error" ]
  then
      logerror "❌ Failed to reset offsets of consumer group $group: ${error#Error: }"
      if echo "$output" | grep -q "inactive"
      then
          connector_name="${group#connect-}"
          if [ "$connector_name" != "$group" ]
          then
              logerror "   $group is the group of sink connector $connector_name: use playground connector offsets reset|alter --connector $connector_name, it stops and resumes the connector for you"
          else
              logerror "   the group must have no active member: stop its consumers first (playground consumer-group describe --group $group --members)"
          fi
      fi
      exit 1
  fi
  echo "$output" | grep -v "^$"
  if [ $(echo "$output" | grep -v "^$" | grep -vc "^GROUP ") -eq 0 ]
  then
      if [[ -n "$topic" ]]
      then
          logwarn "⚠️ nothing to reset: topic $topic does not exist or has no partition"
      else
          logwarn "⚠️ nothing to reset: group $group has no committed offset (unknown group?). Use --topic to set the offsets of a new group"
      fi
      exit 1
  fi

  if [[ -n "$dry_run" ]]
  then
      log "🧪 Nothing was changed, run again without --dry-run to apply"
  else
      log "✅ Offsets of consumer group $group reset"
  fi

}

# :command.function
playground_consumer_group_delete_command() {

  # src/commands/consumer-group/delete.sh
  group="${args[--group]}"
  topic="${args[--topic]}"
  verbose="${args[--verbose]}"

  if [[ -n "$topic" ]]
  then
      log "🧹 Deleting committed offsets of consumer group $group for topic $topic"
      delete_args=(--delete-offsets --group "$group" --topic "$topic")
  else
      log "🗑️ Deleting consumer group $group"
      delete_args=(--delete --group "$group")
  fi

  output=$(run_kafka_admin_tool kafka-consumer-groups "${delete_args[@]}" 2>&1) || true

  # kafka-consumer-groups exits 0 on errors such as an unknown or non-empty group, detect them from the output
  error=$(echo "$output" | grep -m1 -E "^Error: |Error: Deletion|GroupNotEmptyException|GroupIdNotFoundException|does not exist|is not empty|failed" || true)
  if [ -n "$error" ]
  then
      logerror "❌ Failed to delete: ${error#Error: }"
      echo "$output" | grep -v "^$" | grep -vF "$error" || true
      if echo "$output" | grep -qE "NonEmpty|not empty|GroupNotEmpty"
      then
          connector_name="${group#connect-}"
          if [ "$connector_name" != "$group" ]
          then
              logerror "   $group is the group of sink connector $connector_name: stop or delete the connector first (playground connector stop|delete --connector $connector_name)"
          else
              logerror "   the group still has active members: stop its consumers first (playground consumer-group describe --group $group --members)"
          fi
      fi
      exit 1
  fi
  echo "$output" | grep -v "^$"
  log "✅ Done"

}

# :command.function
playground_rbac_role_binding_create_command() {

  # src/commands/rbac/role-binding/create.sh
  file="${args[--file]}"
  verbose="${args[--verbose]}"

  if [[ -z "$file" ]]
  then
    if [[ -z "${args[--principal]}" ]] || [[ -z "${args[--role]}" ]]
    then
      logerror "❌ --principal and --role are required (or --file)"
      exit 1
    fi
    mds_role_binding POST || exit 1
    exit 0
  fi

  # one role binding per line: <principal> <role> <resource or -> [prefix] [scope=<scope>]
  nb=0
  line_number=0
  while read -r principal role resource options || [[ -n "$principal" ]]
  do
    line_number=$((line_number + 1))
    if [[ -z "$principal" ]] || [[ "$principal" == \#* ]]
    then
      continue
    fi
    if [[ -z "$role" ]] || [[ -z "$resource" ]]
    then
      logerror "❌ $file line $line_number: expected <principal> <role> <resource or -> [prefix] [scope=<scope>]"
      exit 1
    fi

    args[--principal]="$principal"
    args[--role]="$role"
    args[--resource]=""
    args[--prefix]=""
    args[--scope]=""
    if [ "$resource" != "-" ]
    then
      args[--resource]="$resource"
    fi
    for option in $options
    do
      case "$option" in
        prefix) args[--prefix]=1 ;;
        scope=*) args[--scope]="${option#scope=}" ;;
        *)
          logerror "❌ $file line $line_number: unknown option $option, it should be prefix or scope=<scope>"
          exit 1
        ;;
      esac
    done

    mds_role_binding POST || exit 1
    nb=$((nb + 1))
  done < "$file"

  log "✅ $nb role bindings created from $file"

}

