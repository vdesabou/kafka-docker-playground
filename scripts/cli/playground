    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--record RECORD")"
    printf "    🧾 Record to transform (json, or @file): {\"topic\": \"orders\", \"key\": ...,\n    \"value\": ..., \"headers\": {...}, \"timestamp\": <ms>}\n    \n    key and value are schemaless json, or {\"schema\": ..., \"payload\": ...} for a\n    record with a schema. Headers are typed like the SimpleHeaderConverter does\n    (string, int64, float64, boolean, map, array), or {\"schema\": ..., \"payload\":\n    ...}; give them as a list [{\"key\": ..., \"value\": ...}] for several headers\n    with the same key. Default: a schemaless record with a value {\"id\": 1,\n    \"name\": \"foo\"}\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--from-topic FROM-TOPIC")"
    printf "    🗳 Read the record from this topic instead of --record, and convert it with\n    the converters of the connector\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--offset OFFSET")"
    printf "    📍 Offset of the record with --from-topic (default is 0)\n"
    printf "    %s\n" "Default: 0"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--partition PARTITION")"
    printf "    🧩 Partition of the record with --from-topic (default is 0)\n"
    printf "    %s\n" "Default: 0"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--type TYPE")"
    printf "    🔀 Build a sink or a source record (default: the type of --connector, sink\n    otherwise)\n"
    printf "    %s\n" "Allowed: sink, source"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--cp-version CP-VERSION (repeatable)")"
