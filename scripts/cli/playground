    printf "playground connector diagnose\n\n"
    printf "  🩺 Diagnose a connector in one call: status, errors and progress\n  \n  Chains the commands you would run one after the other when a connector\n  misbehaves, and returns:\n  \n    🗺️  status       connector and task states, with the trace of a failed task\n    🔥 errors       digest of the connect ERROR/FATAL records (self-managed),\n                    or Confluent Cloud error recommendations (fully managed)\n    🐢 progress     consumer lag of a sink (its committed offsets when a task is\n  not\n                    RUNNING), or offsets of a source\n    👉 next steps   the commands to dig further\n  \n  It never follows logs and never waits for the lag to reach 0, so it is\n  safe to use from scripts and AI agents.\n  \n  🌐 Also writes a self-contained HTML report in --output-dir, to attach to a\n  case, opened in the browser in an interactive terminal (--no-open to skip):\n  verdict, findings, status and traces of the tasks, error records naming the\n  connector, lag per partition or offsets, next steps, and the configuration\n  (secrets masked).\n  \n  🍪 Deep dive:\n  https://kafka-docker-playground.io/#/deep-dive-connector-troubleshooting\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%A9%%BA-a-sink-is-running-but-writes-nothing\n\n"
  else
    printf "playground connector diagnose - 🩺 Diagnose a connector in one call: status, errors and progress\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground connector diagnose [OPTIONS]\n"
  printf "  playground connector diagnose --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
