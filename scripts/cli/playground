# :command.usage
playground_topic_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground topic\n\n"
    printf "  🗳 Topic commands\n  \n  Produce, consume and manage topics without dealing with the kafka-* shell\n  scripts: the bootstrap server, the security properties and the schema\n  registry url are all derived from the running environment, so the same\n  command works on plaintext, on sasl-ssl and on Confluent Cloud.\n  \n  📤 Get data in\n    produce         generate records from a schema, or from your own data\n    create          create a topic with the partitions you need\n  \n  📥 Get data out\n    consume         read from the beginning, deserialising automatically\n    get-number-records   count what is in the topic\n    wait-for-records     wait until the topic contains N records\n    get-offsets          earliest and latest offsets per partition\n    display-consumer-offsets   read the internal offsets topic\n  \n  🔧 Manage\n    list / describe / alter / delete\n    dlq inspect / replay   dead letter queue grouped by error, and replay\n    set-schema-compatibility   compatibility of the topic subjects\n    tag             stream catalog tags (Confluent Cloud only)\n  \n  Serialisation is handled for you: 'produce' registers the schema you give\n  it and 'consume' works out from the payload whether it is avro, protobuf,\n  json schema or plain text.\n  \n  🎓 Tip: in an example script, 'consume --min-expected-messages N' is the\n  assertion that the data made it through; it fails the run if it did not.\n\n"
  else
    printf "playground topic - 🗳 Topic commands\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground topic COMMAND\n"
  printf "  playground topic [COMMAND] --help | -h\n"
  echo
  # :command.usage_commands
  printf "%s\n" "$(bold "Topic commands:")"
  printf "  %s   💯 Get number of records in a topic\n" "$(green "get-number-records")      "
  printf "  %s   ⏳ Wait for a topic to contain a minimum number of records\n" "$(green "wait-for-records")        "
  printf "  %s   📍 Get earliest and latest offsets per partition of a topic\n" "$(green "get-offsets")             "
  printf "  %s   📭 Display content of __consumer_offsets topic\n" "$(green "display-consumer-offsets")"
  printf "  %s   🔘 List topics\n" "$(green "list")                    "
  printf "  %s   📏 Get size of topics\n" "$(green "get-size")                "
  printf "  %s   🔬 Describe topic\n" "$(green "describe")                "
  printf "  %s   🛡️ Change topic's schema compatibility\n" "$(green "set-schema-compatibility")"
  printf "  %s   📥 Consume topic from beginning\n" "$(green "consume")                 "
  printf "  %s   📤 Produce to a topic\n" "$(green "produce")                 "
  printf "  %s   🆕 Create topic\n" "$(green "create")                  "
  printf "  %s   ❌ Delete topic and associated schema/subject if applicable\n" "$(green "delete")                  "
  printf "  %s   🪛 Alter topic config\n" "$(green "alter")                   "
  printf "  %s   📬 Dead letter queue commands\n" "$(green "dlq")                     "
  printf "  %s   🩺 Show what is in a dead letter queue, grouped by error\n" "$(green "dlq inspect")             "
  printf "  %s   🔁 Produce the records of a dead letter queue again\n" "$(green "dlq replay")              "
  printf "  %s   🏷️ Stream Catalog tags (Confluent Cloud only)\n" "$(green "tag")                     "
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

  fi
}

