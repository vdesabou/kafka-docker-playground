}

# :command.usage
playground_connector_create_or_update_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground connector create-or-update\n\n"
    printf "  🧑‍🎨  Create or update connector\n  \n  The command every example uses to deploy its connector. The json config\n  is read from stdin, usually as a heredoc, so it stays readable in the\n  script. If the connector already exists it is updated in place, which\n  makes the command safe to re-run while you iterate on a configuration.\n  \n  The command then waits for the connector and all its tasks to be\n  RUNNING, displays the connector status, and fails with the error if\n  they are not, so a broken config stops the example immediately instead\n  of failing silently later. A FAILED connector or task is reported with\n  'playground connector diagnose' (trace, error digest, offsets, next\n  steps and HTML report). When the script that runs is a reproduction\n  model, a connector that is not RUNNING is only reported as a warning,\n  since a reproduction model often creates a failing connector on\n  purpose. Use --wait to fail there too, --no-wait to skip the wait.\n  \n  Fully managed connectors are only waited for with --wait.\n  \n  🎓 Tip: add --validate to have the config checked by the plugin before\n  it is deployed, which reports every invalid property at once.\n  \n  An update shows the keys added, removed and changed compared to the\n  running config (secrets masked). The config can also be given in the\n  REST API format ({\"name\": ..., \"config\": {...}}, as returned by\n  GET /connectors/<name>), or as the path of a json file.\n  \n  🍪 Deep dive:\n  https://kafka-docker-playground.io/#/deep-dive-connector-create-or-update\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%94%%8C-the-sink-fails-right-after-it-is-deployed\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%8F%%97%%EF%%B8%%8F-deploy-a-fully-managed-connector-with-terraform\n\n"
  else
    printf "playground connector create-or-update - 🧑‍🎨  Create or update connector\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground connector create-or-update [JSON] [OPTIONS]\n"
  printf "  playground connector create-or-update --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--verbose, -v")"
    printf "    🐞 Show command being ran.\n"
    echo

    if [[ -n "${PLAYGROUND_SHOW_PRIVATE:-}" ]]; then
      # :flag.usage
      printf "  %s\n" "$(magenta "--no-clipboard")"
      printf "    do not copy to clipboard (internal)\n"
      echo

    fi
    # :flag.usage
    printf "  %s\n" "$(magenta "--connector, -c CONNECTOR (required)")"
    printf "    🔗 Connector name\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--level, -l LEVEL")"
    printf "    ❕Log level\n    \n    ⚠️ Not available for ccloud connectors\n"
    printf "    %s\n" "Allowed: INFO, WARN, DEBUG, TRACE"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--package, -p PACKAGE")"
    printf "    Package name (with --level: the log level of that package instead of the\n    connector's)\n"
    printf "    %s\n" "Needs: --level"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--wait-for-zero-lag")"
    printf "    😴 Wait until lag becomes 0\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--wait")"
    printf "    ⏳ Wait until the connector and all its tasks are RUNNING (or in\n    --initial-state), and fail otherwise\n    \n    Self-managed connectors are waited for by default: --wait also makes the\n    command fail when the script that runs is a reproduction model (by default,\n    it is only a warning there).\n    \n    Same as running 'playground connector wait' right after the command. It\n    fails right away if the connector or one of its tasks is FAILED. An update\n    of a PAUSED or STOPPED connector waits for that state.\n    \n    With fully managed connectors, it waits for the connector to be provisioned\n    and restarts it if it fails while being provisioned (same as\n    wait_for_ccloud_connector_up in example scripts).\n"
    printf "    %s\n" "Conflicts: --no-wait"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-wait")"
    printf "    🏃 Do not wait for the connector and its tasks to be RUNNING, only display\n    the status\n    \n    🎓 Tip: use it to create a connector that is expected to fail, then check it\n    with 'playground connector wait --state FAILED'\n"
    printf "    %s\n" "Conflicts: --wait, --max-wait"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-wait MAX_WAIT")"
    printf "    ⏳ Max time in seconds to wait for the connector (default is 120, or 600 for\n    fully managed connectors with --wait)\n"
    printf "    %s\n" "Conflicts: --no-wait"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--validate")"
    printf "    ✅ Validate config using PUT /connector-plugins/(string:name)/config/validate\n    (https://docs.confluent.io/platform/current/connect/references/restapi.html#put--connector-plugins-(string-name)-config-validate)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--skip-automatic-connector-config")"
    printf "    🤖 If example is run (playground run) with --environment flag, automatic\n    configuration to adapt to the environment is added.\n    \n    This flag allows to skip this automatic configuration (only useful to\n    reproduce issues)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--offsets OFFSETS")"
    printf "    📍 Create connector with offsets\n    (https://docs.confluent.io/cloud/current/connectors/offsets.html#create-connectors-with-offsets)\n    \n    ⚠️ Only available for ccloud connectors, the connector should not really\n    exists\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--initial-state INITIAL-STATE")"
    printf "    🪵 Create connector with specific status\n    (https://cwiki.apache.org/confluence/display/KAFKA/KIP-980%%3A+Allow+creating+connectors+in+a+stopped+state)\n    \n    If the connector already exists, its config is updated, then it is paused,\n    stopped or resumed.\n    \n    Only available if CP > 7.7\n    \n    ⚠️ not available for ccloud connectors\n"
    printf "    %s\n" "Allowed: RUNNING, PAUSED, STOPPED"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--dry-run")"
    printf "    🌵 Print the final config (with the automatic configuration added for the\n    environment, the CFK rewrites)\n    and the request that would be sent, without deploying anything\n    \n    With --ccloud-service-account, the service account and its ACLs are not\n    created.\n"
    printf "    %s\n" "Conflicts: --wait, --wait-for-zero-lag, --terraform, --level"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--terraform")"
    printf "    🏗️ Deploy connector using Terraform instead of REST API\n    \n    Dynamically converts JSON connector config to Terraform HCL and deploys\n    using terraform apply\n    \n    The values of config_sensitive are masked in the output. The Terraform\n    folder of a connector\n    (.terraform-playground/<connector>-*) is reused: running the command again\n    updates the connector, and a\n    connector created with the REST API is imported first. playground connector\n    delete runs terraform destroy.\n    \n    ⚠️ Only available for Confluent Cloud connectors\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_args
    printf "%s\n" "$(bold "== Arguments ==")"

    # :argument.usage
    printf "  %s\n" "$(blue "JSON")"
    printf "    json, or the path of a json file (@file.json works too); reads from stdin if\n    empty\n"
    printf "    %s\n" "Default: -"
    echo

    # :command.usage_environment_variables
    printf "%s\n" "$(bold "Environment Variables:")"

    # :environment_variable.usage
    printf "  %s\n" "$(cyan "PG_CCLOUD_SERVICE_ACCOUNT")"
    printf "    👤 true: create fully managed connectors with a service account and the ACLs\n    of the documentation (set by playground run --ccloud-service-account)\n"
    echo

    # :environment_variable.usage
    printf "  %s\n" "$(cyan "PG_CCLOUD_SERVICE_ACCOUNT_ACLS")"
    printf "    🚦 With PG_CCLOUD_SERVICE_ACCOUNT, ACLs of the service account: docs\n    (default), full or none\n"
    echo

    # :environment_variable.usage
    printf "  %s\n" "$(cyan "PG_CCLOUD_SERVICE_ACCOUNT_ID")"
    printf "    👤 With PG_CCLOUD_SERVICE_ACCOUNT, existing service account to use as is,\n    instead of creating one\n"
    echo

    # :environment_variable.usage
    printf "  %s\n" "$(cyan "PG_CCLOUD_SERVICE_ACCOUNT_ACL_EXCLUDE")"
    printf "    🙈 With PG_CCLOUD_SERVICE_ACCOUNT, regex of the ACLs not to create, matched\n    on <OPERATION> <ResourceType>:<name> [prefix]\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground connector create-or-update -c filestream-sink << EOF\n{\n    \"tasks.max\": \"1\",\n    \"connector.class\":\n\"org.apache.kafka.connect.file.FileStreamSinkConnector\",\n    \"topics\": \"filestream\",\n    \"file\": \"/tmp/output.json\",\n    \"key.converter\": \"org.apache.kafka.connect.storage.StringConverter\",\n    \"value.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\n    \"value.converter.schemas.enable\": \"false\"\n}\nEOF\n  \n  playground connector create-or-update -c filestream-sink --offsets\n  '[{\"partition\":{\"kafka_topic\":\"filestream\",\"kafka_partition\":0},\"offset\":{\"kafka_offset\":8}}]'\n  << EOF\n{\n    \"tasks.max\": \"1\",\n    \"connector.class\":\n\"org.apache.kafka.connect.file.FileStreamSinkConnector\",\n    \"topics\": \"filestream\",\n    \"file\": \"/tmp/output.json\",\n    \"key.converter\": \"org.apache.kafka.connect.storage.StringConverter\",\n    \"value.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\n    \"value.converter.schemas.enable\": \"false\"\n}\nEOF\n"
echo

fi
}

