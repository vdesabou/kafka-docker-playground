    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--force-refresh")"
    printf "    ☢️ Force refresh.\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground cp-changelog --from 8.3.0\n  playground cp-changelog --from 8.1.4 --to 8.3.2 --component schema-registry\n  --grep \"anyOf|allOf\"\n  playground cp-changelog --from 7.9.3 --security\n  playground cp-changelog --from 8.2.0 --component kafka --json\n"
