# Apache Kafka version of the java clients that some examples build (mvn -Dkafka.client.tag=$KAFKA_CLIENT_TAG): derived
# from the CP version (CP 5.y = AK 2.y, 6.y = 2.(y+6), 7.y = 3.y, 8.y = 4.y…), so a new CP version needs no change here.
# A new CP release can come before its AK release on Maven Central: then the newest published X.Y.0 below is used
function set_kafka_client_tag()
{
    local cp_major cp_minor ak_major ak_minor
    cp_major=$(echo "$TAG_BASE" | cut -d '.' -f 1)
    cp_minor=$(echo "$TAG_BASE" | cut -d '.' -f 2)
    if ! [[ "$cp_major" =~ ^[0-9]+$ ]] || ! [[ "$cp_minor" =~ ^[0-9]+$ ]] || [ "$cp_major" -lt 5 ]
    then
      return
    fi
    case "$cp_major" in
      5) ak_major=2; ak_minor=$cp_minor ;;
      6) ak_major=2; ak_minor=$((cp_minor + 6)) ;;
      *) ak_major=$((cp_major - 4)); ak_minor=$cp_minor ;;
    esac
    export KAFKA_CLIENT_TAG="$ak_major.$ak_minor.0"

    # list of published versions, cached for a day: no network call once the version is in it
    local versions_file="${TMPDIR:-/tmp}/playground-kafka-clients-versions.txt"
    if grep -qx "$KAFKA_CLIENT_TAG" "$versions_file" 2> /dev/null
    then
      return
    fi
    if [ -z "$(find "$versions_file" -mtime -1 2> /dev/null)" ]
    then
      curl -s --max-time 5 https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/maven-metadata.xml 2> /dev/null | sed -n 's|.*<version>\([0-9]*\.[0-9]*\.0\)</version>.*|\1|p' > "$versions_file.tmp" 2> /dev/null
      if [ -s "$versions_file.tmp" ]
      then
        mv "$versions_file.tmp" "$versions_file"
      else
        # offline: keep the derived version
        rm -f "$versions_file.tmp"
        return
      fi
      if grep -qx "$KAFKA_CLIENT_TAG" "$versions_file"
      then
        return
      fi
    fi
    local version fallback=""
    for version in $(cat "$versions_file" 2> /dev/null)
    do
      if ! version_gt "$version" "$KAFKA_CLIENT_TAG" && { [ -z "$fallback" ] || version_gt "$version" "$fallback"; }
      then
        fallback="$version"
      fi
    done
    if [ -n "$fallback" ]
    then
      export KAFKA_CLIENT_TAG="$fallback"
    fi
}

function displaytime {
  local T=$1
  local D=$((T/60/60/24))
  local H=$((T/60/60%24))
  local M=$((T/60%60))
  local S=$((T%60))
  (( $D > 0 )) && printf '%d days ' $D
  (( $H > 0 )) && printf '%d hours ' $H
  (( $M > 0 )) && printf '%d minutes ' $M
  (( $D > 0 || $H > 0 || $M > 0 )) && printf 'and '
  printf '%d seconds\n' $S
}

