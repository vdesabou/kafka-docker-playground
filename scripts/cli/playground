# :command.usage
playground_debug_jscissors_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground debug jscissors\n\n"
    printf "  ✂️ Trace the calls of any method of a running JVM: arguments, return values,\n  durations, exceptions, call tree\n  \n  A java agent (tools/jscissors/agent, byte-buddy) loaded in the JVM of the\n  container instruments the methods matching --class and --method, and records\n  every call with what the --operation flags ask for. For a window of any\n  length: --action start, reproduce the problem, --action stop, which copies the\n  trace to --output-dir and analyzes it with playground analyze jscissors\n  (methods by total time, exceptions, calls still running, slowest calls, call\n  trees, HTML report), unless --no-analyze. With --duration, start, wait and\n  stop in one command.\n  \n  💉 No restart: the agent is loaded in the running JVM with the attach protocol\n  (what jcmd does, without jcmd, which the cp images do not have), or over JMX\n  for a JDK older than 16. --action stop restores the original classes. Starting\n  again replaces the rules. With --restart, the container is recreated with the\n  agent in JAVA_TOOL_OPTIONS, to trace the startup of the JVM too (or when the\n  JVM refuses the attach).\n  \n  🎯 --class and --method are exact names, or java regular expressions as soon as\n  they hold other characters than letters, digits, '.', '$' and '_'\n  (io.confluent.connect.jdbc.*, .*[Ww]rite.*). Only concrete methods are traced\n  (trace the implementation class, not the interface), constructors and JDK\n  classes (java.*, javax.*) are not. A class loaded after the start is\n  instrumented when it loads.\n  \n  🛡️ Safe by default: values are cut to --max-value-length and the secrets found\n  in them are masked (passwords of maps, JAAS, connection strings), at most\n  --max-calls calls (--max-calls-per-method per method) are recorded with their\n  details (every call is counted in the statistics), or only the ones that throw\n  (--only-failed) or are slow (--slower-than), at most 10 thread dumps and 1\n  heap dump, the agent can never throw in the traced code, and a toString() of\n  an argument is never traced. Trace what you need: a regex matching thousands\n  of hot methods slows the JVM down.\n  \n  📂 In the trace folder (jscissors-<container>-<date>/pid-<pid>/): events.jsonl\n  (one event per call enter / exit / dump), summary.json (statistics),\n  agent.log, instrumented.txt, dumps/, and the HTML report.\n  \n  🔖 The session of each container is kept in playground.ini\n  (jscissors.<container>), --action status shows it with the calls so far. The\n  agent jar is built from tools/jscissors/agent with maven in a container the\n  first time (and after a change of its sources).\n  \n  🍪 Deep dive: https://kafka-docker-playground.io/#/deep-dive-jvm-diagnostics\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%E2%%9C%%82%%EF%%B8%%8F-records-vanish-a-task-hangs-what-does-the-code-do\n\n"
  else
    printf "playground debug jscissors - ✂️ Trace the calls of any method of a running JVM: arguments, return values, durations, exceptions, call tree\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground debug jscissors [OPTIONS]\n"
  printf "  playground debug jscissors --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--container, -c, --pod, -p CONTAINER (repeatable)")"
    printf "    🐳 container name (or pod name when cfk environment is used)\n    \n    🎓 Tip: you can pass multiple containers by specifying --container multiple\n    times\n"
    printf "    %s\n" "Default: connect"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--action ACTION")"
    printf "    🟢 start (default), stop (copy the trace and analyze it) or status\n    \n    enable and disable are the former names of start and stop\n"
    printf "    %s\n" "Allowed: start, stop, status, enable, disable"
    printf "    %s\n" "Default: start"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--class CLASS (repeatable)")"
    printf "    🎯 Class to trace: exact name (io.confluent.connect.jdbc.sink.JdbcDbWriter, a\n    nested class with $), or a regex (io.confluent.connect.jdbc.sink.*)\n    \n    🎓 Tip: you can pass multiple classes by specifying --class multiple times\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--method METHOD (repeatable)")"
    printf "    🎯 Method to trace, in each --class: exact name (write) or regex\n    (.*[Ww]rite.*), default: every method\n    \n    🎓 Tip: you can pass multiple methods by specifying --method multiple times\n"
    printf "    %s\n" "Default: .*"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--operation OPERATION (repeatable)")"
    printf "    🥼 What to record on top of each call (its duration, its exception and its\n    place in the call tree are always recorded):\n    \n    * VALUES: arguments\n    * RETURN_VALUE: return value\n    * STACK: stack trace of the caller\n    * THREADS / RETURN_THREADS / EXCEPTION_THREADS: thread dump when the method\n    is called / returns / throws\n    * HEAP / RETURN_HEAP / EXCEPTION_HEAP: heap dump when the method is called /\n    returns / throws\n    * DELAY: duration (always recorded, kept for compatibility)\n    \n    Default values: VALUES and RETURN_VALUE\n    \n    🎓 Tip: you can pass multiple operations by specifying --operation multiple\n    times\n"
