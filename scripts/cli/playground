# :command.usage
playground_topic_consume_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground topic consume\n\n"
    printf "  📥 Consume topic from beginning\n  \n  Reads from the earliest offset and deserialises records on its own:\n  the subjects <topic>-key and <topic>-value of Schema Registry decide\n  between the avro, protobuf, json schema and plain console consumers\n  (use --key-subject / --value-subject for other subject names).\n  \n  🎓 Tip: --min-expected-messages turns it into an assertion. It waits\n  up to --timeout for that many records, consumes them and fails if\n  fewer could be consumed (records that cannot be deserialized do not\n  count), which is how examples verify that data actually flowed.\n  \n  The consumer stops when no record arrives for 10 seconds (30 seconds\n  on Confluent Cloud), so it never waits for records that cannot come\n  (transaction markers and compacted records use offsets).\n  \n  🍪 Deep dive: https://kafka-docker-playground.io/#/deep-dive-topic-consume\n  🎬 Bite size session:\n  https://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%93%%A5-read-a-topic\n\n"
  else
    printf "playground topic consume - 📥 Consume topic from beginning\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground topic consume [OPTIONS]\n"
  printf "  playground topic consume --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--verbose, -v")"
    printf "    🐞 Show command being ran.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--topic, -t TOPIC")"
    printf "    🗳 Topic name\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-messages MAX-MESSAGES")"
    printf "    Max number of messages to display (default is 100)\n    \n    You can use -1 to display all messages\n"
    printf "    %s\n" "Default: 100"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--min-expected-messages MIN-EXPECTED-MESSAGES")"
    printf "    Minimum expected number of records to be consumed from the topic, returns an\n    error if this is not the case\n    \n    Records that cannot be deserialized are reported and do not count.\n    \n    Note: --topic should be specified in this case.\n"
    printf "    %s\n" "Default: 0"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--grep GREP")"
    printf "    Verify that topic content contains record which contains specified string\n    \n    It is searched in the records as displayed (decoded when base64 encoded),\n    and the command fails when no record contains it.\n"
    printf "    %s\n" "Default: "
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--timeout TIMEOUT")"
    printf "    Max number of seconds to wait when --min-expected-messages is used.\n    \n    Default is 60 seconds\n"
    printf "    %s\n" "Default: 60"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--tail")"
    printf "    Tail on logs.\n"
    printf "    %s\n" "Conflicts: --min-expected-messages, --max-messages, --open"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--key-subject KEY-SUBJECT")"
    printf "    📛 Subject for key in schema-registry to use (useful when data was produced\n    with --key-subject-name-strategy other than TopicNameStrategy)\n    \n    Note: --topic should be specified in this case.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--value-subject VALUE-SUBJECT")"
    printf "    📛 Subject for value in schema-registry to use (useful when data was produced\n    with --value-subject-name-strategy other than TopicNameStrategy)\n    \n    Note: --topic should be specified in this case.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--max-characters MAX-CHARACTERS")"
    printf "    Max characters per message to display (default is 3000, 0 for no limit)\n"
    printf "    %s\n" "Default: 3000"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--open, -o")"
    printf "    🔖 Save full dump of topic to a file and open with text editor set with\n    playground config editor <editor> (default is code)\n"
    printf "    %s\n" "Conflicts: --max-characters, --tail, --min-expected-messages"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--isolation-level ISOLATION-LEVEL")"
    printf "    🫥 The isolation level to use, see\n    https://docs.confluent.io/platform/current/installation/configuration/consumer-configs.html#isolation-level\n    If not set, default is read_uncommitted\n"
    printf "    %s\n" "Allowed: read_uncommitted, read_committed"
    printf "    %s\n" "Default: read_uncommitted"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--last LAST")"
    printf "    ⏮️ Display the last N records of the topic (the most recent ones, sorted by\n    timestamp across partitions),\n    instead of the first --max-messages\n    \n    Example: --last 10\n"
    printf "    %s\n" "Conflicts: --tail, --from-timestamp, --offset, --min-expected-messages, --open, --count"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--from-timestamp FROM-TIMESTAMP")"
    printf "    ⏱️ Display the records from this time (sorted by timestamp across\n    partitions, --max-messages still applies)\n    \n    Accepted values:\n    \n    * a date, in local time: \"2026-10-22 10:30\", \"2026-10-22T10:30:00.250\" (add\n    Z for UTC: \"2026-10-22T08:30:00Z\")\n    * an epoch, in milliseconds or seconds: 1792660170522\n    * a duration ago: 30s, 10m, 2h, 1d\n"
    printf "    %s\n" "Conflicts: --tail, --last, --offset, --open"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--partition PARTITION")"
    printf "    🧩 Only consume this partition (with --offset, from that offset; otherwise\n    from the beginning, or new records with --tail)\n"
    printf "    %s\n" "Conflicts: --open"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--offset OFFSET")"
    printf "    📍 Offset of --partition to start from: a number, earliest or latest\n    \n    Example: --partition 0 --offset 1234 --max-messages 1, the record a\n    connector is stuck on\n"
    printf "    %s\n" "Needs: --partition"
    printf "    %s\n" "Conflicts: --tail, --last, --from-timestamp, --open"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--json")"
    printf "    🧾 Print each record as a json object on one line (topic, partition, offset,\n    timestamp, date, headers, key,\n    value, schema ids): key and value are embedded as json when they are valid\n    json, as strings otherwise.\n    \n    Only the records go to stdout, everything else goes to stderr, so the output\n    can be piped to jq.\n    \n    Example: playground topic consume --topic orders --json | jq -r '.value.id'\n"
    printf "    %s\n" "Conflicts: --open, --count, --tail"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--count")"
    printf "    🔢 Only print the number of records consumed (with --grep, the number of\n    records containing that string),\n    on stdout: logs go to stderr. Without --topic, one \"<topic> <number>\" line\n    per topic.\n    \n    Unlike playground topic get-number-records, records are counted, not offsets\n    (transaction markers,\n    compacted records and records that cannot be deserialized do not count)\n"
    printf "    %s\n" "Conflicts: --tail, --open, --json"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--no-decode")"
    printf "    🤖 Never decode the values, even when they look base64 encoded (by default,\n    they are decoded when the first\n    record is valid base64 of printable utf-8)\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--print-schema")"
    printf "    📜 Also print the key and value schemas registered for the topic\n"
    echo

    # :command.usage_fixed_flags
    printf "  %s\n" "$(magenta "--help, -h")"
    printf "    Show this help\n"
    echo

    # :command.usage_examples
    printf "%s\n" "$(bold "Examples")"
    printf "  playground topic consume --topic filestream --min-expected-messages 2\n  --timeout 30\n"
    echo

  fi
}

# :command.usage
playground_topic_produce_usage() {
  if [[ -n $long_usage ]]; then
    printf "playground topic produce\n\n"
    printf "  📤 Produce to a topic\n  \n  See video tutorial https://youtu.be/mbzHCewG_XE\n  \n  Generates records for you rather than making you write them. Give it\n  a schema, in avro, json schema or protobuf, and it registers the\n  schema and produces --nb-messages records of realistic random data.\n  The topic is created if it does not exist.\n  \n  Three ways to say what to send:\n  \n    a schema on stdin           generated data matching that schema\n    --value <predefined>        one of the bundled schemas\n    --forced-value '{...}'      your exact payload, %%g being the index\n  \n  🎓 Tip: pipe the schema with a quoted heredoc, << 'EOF', so that the\n%%g placeholders survive the shell.\n\n🍪 Deep dive: https://kafka-docker-playground.io/#/deep-dive-topic-produce\n🎬 Bite size session:\nhttps://kafka-docker-playground.io/#/sessions?id=%%F0%%9F%%93%%A8-produce-realistic-test-data\n\n"
  else
    printf "playground topic produce - 📤 Produce to a topic\n\n"
  fi

  printf "%s\n" "$(bold "== Usage ==")"
  printf "  playground topic produce [OPTIONS]\n"
  printf "  playground topic produce --help | -h\n"
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "$(bold "== Options ==")"

    # :command.usage_flags
    # :flag.usage
    printf "  %s\n" "$(magenta "--key KEY")"
    printf "    🗝️ Key to use. If not set, no key is used.\n    \n    🔥 You can either:\n    \n    * Set your own schema (avro, json-schema, protobuf) within single quotes\n    (see examples)\n    \n    * You can also generate json data using json or sql format using syntax from\n    https://github.com/MaterializeInc/datagen\n    \n    * You can also generate json data using syntax from\n    https://github.com/vdesabou/avro-random-generator (same as datagen source\n    connector)\n    \n    * Use completion to select predefined schemas (or use your own schema file)\n    🎓 Tip: use <tab> completion to trigger fzf completion\n    \n    * Directly set payload (\"%%g\" can be used to generate a counter)\n    \n    In case of 'raw' data (i.e not using schema):\n    \n    If the key contain a number, it will be used as starting point and\n    incremented for each record.\n    \n    Example: key1 will start with key1, then key2, etc..\n    Example: mykey-10-suffix will start with mykey-10-suffix then\n    mykey-11-suffix, etc..\n    \n    \"%%g\" can also be used to generate a counter\n    \n    Example: key%%g will start with key1, then key2, etc..\n    \n    Otherwise, the key will be same for all records.\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--value VALUE")"
    printf "    🔥 You can either:\n    \n    * Set your own schema (avro, json-schema, protobuf) with stdin (see example\n    section).\n    \n    * You can also generate json data using json or sql format using syntax from\n    https://github.com/MaterializeInc/datagen\n    \n    * You can also generate json data using syntax from\n    https://github.com/vdesabou/avro-random-generator (same as datagen source\n    connector)\n    \n    * Use completion to select predefined schemas (or use your own schema file)\n    🎓 Tip: use <tab> completion to trigger fzf completion\n    \n    * Directly set payload (\"%%g\" can be used to generate a counter)\n"
    printf "    %s\n" "Default: -"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--value-format VALUE-FORMAT")"
    printf "    🔮 Format of --value, instead of detecting it from its content\n    \n    Detection looks for keywords (proto3, \"type\": \"object\", \"_meta\", CREATE\n    TABLE, arg.properties,\n    \"type\": \"record\"), so a raw payload containing one of them is not sent as\n    raw data:\n    use --value-format raw in that case.\n    \n    Cannot be used with --derive-value-schema-as.\n"
    printf "    %s\n" "Allowed: avro, json-schema, protobuf, json, sql, datagen, raw"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--key-format KEY-FORMAT")"
    printf "    🔮 Format of --key, instead of detecting it from its content (see\n    --value-format)\n    \n    Cannot be used with --derive-key-schema-as.\n"
    printf "    %s\n" "Allowed: avro, json-schema, protobuf, json, sql, datagen, raw"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--verbose, -v")"
    printf "    🐞 Show command being ran.\n"
    echo

    if [[ -n "${PLAYGROUND_SHOW_PRIVATE:-}" ]]; then
      # :flag.usage
      printf "  %s\n" "$(magenta "--debug, -d")"
      printf "    debug mode (internal)\n"
      echo

    fi
    # :flag.usage
    printf "  %s\n" "$(magenta "--topic, -t TOPIC (required)")"
    printf "    🗳 Topic name\n"
    echo

    # :flag.usage
    printf "  %s\n" "$(magenta "--nb-messages NB-MESSAGES")"
    printf "    💯 Number of messages to produce (default is 1)\n       \n    🎓  - if > <value of --max-nb-messages-per-batch> (default 300000), messages\n    will be sent in batches of <value of --max-nb-messages-per-batch> (default\n    300000) records\n        - if you set it to -1, an infinite number of records will also be sent\n    in batches\n"
