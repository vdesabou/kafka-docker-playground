# :command.function
playground_rbac_role_binding_list_command() {

  # src/commands/rbac/role-binding/list.sh
  principal="${args[--principal]}"
  scope="${args[--scope]}"
  verbose="${args[--verbose]}"

  if [[ -n "$scope" ]]
  then
    scopes=("$scope")
  else
    scopes=(kafka schema-registry connect ksqldb)
  fi

  mds_request GET /security/1.0/roles || exit 1
  roles=$(jq -r '.[].name' <<< "$mds_output")

  rows=""
  for scope in "${scopes[@]}"
  do
    get_mds_scope "$scope" || exit 1

    if [[ -n "$principal" ]]
    then
      principals=$(normalize_rbac_principal "$principal")
    else
      # every principal having at least one role in this scope
      principals=""
      for role in $roles
      do
        mds_request POST "/security/1.0/lookup/role/$role" "$mds_scope" || exit 1
        principals="$principals $(jq -r '.[]' <<< "$mds_output")"
      done
      principals=$(tr ' ' '\n' <<< "$principals" | grep -v '^$' | sort -u)
    fi

    for p in $principals
    do
      mds_request POST "/security/1.0/lookup/rolebindings/principal/$p" "$mds_scope" || exit 1
      rows="$rows$(jq -r --arg scope "$scope" '
        .rolebindings // {} | to_entries[] | .key as $principal | .value | to_entries[] | .key as $role |
        if (.value | length) == 0
        then [$principal, $role, $scope, "(cluster)"]
        else .value[] | [$principal, $role, $scope, "\(.resourceType):\(.name)" + (if .patternType == "PREFIXED" then " (prefixed)" else "" end)]
        end | @tsv' <<< "$mds_output")"$'\n'
    done
  done

  rows=$(grep -v '^$' <<< "$rows" || true)
  if [[ -z "$rows" ]]
  then
    logwarn "no role binding found"
    exit 0
  fi

  {
    printf "PRINCIPAL\tROLE\tSCOPE\tRESOURCE\n"
    echo "$rows"
  } | column -t -s $'\t'

}

# :command.function
playground_rbac_user_add_command() {

  # src/commands/rbac/user/add.sh
  user="${args[--user]}"
  password="${args[--password]}"
  verbose="${args[--verbose]}"
  eval "groups=(${args[--group]})"

  if [[ -z "$password" ]]
  then
    password="$user-secret"
  fi

  if [[ -n "$(rbac_ldap ldapsearch -LLL -b "ou=users,$rbac_ldap_base_dn" "uid=$user" dn)" ]]
  then
    logerror "❌ user $user already exists"
    exit 1
  fi

  # next free uidNumber
  uid_number=$(rbac_ldap ldapsearch -LLL -b "ou=users,$rbac_ldap_base_dn" "objectClass=posixAccount" uidNumber | awk '/^uidNumber:/ { if ($2 > max) max = $2 } END { print max + 1 }')

  log "🧑 Adding user $user (password $password)"
  printf '%s\n' \
    "dn: cn=$user,ou=users,$rbac_ldap_base_dn" \
    "objectClass: inetOrgPerson" \
    "objectClass: posixAccount" \
    "objectClass: shadowAccount" \
    "uid: $user" \
    "sn: $user" \
    "givenName: $user" \
    "cn: $user" \
    "displayName: $user" \
    "uidNumber: $uid_number" \
    "gidNumber: 5000" \
    "userPassword: $password" \
    "gecos: $user" \
    "loginShell: /bin/bash" \
    "homeDirectory: /home/$user" | rbac_ldap ldapadd || exit 1

  for group in "${groups[@]}"
  do
    if [[ -z "$(rbac_ldap ldapsearch -LLL -b "ou=groups,$rbac_ldap_base_dn" "cn=$group" dn)" ]]
    then
      gid_number=$(rbac_ldap ldapsearch -LLL -b "ou=groups,$rbac_ldap_base_dn" "objectClass=posixGroup" gidNumber | awk '/^gidNumber:/ { if ($2 > max) max = $2 } END { print max + 1 }')
      log "👥 Creating group $group"
      printf '%s\n' \
        "dn: cn=$group,ou=groups,$rbac_ldap_base_dn" \
        "objectClass: top" \
        "objectClass: posixGroup" \
        "cn: $group" \
        "gidNumber: $gid_number" | rbac_ldap ldapadd || exit 1
    fi
    log "👥 Adding user $user to group $group"
    # members are cn=<user>,ou=users,... (KAFKA_LDAP_GROUP_MEMBER_ATTRIBUTE_PATTERN)
    printf '%s\n' \
      "dn: cn=$group,ou=groups,$rbac_ldap_base_dn" \
      "changetype: modify" \
      "add: memberUid" \
      "memberUid: cn=$user,ou=users,$rbac_ldap_base_dn" | rbac_ldap ldapmodify || exit 1
  done

  if [ ${#groups[@]} -gt 0 ]
  then
    log "⏳ MDS picks up the group membership within its LDAP refresh interval (60 seconds by default)"
  fi
  log "🎓 Give permissions with 'playground rbac role-binding create --principal User:$user ...' or 'playground rbac acl create --principal User:$user ...'"

}

# :command.function
playground_rbac_user_delete_command() {

  # src/commands/rbac/user/delete.sh
  user="${args[--user]}"
  verbose="${args[--verbose]}"

  if [[ -z "$(rbac_ldap ldapsearch -LLL -b "ou=users,$rbac_ldap_base_dn" "uid=$user" dn)" ]]
  then
    logerror "❌ user $user does not exist"
    exit 1
  fi

  member="cn=$user,ou=users,$rbac_ldap_base_dn"
  for group in $(rbac_ldap ldapsearch -LLL -b "ou=groups,$rbac_ldap_base_dn" "memberUid=$member" cn | awk '/^cn:/ { print $2 }')
  do
    log "👥 Removing user $user from group $group"
    printf '%s\n' \
      "dn: cn=$group,ou=groups,$rbac_ldap_base_dn" \
      "changetype: modify" \
      "delete: memberUid" \
      "memberUid: $member" | rbac_ldap ldapmodify || exit 1
  done

  log "🗑️ Deleting user $user"
  rbac_ldap ldapdelete "$member" || exit 1
  logwarn "role bindings and ACLs of User:$user are not deleted, see 'playground rbac role-binding list --principal User:$user' and 'playground rbac acl list --principal User:$user'"

}

# :command.function
playground_rbac_user_list_command() {

  # src/commands/rbac/user/list.sh
  verbose="${args[--verbose]}"

  users=$(rbac_ldap ldapsearch -LLL -b "ou=users,$rbac_ldap_base_dn" "objectClass=inetOrgPerson" uid userPassword) || exit 1
  groups=$(rbac_ldap ldapsearch -LLL -b "ou=groups,$rbac_ldap_base_dn" "objectClass=posixGroup" cn memberUid) || exit 1

  rows=""
  user=""
  while read -r key value
  do
    case "$key" in
      uid:)
        user="$value"
      ;;
      userPassword:|userPassword::)
        password="$value"
        if [ "$key" == "userPassword::" ]
        then
          # base64 encoded
          password=$(base64 -d <<< "$value" 2> /dev/null || base64 -D <<< "$value")
        fi
        user_groups=$(awk -v member="cn=$user,ou=users,$rbac_ldap_base_dn" '/^cn:/ { group = $2 } /^memberUid:/ && $2 == member { printf "%s%s", sep, group; sep = "," }' <<< "$groups")
        rows="$rows$user"$'\t'"$password"$'\t'"${user_groups:--}"$'\n'
      ;;
    esac
  done <<< "$users"

  {
    printf "USER\tPASSWORD\tGROUPS\n"
    printf "%s" "$rows" | sort -f
  } | column -t -s $'\t'

}

