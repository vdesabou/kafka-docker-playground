{
  "filestream-source": {
    "info": {
      "name": "filestream-source",
      "config": {"connector.class": "org.apache.kafka.connect.file.FileStreamSourceConnector", "tasks.max": "1", "file": "/tmp/input.txt", "topic": "lines", "name": "filestream-source"},
